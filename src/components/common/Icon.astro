---
/*
 * The icon set. Hand-drawn inline SVG, in the Material Symbols idiom but never the
 * Material Symbols font — the font is a third-party request, which the self-hosting
 * rule forbids and which would have to be named on the Privacy page.
 *
 * Every icon is drawn on the same 24-unit grid, stroked rather than filled, at a
 * weight of 1.9–2.6 so it sits alongside the icons already on the site. They inherit
 * `currentColor`, so a caller sets the colour by setting text colour on the wrapper.
 *
 * Keep the geometry legible at 22px. These are read at a glance beside a heading, not
 * studied — an icon that needs a second look is doing the heading's job badly.
 */

interface Props {
  name: keyof typeof ICONS;
  size?: number;
  class?: string;
}

const ICONS = {
  /* /contact — the email route in section 2's aside. An open envelope: the flap drawn as
   * two strokes rather than a filled triangle, so it reads at 18px without going solid. */
  mail: `<rect x="2.6" y="4.8" width="18.8" height="14.4" rx="2.2"/><path d="m3.4 6.6 8.6 6.2 8.6-6.2"/>`,

  /* A bare check. The confirmation mark on /contact's submitted state. Drawn on its own
   * rather than inside a circle, so the circle can be a styled element that scales with
   * the type around it. */
  check: `<path d="m4.8 12.4 4.8 4.8 9.6-10.4"/>`,

  /* A map pin. The location block in /contact's Direct Lines panel. */
  location: `<path d="M12 21.4s7-5.6 7-11.2a7 7 0 0 0-14 0c0 5.6 7 11.2 7 11.2Z"/><circle cx="12" cy="10.1" r="2.6"/>`,

  /* A right arrow, for the send button. Drawn at the same weight as the icon set so it
   * sits beside a 16px label without looking heavier than the text. */
  arrowRight: `<path d="M4.2 12h15.1"/><path d="m13.4 6.1 5.9 5.9-5.9 5.9"/>`,

  /* Section 2 — the problem. */

  /* A magnifier with a check inside: examination, not demonstration. */
  assess: `<circle cx="10.5" cy="10.5" r="6.4"/><path d="m15.3 15.3 5 5"/><path d="m7.7 10.6 2 2 3.4-3.7"/>`,

  /* Stacked payment cards. The cost of the problem, unmeasured. */
  cost: `<rect x="2.6" y="4.6" width="15.2" height="10.2" rx="2.2"/><circle cx="10.2" cy="9.7" r="2.4"/><path d="M6.4 18.6h12.2a2.8 2.8 0 0 0 2.8-2.8V8.4"/>`,

  /* A ruler. There is no internal benchmark to measure against. */
  benchmark: `<rect x="2.4" y="8.2" width="19.2" height="7.6" rx="2"/><path d="M7.2 8.2v3.1M12 8.2v4.2M16.8 8.2v3.1"/>`,

  /* Section 3 — where AI actually pays. */

  /* A priced document. Quote turnaround. */
  quote: `<path d="M6.6 2.8h6.6l4.2 4.2v14.2H6.6z"/><path d="M13.2 2.8V7h4.2"/><path d="M14 11.6a2 2 0 0 0-3.4 1.3c0 2.1 3.6 1.2 3.6 3.2A2 2 0 0 1 10.8 17"/><path d="M12.3 10v1.1M12.3 17.4v1.1"/>`,

  /* A crescent moon. Enquiries answered at any hour. */
  afterHours: `<path d="M20.4 14.9A8.6 8.6 0 0 1 9.1 3.6a8.9 8.9 0 1 0 11.3 11.3z"/>`,

  /* Two speech bubbles, one behind the other. The same questions, every week. */
  recurring: `<path d="M8.2 3.4h11.4a1.8 1.8 0 0 1 1.8 1.8v6.4a1.8 1.8 0 0 1-1.8 1.8h-1.2v3.2l-3.4-3.2H8.2a1.8 1.8 0 0 1-1.8-1.8V5.2a1.8 1.8 0 0 1 1.8-1.8z"/><path d="M6.4 8.6H4.4a1.8 1.8 0 0 0-1.8 1.8v5.4a1.8 1.8 0 0 0 1.8 1.8h.9v3l3.2-3h3.7"/>`,

  /* A framed bar chart. Reporting available on demand. */
  reporting: `<rect x="2.8" y="3.6" width="18.4" height="16.8" rx="2.2"/><path d="M8 16.4v-3.8M12 16.4v-6.6M16 16.4v-2.2"/>`,

  /* A clipboard with a check. What has arrived, and what has not. */
  documents: `<rect x="4.8" y="4" width="14.4" height="16.6" rx="2.2"/><rect x="9" y="2.1" width="6" height="3.8" rx="1.4"/><path d="m9.1 13.2 2.3 2.3 4.5-4.7"/>`,

  /* A person, and beside them the written-down version of what they know. */
  keyPerson: `<circle cx="8.4" cy="7.4" r="3.1"/><path d="M3.2 19.6a5.2 5.2 0 0 1 10.4 0"/><rect x="15.4" y="8.2" width="6.2" height="9.2" rx="1.4"/><path d="M17.2 11.2h2.6M17.2 14.2h2.6"/>`,

  /* ---- /accounting ----
   *
   * Four icons shared between that page's sections 2 and 3, which is deliberate. The
   * copy says each problem "maps to work AI can run today", and an item that repeats
   * its icon two sections later is the cheapest way to make that mapping visible —
   * `documents`, `recurring` and `fileStatus` each appear once as a problem and once as
   * a place AI earns its cost. `sorting` and `onboarding` have no partner, which is
   * also honest: the sets are not the same length and the copy never says they are. */

  /* A document with a clock over it. Records that arrive, but late. */
  lateRecords: `<path d="M6.2 2.9h6.4l4 4v6.1"/><path d="M12.6 2.9v4.1h4"/><path d="M16.6 13v8.1H6.2V2.9"/><circle cx="17.4" cy="16.6" r="4.4"/><path d="M17.4 14.4v2.4l1.6 1"/>`,

  /* Paper being pushed sideways into place. Qualified time spent sorting. */
  sorting: `<rect x="2.6" y="4.4" width="9.4" height="7" rx="1.8"/><rect x="2.6" y="14" width="9.4" height="5.6" rx="1.8"/><path d="M15.4 7.9h5.9M15.4 16.8h5.9"/><path d="m18.9 5.5 2.4 2.4-2.4 2.4M17.8 14.4l-2.4 2.4 2.4 2.4"/>`,

  /* A list behind an eye. Where every file stands — visible, or not. */
  fileStatus: `<path d="M4.4 8.2V4.3a1.6 1.6 0 0 1 1.6-1.6h9.2l4 4v3.6"/><path d="M15.2 2.7v4.2h4"/><path d="M4.4 12.6v7a1.6 1.6 0 0 0 1.6 1.6h4.2"/><path d="M21.4 16.6s-1.9 3.4-4.8 3.4-4.8-3.4-4.8-3.4 1.9-3.4 4.8-3.4 4.8 3.4 4.8 3.4z"/><circle cx="16.6" cy="16.6" r="1.4"/>`,

  /* A person with a plus. A new client being opened. */
  onboarding: `<circle cx="9.4" cy="7.2" r="3.4"/><path d="M3.2 19.8a6.2 6.2 0 0 1 12.4 0"/><path d="M18.4 11.4v5.8M15.5 14.3h5.8"/>`,

  /* A calendar with a warning inside it. Deadline exposure, seen early. */
  deadline: `<rect x="3" y="4.8" width="18" height="16.2" rx="2.2"/><path d="M3 9.8h18"/><path d="M7.8 2.9v3.8M16.2 2.9v3.8"/><path d="M12 12.9v3.2M12 18.4h.01"/>`,

  /* ---- /workshop ----
   *
   * Two icons are reused from the sets above rather than redrawn, and both reuses carry
   * the page's argument. `benchmark` — the ruler — sits on "nobody has measured what any
   * of them cost" in section 2, which is the same absence it was drawn for on the
   * homepage. `cost` then sits on "we put figures against each candidate" in section 3:
   * the same mark, one section later, against the thing that fixes it.
   *
   * Two marks repeat inside the page, both carrying the argument across a section break.
   * `separate` sits on "not every candidate is an AI problem" in section 2 and again on
   * "we test what AI actually does" in section 3 — the question, and the work that
   * answers it. `rank` sits on "we rank them" in section 3 and again on "a ranked
   * shortlist" in section 4 — the promise, and the deliverable.
   *
   * A seventh icon, `deferred`, was drawn for this page and removed with the block it
   * belonged to. Section 2's third block used to be "it never reaches the top of the
   * list"; the replaced copy made it "not every candidate is an AI problem", which is a
   * different argument and takes `separate`. It is in git history. */

  /* Three empty checkboxes. Candidates, none of them chosen. */
  candidates: `<rect x="2.9" y="4.2" width="4.4" height="4.4" rx="1.2"/><rect x="2.9" y="9.8" width="4.4" height="4.4" rx="1.2"/><rect x="2.9" y="15.4" width="4.4" height="4.4" rx="1.2"/><path d="M10.2 6.4h10.9M10.2 12h10.9M10.2 17.6h7.4"/>`,

  /* Two boxes routed into a third. The work drawn as it actually runs. */
  workflowMap: `<rect x="2.6" y="3.2" width="6.4" height="4.8" rx="1.6"/><rect x="2.6" y="16" width="6.4" height="4.8" rx="1.6"/><rect x="14.9" y="9.6" width="6.5" height="4.8" rx="1.6"/><path d="M9 5.6h3.4v6.4h2.5"/><path d="M9 18.4h3.4V12"/>`,

  /* One path forking into two. AI problems here, process problems there. */
  separate: `<path d="M2.6 12h4.6"/><path d="M7.2 12c3.3 0 3.3-6.1 6.6-6.1h4.2M7.2 12c3.3 0 3.3 6.1 6.6 6.1h4.2"/><path d="m16 3.5 2.4 2.4-2.4 2.4M16 15.7l2.4 2.4-2.4 2.4"/>`,

  /* Bars in descending order, with the direction of the sort beside them. */
  rank: `<path d="M3.2 5.4h13.4M3.2 12h9.4M3.2 18.6h5.6"/><path d="M20.4 4.6v14.8M17.7 16.7l2.7 2.7 2.7-2.7"/>`,

  /* A box with its dimensions marked. What a build would take, sized. */
  effort: `<rect x="3" y="6.8" width="12.2" height="10.6" rx="2"/><path d="M3 3.6h12.2M3 2.6v2M15.2 2.6v2"/><path d="M18.6 6.8v10.6M17.6 6.8h2M17.6 17.4h2"/>`,

  /* A bookmark. The one candidate marked to build first. */
  recommend: `<path d="M6.4 21V4.6a1.8 1.8 0 0 1 1.8-1.8h7.6a1.8 1.8 0 0 1 1.8 1.8V21l-5.6-3.9z"/><path d="M9.7 8h4.6M9.7 11.4h4.6"/>`,

  /* A circle struck through. What we would tell you not to build. */
  adviseAgainst: `<circle cx="12" cy="12" r="8.6"/><path d="m6.2 6.2 11.6 11.6"/>`,
} as const;

const { name, size = 22, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name]}
/>
