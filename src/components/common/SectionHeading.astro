---
const {
	eyebrow,
	title,
	description,
	centered = false,
} = Astro.props;

const classes = [
	"section-heading",
	centered ? "section-heading--centered" : "",
].filter(Boolean).join(" ");
---

<div class={classes}>
	{eyebrow && <p class="section-heading__eyebrow text-label">{eyebrow}</p>}
	<h2 class="section-heading__title text-headline-lg">{title}</h2>
	{description && <p class="section-heading__description text-body-section">{description}</p>}
</div>
