---
interface Props {
    href?: string;
    variant?: "primary" | "secondary" | "text";
    type?: "button" | "submit" | "reset";
    class?: string;
}

const {
    href,
    variant = "primary",
    type = "button",
    class: className = "",
} = Astro.props;

const classes = [
    "button",
    `button--${variant}`,
    className,
];
---

{
    href ? (
    <a href={href} class:list={classes}>
        <slot/>
    </a>
        ) : (
    <button type={type} class:list={classes}>
        <slot/>
    </button>
        )
    }