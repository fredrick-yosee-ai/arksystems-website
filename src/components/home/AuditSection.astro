---
import Button from "../common/Button.astro";
import SectionHeading from "../common/SectionHeading.astro";

const { auditItems } = Astro.props;
---

<section class="section audit-section" id="audit">
	<div class="audit-section__content">
		<SectionHeading
			title="Start with a Revenue Leak & Workflow Systems Audit."
			description="Before building or automating anything, ArkSystems maps how work happens today, identifies where time and revenue are leaking, and recommends the simplest practical solution."
		/>
		<Button href="#contact" variant="primary" showArrow>Find Workflow Leaks</Button>
		<small class="text-caption">Audit starts from $2,500.</small>
	</div>

	<div class="card card--shadow audit-card">
		<p class="card-label text-caption">Audit Deliverables</p>
		<ul>
			{auditItems.map((item) => (
				<li class="text-body-md">{item}</li>
			))}
		</ul>
	</div>
</section>
