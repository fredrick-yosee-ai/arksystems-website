---
import Button from "../common/Button.astro";
import WorkflowDashboardGraphic from "./WorkflowDashboardGraphic.astro";
---

<section class="hero">
	<div class="hero__content">
		<p class="hero__eyebrow text-label">Workflow systems, automation, and practical AI</p>
		<h1 class="text-display-lg">Fix the workflows that are quietly costing your business money.</h1>
		<p class="hero__text text-body-lg">
			ArkSystems helps growing businesses identify manual work, missed follow-ups,
			document chaos, and operational bottlenecks, then implements practical systems,
			automation, and AI where there is clear ROI.
		</p>

		<div class="hero__actions">
			<Button href="#contact" variant="primary" showArrow>Book a Workflow Audit Call</Button>
			<Button href="#audit" variant="secondary">See What We Audit</Button>
		</div>

		<p class="hero__proof text-caption">
			For established service and operations-heavy businesses with repeated workflows,
			admin pressure, and unclear bottlenecks.
		</p>
	</div>

	<WorkflowDashboardGraphic />
</section>
