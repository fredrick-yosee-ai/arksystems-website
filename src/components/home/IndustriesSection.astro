---
import Container from "../common/Container.astro";
import SectionHeading from "../common/SectionHeading.astro";

const { industries } = Astro.props;
---

<section class="section section--surface industries-section" id="solutions">
	<Container>
		<SectionHeading
			centered
			title="Built for service and operations-heavy businesses."
			description="ArkSystems works with established businesses where admin work, follow-ups, documents, and team coordination directly affect revenue and capacity."
		/>

		<div class="industry-grid">
			{industries.map((industry) => (
				<article class="card industry-card">
					<h3 class="text-title-md">{industry.title}</h3>
					<p class="text-body-sm">{industry.text}</p>
					<a href="#contact">Learn more →</a>
				</article>
			))}
		</div>
	</Container>
</section>
