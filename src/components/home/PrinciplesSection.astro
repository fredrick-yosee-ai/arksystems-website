---
import Container from "../common/Container.astro";
import SectionHeading from "../common/SectionHeading.astro";

const { principles } = Astro.props;
---

<section class="section principles-section">
	<Container>
		<SectionHeading
			centered
			title="AI only where it makes business sense."
			description="ArkSystems does not force AI into every workflow. Sometimes the right answer is a better process, a connected tool, a simple automation, or a custom system. AI is recommended only when it is useful, safe, and financially justified."
		/>

		<div class="principles-grid">
			{principles.map((item) => (
				<article class="card principle-card">
					<span>{item.icon}</span>
					<h3 class="text-title-md">{item.title}</h3>
					<p class="text-body-sm">{item.text}</p>
				</article>
			))}
		</div>
	</Container>
</section>
