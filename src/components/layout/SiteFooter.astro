---
import {
  SITE,
  FOOTER_EXPLORE,
  FOOTER_LEGAL,
  INDUSTRY_LINKS,
} from "../../consts";
import arkLogo from "../../../assets/ark.png";
import { Image } from "astro:assets";

const year = new Date().getFullYear();

/*
 * The footer carries four columns, and Industries is one of them.
 *
 * It is a column rather than a line inside Explore because it is a category that grows:
 * /accounting is the first industry page and the list is built to take the next one
 * without anything moving. It also does a job the header cannot — these are plain
 * <a href> links, rendered unconditionally and never behind a control, so the industry
 * pages stay reachable when the header's submenu script does not run.
 */

/* Trailing slashes vary by host and by dev server, so compare without one. */
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href="/" class="footer__brand-link">
        {/* Width only — see the note in SiteHeader. A square height on a 260x233 source
            makes Astro cover-crop the mark's left and right edges. */}
        <Image src={arkLogo} alt="" width={30} class="footer__logo" densities={[1, 2]} />
        <span class="footer__name">{SITE.name}</span>
      </a>

      <p class="footer__positioning">{SITE.positioning}</p>

      {/* The tagline's second and final appearance. Closing section, then here. */}
      <p class="footer__tagline">{SITE.tagline}</p>
    </div>

    <nav class="footer__cols" aria-label="Footer">
      <div class="footer__col">
        <h2 class="eyebrow footer__heading">Explore</h2>
        <ul>
          {
            FOOTER_EXPLORE.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="footer__link"
                  aria-current={link.href === path ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="eyebrow footer__heading">Industries</h2>
        <ul>
          {
            INDUSTRY_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="footer__link"
                  aria-current={link.href === path ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="eyebrow footer__heading">Company</h2>
        <ul>
          <li>
            {/*
              REPOINTED Aug 28 2026, when /contact was built. This pointed at BOOKING_URL,
              which meant two footer entries — this and the booking button — resolved to
              the same destination, and a reader looking for a way to write to us was sent
              to a calendar instead. That is the bug /contact exists to fix.
            */}
            <a
              href="/contact"
              class="footer__link"
              aria-current={"/contact" === path ? "page" : undefined}
            >
              Contact
            </a>
          </li>
          {/* LinkedIn is in the spec but no URL has been supplied. Add it here. */}
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="eyebrow footer__heading">Legal</h2>
        <ul>
          {
            FOOTER_LEGAL.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="footer__link"
                  aria-current={link.href === path ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            {/*
              Withdrawal, on every page. Given the banner is accept-only, this link IS
              the decline — it is the only route back out of a choice, which is why the
              banner's own approved copy names it and why it cannot be moved somewhere
              less findable than the footer.

              A <button>, not an <a>, because it opens a panel rather than going
              anywhere. It is styled as the links around it because the visitor reading
              this column is looking for a list of links and should not have to notice
              the difference.
            */}
            <button type="button" class="footer__link footer__link--button" data-cookie-settings>
              Cookie settings
            </button>
          </li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="container">
    <p class="footer__legal-line">© {year} {SITE.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--ark-grey);
    padding-block: 62px 30px;
    margin-top: auto;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.65fr);
    gap: 48px;
    align-items: start;
  }

  .footer__brand-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .footer__logo {
    width: 30px;
    height: auto;
    display: block;
  }

  .footer__name {
    font-family: var(--ark-font-display);
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--ark-olive);
  }

  .footer__positioning {
    margin-top: 16px;
    max-width: 42ch;
    font-size: var(--ark-small);
    line-height: 1.6;
    color: var(--ark-muted);
  }

  .footer__tagline {
    margin-top: 20px;
    font-family: var(--ark-font-display);
    font-size: 1.16rem;
    font-weight: 600;
    color: var(--ark-olive);
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }

  .footer__heading {
    margin: 0 0 16px;
    font-family: var(--ark-font-body);
    font-size: var(--ark-eyebrow);
  }

  .footer__link {
    display: inline-block;
    padding-block: 6px;
    font-size: var(--ark-small);
    line-height: 1.45;
    text-decoration: none;
    color: var(--ark-charcoal);
  }

  /* The Cookie settings control is a button, so it needs the browser's own button
   * styling removed before .footer__link can take effect on it. */
  .footer__link--button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .footer__link:hover {
    color: var(--ark-olive);
    text-decoration: underline;
  }

  /* The current page, marked with weight as well as colour. */
  .footer__link[aria-current="page"] {
    color: var(--ark-olive);
    font-weight: 600;
  }

  .footer__legal-line {
    margin-top: 46px;
    padding-top: 22px;
    border-top: 1px solid var(--ark-grey);
    font-size: 0.82rem;
    color: var(--ark-muted);
  }

  @media (max-width: 1040px) {
    .footer__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }

  @media (max-width: 900px) {
    .footer {
      padding-block: 44px 26px;
    }

    .footer__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 38px;
    }

    .footer__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 30px 24px;
    }

    .footer__legal-line {
      margin-top: 34px;
    }
  }

  /* Four column headings two-up still fit a 390px phone; below that they do not. */
  @media (max-width: 560px) {
    .footer__cols {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
</style>
