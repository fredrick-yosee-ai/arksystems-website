---
import Container from "../common/Container.astro";

const currentYear = new Date().getFullYear();

const serviceLinks = [
    { label: "How We Help", href: "/how-we-help" },
    { label: "The Workshop", href: "/workshop" },
    { label: "For Accounting Firms", href: "/accounting-firms" },
];

const companyLinks = [
    { label: "About", href: "/#" },
    { label: "Contact", href: "/#" },
    {
        label: "LinkedIn",
        href: "https://www.linkedin.com/company/arksystems",
        external: true,
    },
];

const legalLinks = [
    { label: "Privacy", href: "/#" },
    { label: "Terms", href: "/#" },
];
---

<footer class="site-footer">
    <Container>
        <div class="site-footer__grid">
            <div class="site-footer__brand">
                <a href="/" class="site-footer__brand-name">
                    ArkSystems
                </a>

                <p class="site-footer__tagline">
                    Your AI Partner for Smarter Growth.
                </p>

                <p class="site-footer__supporting">
                    Make AI work for your business.
                </p>
            </div>

            <div class="site-footer__column">
                <h2 class="site-footer__heading">Services</h2>

                <ul class="site-footer__links">
                    {
                        serviceLinks.map((link) => (
                                <li>
                                    <a href={link.href}>{link.label}</a>
                                </li>
                        ))
                    }
                </ul>
            </div>

            <div class="site-footer__column">
                <h2 class="site-footer__heading">Company</h2>

                <ul class="site-footer__links">
                    {
                        companyLinks.map((link) => (
                                <li>
                                    <a
                                            href={link.href}
                                            target={link.external ? "_blank" : undefined}
                                            rel={link.external ? "noopener noreferrer" : undefined}
                                    >
                                        {link.label}
                                    </a>
                                </li>
                        ))
                    }
                </ul>
            </div>

            <div class="site-footer__column">
                <h2 class="site-footer__heading">Legal</h2>

                <ul class="site-footer__links">
                    {
                        legalLinks.map((link) => (
                                <li>
                                    <a href={link.href}>{link.label}</a>
                                </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        <div class="site-footer__bottom">
            <p>
                © {currentYear} ArkSystems. All rights reserved.
            </p>
        </div>
    </Container>
</footer>

<style>
    .site-footer {
        border-top: 0.45rem solid var(--color-brand-900);
        background: #fbf5ec;
        padding-block: var(--space-20) var(--space-10);
    }

    .site-footer__grid {
        display: grid;
        grid-template-columns: 1.5fr repeat(3, 1fr);
        gap: clamp(var(--space-10), 6vw, var(--space-20));
    }

    .site-footer__brand {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-4);
    }

    .site-footer__brand-name {
        font-family: var(--font-heading);
        font-size: var(--font-size-2xl);
        font-weight: var(--font-weight-semibold);
        color: var(--color-brand-900);
    }

    .site-footer__tagline {
        font-size: var(--font-size-lg);
        color: var(--color-neutral-700);
    }

    .site-footer__supporting {
        font-size: var(--font-size-sm);
        color: var(--color-text-muted);
    }

    .site-footer__column {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
    }

    .site-footer__heading {
        font-family: var(--font-body);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-bold);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-brand-900);
    }

    .site-footer__links {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
        list-style: none;
    }

    .site-footer__links a {
        font-size: var(--font-size-lg);
        color: var(--color-neutral-700);
        transition: color var(--transition-fast);
    }

    .site-footer__links a:hover {
        color: var(--color-brand-700);
    }

    .site-footer__bottom {
        margin-top: var(--space-20);
        padding-top: var(--space-8);
        border-top: var(--border-width) solid var(--color-border);
    }

    .site-footer__bottom p {
        font-size: var(--font-size-sm);
        color: var(--color-text-muted);
    }

    @media (max-width: 56rem) {
        .site-footer__grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .site-footer__brand {
            grid-column: 1 / -1;
        }
    }

    @media (max-width: 35rem) {
        .site-footer {
            padding-block: var(--space-16) var(--space-8);
        }

        .site-footer__grid {
            grid-template-columns: 1fr;
        }

        .site-footer__brand {
            grid-column: auto;
        }

        .site-footer__bottom {
            margin-top: var(--space-12);
        }
    }
</style>