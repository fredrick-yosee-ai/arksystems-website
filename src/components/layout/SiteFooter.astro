---
import { SITE, BOOKING_URL, FOOTER_EXPLORE, FOOTER_LEGAL } from "../../consts";
import arkLogo from "../../../assets/ark.png";
import { Image } from "astro:assets";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href="/" class="footer__brand-link">
        <Image src={arkLogo} alt="" width={30} height={30} class="footer__logo" densities={[1, 2]} />
        <span class="footer__name">{SITE.name}</span>
      </a>

      <p class="footer__positioning">{SITE.positioning}</p>

      {/* The tagline's second and final appearance. Closing section, then here. */}
      <p class="footer__tagline">{SITE.tagline}</p>
    </div>

    <nav class="footer__cols" aria-label="Footer">
      <div class="footer__col">
        <h2 class="eyebrow footer__heading">Explore</h2>
        <ul>
          {
            FOOTER_EXPLORE.map((link) => (
              <li>
                <a href={link.href} class="footer__link">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        {/*
          The spec puts a quiet "For accounting firms → /accounting" link here, so a CPA
          arriving by referral has somewhere to go. It is omitted for release one because
          /accounting ships in release two, and "every link resolves, no 404s in the
          footer" is a stated quality gate. Restore it with that page.
        */}
      </div>

      <div class="footer__col">
        <h2 class="eyebrow footer__heading">Company</h2>
        <ul>
          <li>
            {/*
              "Contact" points at the booking link. Every mailto: on the old site had to
              go, and the page has exactly one action, so this is the coherent
              destination rather than a second, weaker one.
            */}
            <a href={BOOKING_URL} class="footer__link">Contact</a>
          </li>
          {/* LinkedIn is in the spec but no URL has been supplied. Add it here. */}
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="eyebrow footer__heading">Legal</h2>
        <ul>
          {
            FOOTER_LEGAL.map((link) => (
              <li>
                <a href={link.href} class="footer__link">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>

  <div class="container">
    <p class="footer__legal-line">© {year} {SITE.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--ark-grey);
    padding-block: 62px 30px;
    margin-top: auto;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 2fr);
    gap: 56px;
    align-items: start;
  }

  .footer__brand-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .footer__logo {
    width: 30px;
    height: auto;
    display: block;
  }

  .footer__name {
    font-family: var(--ark-font-display);
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--ark-olive);
  }

  .footer__positioning {
    margin-top: 16px;
    max-width: 42ch;
    font-size: var(--ark-small);
    line-height: 1.6;
    color: var(--ark-muted);
  }

  .footer__tagline {
    margin-top: 20px;
    font-family: var(--ark-font-display);
    font-size: 1.16rem;
    font-weight: 600;
    color: var(--ark-olive);
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .footer__heading {
    margin: 0 0 16px;
    font-family: var(--ark-font-body);
    font-size: var(--ark-eyebrow);
  }

  .footer__link {
    display: inline-block;
    padding-block: 6px;
    font-size: var(--ark-small);
    line-height: 1.45;
    text-decoration: none;
    color: var(--ark-charcoal);
  }

  .footer__link:hover {
    color: var(--ark-olive);
    text-decoration: underline;
  }

  .footer__legal-line {
    margin-top: 46px;
    padding-top: 22px;
    border-top: 1px solid var(--ark-grey);
    font-size: 0.82rem;
    color: var(--ark-muted);
  }

  @media (max-width: 900px) {
    .footer {
      padding-block: 44px 26px;
    }

    .footer__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 38px;
    }

    .footer__cols {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
    }

    .footer__legal-line {
      margin-top: 34px;
    }
  }
</style>
