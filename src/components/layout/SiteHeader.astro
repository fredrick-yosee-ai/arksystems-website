---
import Container from "../common/Container.astro";

const navigation = [
    { label: "How We Help", href: "/" },
    { label: "The Workshop", href: "/" },
    { label: "For Accounting Firms", href: "/" },
    { label: "About", href: "/" },
];
---

<header class="site-header" data-header>
    <Container>
        <div class="site-header__inner">
            <a href="/" class="site-header__brand" aria-label="ArkSystems home">
                <img
                        src="/favicon.svg"
                        alt=""
                        width="46"
                        height="46"
                        class="site-header__logo"
                />

                <span class="site-header__brand-name">
					ArkSystems
				</span>
            </a>

            <nav class="site-header__nav" aria-label="Primary navigation">
                <ul class="site-header__nav-list">
                    {
                        navigation.map((item) => (
                                <li>
                                    <a href={item.href} class="site-header__nav-link">
                                        {item.label}
                                    </a>
                                </li>
                        ))
                    }
                </ul>
            </nav>

            <a href="mailto:hello@arksystems.ca" class="site-header__cta">
                Book a Call
            </a>

            <button
                    class="site-header__menu-button"
                    type="button"
                    aria-label="Open navigation menu"
                    aria-expanded="false"
                    aria-controls="mobile-navigation"
                    data-menu-button
            >
				<span
                        class="material-symbols-rounded site-header__menu-open"
                        aria-hidden="true"
                >
					menu
				</span>

                <span
                        class="material-symbols-rounded site-header__menu-close"
                        aria-hidden="true"
                >
					close
				</span>
            </button>
        </div>
    </Container>

    <div
            class="mobile-menu"
            id="mobile-navigation"
            data-mobile-menu
            aria-hidden="true"
    >
        <Container>
            <nav class="mobile-menu__nav" aria-label="Mobile navigation">
                <ul class="mobile-menu__list">
                    {
                        navigation.map((item) => (
                                <li>
                                    <a
                                            href={item.href}
                                            class="mobile-menu__link"
                                            data-mobile-link
                                    >
                                        <span>{item.label}</span>
                                        <span
                                                class="material-symbols-rounded"
                                                aria-hidden="true"
                                        >
										arrow_forward
									</span>
                                    </a>
                                </li>
                        ))
                    }
                </ul>

                <a href="mailto:hello@arksystems.ca" class="mobile-menu__cta" data-mobile-link>
                    Book a Call
                </a>
            </nav>
        </Container>
    </div>
</header>

<script>
    const header = document.querySelector("[data-header]");
    const menuButton = document.querySelector("[data-menu-button]");
    const mobileMenu = document.querySelector("[data-mobile-menu]");
    const mobileLinks = document.querySelectorAll("[data-mobile-link]");

    const closeMenu = () => {
        if (!header || !menuButton || !mobileMenu) return;

        header.classList.remove("site-header--open");
        menuButton.setAttribute("aria-expanded", "false");
        menuButton.setAttribute("aria-label", "Open navigation menu");
        mobileMenu.setAttribute("aria-hidden", "true");
        document.body.classList.remove("mobile-menu-open");
    };

    const openMenu = () => {
        if (!header || !menuButton || !mobileMenu) return;

        header.classList.add("site-header--open");
        menuButton.setAttribute("aria-expanded", "true");
        menuButton.setAttribute("aria-label", "Close navigation menu");
        mobileMenu.setAttribute("aria-hidden", "false");
        document.body.classList.add("mobile-menu-open");
    };

    menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";

        if (isOpen) {
            closeMenu();
        } else {
            openMenu();
        }
    });

    mobileLinks.forEach((link) => {
        link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            closeMenu();
        }
    });

    window.addEventListener("resize", () => {
        if (window.innerWidth > 1024) {
            closeMenu();
        }
    });

    let lastScrollY = window.scrollY;
    let ticking = false;

    const updateHeaderVisibility = () => {
        if (!header) return;

        const currentScrollY = window.scrollY;
        const menuIsOpen = header.classList.contains("site-header--open");

        if (menuIsOpen || currentScrollY < 80) {
            header.classList.remove("site-header--hidden");
            lastScrollY = currentScrollY;
            ticking = false;
            return;
        }

        const scrollDifference = currentScrollY - lastScrollY;

        if (scrollDifference > 6) {
            header.classList.add("site-header--hidden");
        } else if (scrollDifference < -6) {
            header.classList.remove("site-header--hidden");
        }

        lastScrollY = currentScrollY;
        ticking = false;
    };

    window.addEventListener(
        "scroll",
        () => {
            if (!ticking) {
                window.requestAnimationFrame(updateHeaderVisibility);
                ticking = true;
            }
        },
        { passive: true }
    );
</script>

<style>
    .site-header {
        position: fixed;
        z-index: var(--z-header);
        top: 0;
        right: 0;
        left: 0;
        width: 100%;

        border-bottom: 1px solid rgb(79 84 64 / 10%);
        background: rgb(251 245 236 / 96%);
        box-shadow: 0 3px 14px rgb(43 44 39 / 5%);

        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);

        transform: translateY(0);
        transition:
                transform 280ms ease,
                box-shadow 200ms ease;
    }

    .site-header--hidden {
        transform: translateY(-100%);
    }

    .site-header__inner {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: var(--space-10);
        min-height: 4.75rem;
    }

    .site-header__brand {
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        color: var(--color-elephant-black);
        white-space: nowrap;
    }

    .site-header__logo {
        width: 2.8rem;
        height: 2.8rem;
        object-fit: contain;
    }

    .site-header__brand-name {
        font-family: var(--font-body);
        font-size: 1.45rem;
        font-weight: var(--font-weight-bold);
        letter-spacing: -0.035em;
    }

    .site-header__nav {
        justify-self: center;
    }

    .site-header__nav-list {
        display: flex;
        align-items: center;
        gap: clamp(1.8rem, 3vw, 3rem);
        list-style: none;
    }

    .site-header__nav-link {
        position: relative;
        padding-block: 0.45rem;
        font-size: 0.98rem;
        font-weight: var(--font-weight-semibold);
        color: var(--color-elephant-black);
        transition:
                color var(--transition-fast),
                transform var(--transition-fast);
    }

    .site-header__nav-link::after {
        content: "";
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        height: 2px;
        background: var(--color-primary);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform var(--transition-base);
    }

    .site-header__nav-link:hover {
        color: var(--color-primary);
        transform: translateY(-1px);
    }

    .site-header__nav-link:hover::after {
        transform: scaleX(1);
        transform-origin: left;
    }

    .site-header__cta,
    .mobile-menu__cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 3.1rem;
        padding-inline: 1.8rem;
        border-radius: var(--radius-full);
        background: var(--color-primary);
        font-size: 0.95rem;
        font-weight: var(--font-weight-semibold);
        color: var(--color-white);
        white-space: nowrap;
        box-shadow: 0 5px 14px rgb(44 60 35 / 10%);
        transition:
                background var(--transition-fast),
                transform var(--transition-fast),
                box-shadow var(--transition-fast);
    }

    .site-header__cta:hover,
    .mobile-menu__cta:hover {
        background: var(--color-primary-hover);
        transform: translateY(-2px);
        box-shadow: 0 9px 20px rgb(44 60 35 / 16%);
    }

    .site-header__menu-button {
        display: none;
        align-items: center;
        justify-content: center;
        width: 2.8rem;
        height: 2.8rem;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: var(--color-elephant-black);
        transition: background var(--transition-fast);
    }

    .site-header__menu-button:hover {
        background: var(--color-brand-100);
    }

    .site-header__menu-button .material-symbols-rounded {
        font-size: 1.8rem;
    }

    .site-header__menu-close {
        display: none;
    }

    .mobile-menu {
        display: none;
    }

    @media (max-width: 64rem) {
        .site-header__inner {
            grid-template-columns: auto 1fr auto;
            min-height: 5rem;
            gap: var(--space-5);
        }

        .site-header__nav {
            display: none;
        }

        .site-header__cta {
            display: none;
        }

        .site-header__menu-button {
            display: inline-flex;
            justify-self: end;
        }

        .site-header--open .site-header__menu-open {
            display: none;
        }

        .site-header--open .site-header__menu-close {
            display: inline-block;
        }

        .mobile-menu {
            position: absolute;
            top: 100%;
            right: 0;
            left: 0;

            display: block;
            max-height: 0;
            overflow: hidden;
            visibility: hidden;

            background: #fbf5ec;
            border-bottom: 1px solid rgb(79 84 64 / 10%);
            box-shadow: 0 18px 40px rgb(44 44 39 / 8%);

            opacity: 0;
            transform: translateY(-0.5rem);

            transition:
                    max-height 350ms ease,
                    opacity 220ms ease,
                    transform 220ms ease,
                    visibility 220ms ease;
        }

        .site-header--open .mobile-menu {
            max-height: 34rem;
            visibility: visible;
            opacity: 1;
            transform: translateY(0);
        }

        .mobile-menu__nav {
            padding-block: 1rem 1.5rem;
        }

        .mobile-menu__list {
            display: grid;
            list-style: none;
        }

        .mobile-menu__link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding-block: 1rem;
            border-bottom: 1px solid rgb(79 84 64 / 9%);
            font-size: 1rem;
            font-weight: var(--font-weight-semibold);
            color: var(--color-elephant-black);
            transition:
                    color var(--transition-fast),
                    padding-left var(--transition-fast);
        }

        .mobile-menu__link:hover {
            padding-left: 0.3rem;
            color: var(--color-primary);
        }

        .mobile-menu__link .material-symbols-rounded {
            font-size: 1.2rem;
            color: var(--color-brand-700);
        }

        .mobile-menu__cta {
            width: 100%;
            margin-top: 1.3rem;
        }
    }

    @media (max-width: 35rem) {
        .site-header__logo {
            width: 2.35rem;
            height: 2.35rem;
        }

        .site-header__brand-name {
            font-size: 1.2rem;
        }
    }
</style>

<style is:global>
    body.mobile-menu-open {
        overflow: hidden;
    }
</style>
