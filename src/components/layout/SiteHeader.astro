---
import BookingButton from "../common/BookingButton.astro";
import { NAV_LINKS, SITE } from "../../consts";
import arkLogo from "../../../assets/ark.png";
import { Image } from "astro:assets";
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__brand">
      <Image src={arkLogo} alt="" width={28} height={28} class="header__logo" densities={[1, 2]} />
      <span class="header__name">{SITE.name}</span>
    </a>

    <nav class="header__nav" aria-label="Primary">
      <ul class="header__list">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="header__link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      {/*
        The Book button sits outside the collapsible menu on purpose. Most warm traffic
        arrives on a phone after meeting Fredrick in person, and the previous site hid
        the CTA from exactly that visitor. It stays in the bar at every width.
      */}
      <BookingButton location="nav" class="header__cta">
        {/*
          Two labels, one link. The approved mobile mockup shortens this to "Book 20 min"
          so the button and the menu toggle both fit in a 375px bar. `display: none`
          keeps the hidden one out of the accessibility tree, so it is never read twice.
        */}
        <span class="header__cta-long">Book 20 minutes</span>
        <span class="header__cta-short">Book 20 min</span>
      </BookingButton>

      <button
        type="button"
        class="header__toggle"
        aria-expanded="false"
        aria-controls="header-menu"
        data-menu-toggle
      >
        <span class="visually-hidden">Menu</span>
        <span class="header__toggle-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="header__menu" id="header-menu" hidden data-menu>
    <div class="container">
      <ul class="header__menu-list">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="header__menu-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ark-cream);
    border-bottom: 1px solid var(--ark-grey);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 68px;
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__logo {
    width: 28px;
    height: auto;
    display: block;
  }

  .header__name {
    font-family: var(--ark-font-display);
    font-weight: 700;
    font-size: 1.32rem;
    color: var(--ark-olive);
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .header__link {
    font-size: 0.94rem;
    text-decoration: none;
    color: var(--ark-charcoal);
    white-space: nowrap;
  }

  .header__link:hover {
    color: var(--ark-olive);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .header__cta {
    font-size: 0.86rem;
    padding: 11px 16px;
    white-space: nowrap;
  }

  .header__cta-short {
    display: none;
  }

  /* --- The collapsing menu -------------------------------------------- */

  .header__toggle {
    display: none;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--ark-grey);
    border-radius: var(--ark-radius-sm);
    cursor: pointer;
    color: var(--ark-olive);
  }

  /* Three bars, drawn from one element so there is no extra markup. */
  .header__toggle-bars,
  .header__toggle-bars::before,
  .header__toggle-bars::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
  }

  .header__toggle-bars {
    position: relative;
  }

  .header__toggle-bars::before,
  .header__toggle-bars::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .header__toggle-bars::before {
    top: -6px;
  }

  .header__toggle-bars::after {
    top: 6px;
  }

  .header__menu {
    border-top: 1px solid var(--ark-grey);
    padding-block: 10px 18px;
  }

  .header__menu[hidden] {
    display: none;
  }

  .header__menu-link {
    display: block;
    padding: 13px 0;
    font-size: 1.02rem;
    text-decoration: none;
    color: var(--ark-charcoal);
  }

  .header__menu-list > li + li {
    border-top: 1px solid var(--ark-grey);
  }

  /* The spec's breakpoint: below 800px the links collapse, the button does not. */
  @media (max-width: 800px) {
    .header__nav {
      display: none;
    }

    .header__toggle {
      display: inline-flex;
    }
  }

  /* Phone bar, matching the approved mobile mockup: 64px tall, 26px mark, smaller
   * wordmark, and 44px touch targets for both the button and the toggle. */
  @media (max-width: 560px) {
    .header__inner {
      min-height: 64px;
      gap: 12px;
    }

    .header__logo {
      width: 26px;
    }

    .header__name {
      font-size: 1.06rem;
    }

    .header__actions {
      gap: 10px;
    }

    .header__cta {
      height: 44px;
      padding: 0 16px;
    }

    .header__cta-long {
      display: none;
    }

    .header__cta-short {
      display: inline;
    }

    .header__toggle {
      width: 44px;
      height: 44px;
    }
  }

  @media (min-width: 801px) {
    .header__menu {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.hidden = !open;
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    // Following an in-page anchor should close the menu behind you.
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Resizing past the breakpoint must not leave the panel open and orphaned.
    window.matchMedia("(min-width: 801px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
