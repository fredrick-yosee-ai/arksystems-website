---
import { LEGAL_ENTITY } from "../../../lib/legal";

/*
 * Section 4 — where we are. Copy verbatim from the approved build brief.
 *
 * THIS SECTION IS A DELIBERATE EXCEPTION TO THE NO-LOCATION RULE, and it needs to be read
 * as one rather than as a drift.
 *
 * Fredrick's standing instruction of Aug 25 2026 took "Based in Metro Vancouver, working
 * remotely across Canada" and everything like it off the site, from five places. One of
 * them was /about's section 6, whose paragraph went whole rather than half-kept:
 * "Based in Metro Vancouver. We work remotely across Canada, and on site within the Lower
 * Mainland where the work benefits from it." The paragraph below is that sentence,
 * restored almost word for word.
 *
 * IT WAS PUT TO FREDRICK BEFORE THIS PAGE WAS BUILT, with the conflict spelled out, and
 * he decided on Aug 28 2026 to build it as briefed. The reasoning is that a contact page
 * is the one page where "where are you?" is the reader's actual question, and the on-site
 * Lower Mainland offer had been published nowhere since Aug 25.
 *
 * WHAT THAT MEANS FOR THE REST OF THE SITE, so nobody "fixes" the inconsistency in either
 * direction by accident:
 *
 *   - The exception is scoped to THIS PAGE. The homepage close, the founder strip,
 *     /accounting's hero trust line and close, and /about's sections 1, 3 and 6 all stay
 *     as they are. Do not restore any of them on the strength of this one.
 *   - /about no longer says where the business is and this page does. That is a known
 *     asymmetry, not an oversight.
 *   - The legal pages still publish no location at all, which is a separate decision
 *     taken for separate reasons — see the header of /privacy.
 *
 * NO STREET OR MAILING ADDRESS, on this page or any other. The brief makes it one of its
 * three page rules: supplied on request if a vendor assessment asks for it. That is also
 * why no LocalBusiness schema is emitted here — it needs a real postal address and real
 * hours, and inventing either would be a false claim on the page whose job is to be
 * reachable.
 *
 * THE OPERATING ENTITY IS NAMED, and it is the same constant the three legal pages use,
 * so the site states it identically in all four places.
 */
---

<section class="section section--warm where">
  <div class="container where__inner">
    <div class="where__head">
      <h2 class="section__title">Metro Vancouver, working across Canada.</h2>
    </div>

    <div class="where__body">
      <p class="where__text">
        ArkSystems is based in Metro Vancouver, British Columbia. We work remotely with
        businesses across Canada, and on site within the Lower Mainland where the work
        benefits from it.
      </p>

      <p class="where__entity">ArkSystems is operated by {LEGAL_ENTITY}</p>
    </div>
  </div>
</section>

<style>
  /*
   * Two columns above 900 in landscape: heading left, paragraph right, the paragraph
   * running to the same right edge as the container. A left-aligned head in a 1240px
   * container leaves a third of the band empty, and on a full-width band that reads as
   * something failing to load rather than as space. This section has no cards and no
   * illustration underneath to fill it, so the head has to.
   *
   * The query is the exact complement of the centring rule in base.css — a portrait
   * tablet centres its heading and must not also be holding two columns.
   */
  @media (min-width: 901px) and (orientation: landscape) {
    .where__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 64px;
      align-items: start;
    }
  }

  .where__text {
    font-size: var(--ark-body-lg);
    line-height: var(--ark-lh-body);
    color: var(--ark-body-ink);
    max-width: 52ch;
  }

  /* Quieter and smaller. It is a statement of fact about the operating company, not part
   * of the paragraph above it, and it is the same line the legal pages carry. */
  .where__entity {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--ark-hairline);
    font-size: var(--ark-small);
    line-height: 1.5;
    color: var(--ark-muted);
    max-width: 52ch;
  }

  @media (max-width: 900px), (orientation: portrait) {
    .where__body {
      margin-top: 24px;
    }

    /*
     * The heading centres on a portrait screen, via base.css, and the paragraph does not
     * — centred prose is harder to read, which matters more than usual under the
     * plain-language rule. But the BLOCK centres so it does not read as a misalignment
     * under a centred heading. Same treatment the four heroes use.
     */
    .where__text,
    .where__entity {
      margin-inline: auto;
      max-width: 44ch;
    }
  }
</style>
