---
import BookingButton from "../../common/BookingButton.astro";
import { SITE } from "../../../consts";

/*
 * Section 5 — the close. Copy verbatim from the approved build brief.
 *
 * On the dark olive band with the tagline beneath the CTA, matching the four pages that
 * already close this way. Five pages on one site should not end differently, and the
 * tagline has one established treatment: display face, on olive, below the button, as a
 * sign-off and never as a heading.
 *
 * THE HEADING ARGUES AGAINST ITS OWN BUTTON and that is the point of it. "If you're not
 * sure it's worth a call, write instead" sits directly above a button that books a call.
 * A reader who is not ready is given the smaller option in the same breath, which is the
 * same concession every other page on this site makes somewhere. Do not resolve the
 * tension by softening the heading — the tension is the argument.
 *
 * NO LOCATION LINE UNDER THE CTA. Section 4 carries this page's location paragraph, by
 * decision; that does not extend to here. The line under the CTA is exactly what
 * Fredrick's instruction of Aug 25 2026 removed from the homepage close and /accounting's
 * close, and it stays removed on all three.
 *
 * NO SECOND EMAIL ADDRESS EITHER. The body says "write instead" and the address is one
 * screen up in section 2. Repeating it here would put a second competing action beside
 * the page's primary one, which is the thing section 2 is carefully built to avoid.
 */
---

<section class="close on-dark">
  <div class="container close__inner">
    <h2 class="close__title">
      If you&rsquo;re not sure it&rsquo;s worth a call, write instead.
    </h2>

    <p class="close__body">
      A short email costs you nothing and gets a real answer. If the answer is that AI
      isn&rsquo;t the right spend for your business right now, that&rsquo;s what
      you&rsquo;ll be told.
    </p>

    <div class="close__cta">
      <BookingButton location="contact-closing" variant="cream" block>
        Book your free 20-minute call
      </BookingButton>
    </div>

    <p class="close__tagline">{SITE.tagline}</p>
  </div>
</section>

<style>
  .close {
    background: var(--ark-olive);
    color: var(--ark-on-dark);
    padding-block: 92px;
  }

  .close__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* 2.75rem rather than the full h2, matching /about's close. This heading is ten words;
   * at 3.25rem it sets on four lines and reads as a paragraph in display type rather than
   * as a sign-off. */
  .close__title {
    color: var(--ark-on-dark);
    font-size: 2.75rem;
    line-height: 1.12;
    letter-spacing: -0.022em;
    max-width: 24ch;
  }

  .close__body {
    margin-top: 26px;
    font-size: var(--ark-body-lg);
    line-height: var(--ark-lh-body);
    color: var(--ark-on-dark-muted);
    max-width: 58ch;
  }

  .close__cta {
    margin-top: 38px;
  }

  .close__tagline {
    margin-top: 60px;
    font-family: var(--ark-font-display);
    font-weight: 700;
    font-size: 2rem;
    letter-spacing: 0.005em;
    color: var(--ark-on-dark-eyebrow);
  }

  @media (max-width: 900px) {
    .close {
      padding-block: 62px;
    }

    .close__title {
      font-size: var(--ark-h2);
      line-height: var(--ark-lh-h2);
      max-width: 20ch;
    }

    .close__body {
      margin-top: 18px;
      max-width: 36ch;
    }

    .close__cta {
      margin-top: 28px;
      width: 100%;
    }

    .close__tagline {
      margin-top: 44px;
      font-size: 1.5rem;
    }
  }
</style>
