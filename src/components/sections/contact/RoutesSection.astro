---
import BookingButton from "../../common/BookingButton.astro";
import ContactFormPanel from "./routes/ContactFormPanel.astro";

/*
 * Section 2 — the two routes. Panel one books, panel two writes.
 *
 * REVISED Aug 28 2026 against v2.0 of the build brief, which adds a contact form. Panel
 * two was a paragraph with the email address in it; it is now the form, and the panel's
 * heading changed with it — "Email us" no longer described what the panel does. The
 * address is still on the page, beneath the submit button, as an alternative route and as
 * the fallback if the form fails.
 *
 * TWO PANELS, AND ONLY ONE PRIMARY BUTTON. The booking button is the page's primary
 * action in primary fill; the form's submit is secondary, transparent with a 1px olive
 * border. That is a design-system rule rather than a preference, and it is what stops the
 * page asking the reader to choose between two equal-looking actions. The supplied design
 * fills the submit button; it was not followed. Everything about the form is in
 * routes/ContactFormPanel.astro, including why it exists at all.
 *
 * They are still the same width and the same card, because the page's h1 promises TWO
 * ways. Demoting the second panel visually would contradict the headline. The panels no
 * longer share a height — the form is much taller than the booking paragraph, and
 * stretching the booking panel to match would leave a large empty field below its button.
 */
---

<section class="section section--cream routes">
  <div class="container routes__grid">
    <div class="routes__panel">
      <p class="routes__lead">
        <span class="routes__term">Book a free 20-minute call.</span> The quickest way to
        establish whether there&rsquo;s anything here worth building. Bring the process
        costing you the most. We&rsquo;ll tell you whether AI solves it, and if it
        doesn&rsquo;t, we&rsquo;ll say that.
      </p>

      <div class="routes__cta">
        {/* Labelled `contact-hero` because the brief names this page's two CTA positions
            as hero and close. It is the first and topmost button on the page; section 1
            carries none, for the reason recorded there. */}
        <BookingButton location="contact-hero">
          Book your free 20-minute call
        </BookingButton>
      </div>
    </div>

    <div class="routes__panel">
      <ContactFormPanel />
    </div>

  </div>
</section>

<style>
  .routes__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ark-grid-gutter);
    align-items: start;
  }

  .routes__panel {
    display: flex;
    flex-direction: column;
    padding: 40px;
    background: var(--ark-white);
    border: 1px solid var(--ark-hairline);
    border-radius: var(--ark-radius);
    box-shadow: var(--ark-raised);
  }

  .routes__lead {
    font-size: var(--ark-body-lg);
    line-height: var(--ark-lh-body);
    color: var(--ark-body-ink);
  }

  /* The run-in bold that opens each panel. Display ink as well as weight — at 20px, bold
   * alone does not separate enough from body ink to read as a heading. */
  .routes__term {
    color: var(--ark-ink);
    font-weight: 700;
  }

  /* `margin-top: auto` pushes the button to the foot of its card so that the two panels'
   * bottom edges agree whatever the copy does. Without it the button floats mid-card
   * beside a taller neighbour. */
  .routes__cta {
    margin-top: auto;
    padding-top: 32px;
  }

  .routes__panel :focus-visible {
    outline: 2px solid var(--ark-olive);
    outline-offset: 3px;
    border-radius: 3px;
  }

  @media (max-width: 900px) {
    .routes__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .routes__panel {
      padding: 28px 22px;
    }

    .routes__lead {
      font-size: var(--ark-body);
    }

    .routes__cta {
      padding-top: 26px;
    }
  }
</style>
