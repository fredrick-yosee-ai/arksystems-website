---
import BookingButton from "../../common/BookingButton.astro";
import Icon from "../../common/Icon.astro";
import ContactFormPanel from "./routes/ContactFormPanel.astro";
import { LEGAL_EMAIL } from "../../../lib/legal";

/*
 * Section 2 — the two routes, as ONE FUSED CARD. Form on the white left, booking and the
 * email address on the stage-green right.
 *
 * REBUILT Aug 28 2026 to the supplied design, on Fredrick's instruction. The first build
 * put the two routes in two separate cards — the pattern other pages use — which was the
 * site's own idiom rather than anything from this design, and next to the design it read
 * as a different page. The fused split card IS the design's visual idea; the two halves
 * are one object with one radius and one shadow, and the colour change down the middle is
 * what tells you they are two routes to the same place.
 *
 * WHAT WAS TAKEN FROM THE DESIGN: the fused card, the colour split, the display heading on
 * each half, the rule under each heading, filled borderless inputs, the labelled contact
 * block low in the green half, and the generous padding.
 *
 * WHAT WAS NOT, AND WHY — each is a rule from the brief rather than a preference:
 *   - the fourth field ("Practice Name"). Three fields and no more; every extra field
 *     costs submissions, and "do not add company" is explicit
 *   - the message label written for accounting firms. This page is not /accounting
 *   - the filled submit button. Secondary is a design-system rule: the primary-fill
 *     action on this page is the booking button, and there is exactly one of those
 *   - the hero copy. Approved, and unchanged
 * The design was used for layout. The brief is the copy. Same call as /accounting.
 *
 * DOM ORDER IS ASIDE FIRST, FORM SECOND, and the desktop grid puts them back the other
 * way round. That is deliberate: stacked on a phone the booking route comes first, which
 * is short and is the page's primary action, instead of sitting under a long form where
 * nobody reaches it. Same trick the homepage's section 5 uses for its panel.
 *
 * THE EMAIL ADDRESS MOVED HERE from beneath the submit button, where v2.0 of the brief
 * puts it. It is the same address doing the same job — an alternative route — and the
 * design gives it a labelled block in this half. It is NOT duplicated: there is one
 * instance in this section. The form's error state still names it separately, which is
 * what covers the "fallback if the form fails" case the brief was protecting.
 */
---

<section class="section section--cream routes">
  <div class="container">
    <div class="routes__card">
      <aside class="routes__aside">
        <div>
          <h2 class="routes__heading routes__heading--dark">Book a free 20-minute call.</h2>

          <p class="routes__body">
            The quickest way to establish whether there&rsquo;s anything here worth
            building. Bring the process costing you the most. We&rsquo;ll tell you whether
            AI solves it, and if it doesn&rsquo;t, we&rsquo;ll say that.
          </p>

          <div class="routes__cta">
            {/* Labelled `contact-hero` because the brief names this page's two CTA
                positions as hero and close. It is the topmost button on the page —
                section 1 carries none, for the reason recorded there. */}
            <BookingButton location="contact-hero">
              Book your free 20-minute call
            </BookingButton>
          </div>
        </div>

        {/* Pushed to the foot of the green half by margin-top: auto, so it sits low
            against a tall form rather than floating under the button. */}
        <div class="routes__contact">
          <p class="eyebrow routes__contact-label">
            <Icon name="mail" size={18} class="routes__contact-icon" />
            Email
          </p>
          <a class="routes__contact-value" href={`mailto:${LEGAL_EMAIL}`}>{LEGAL_EMAIL}</a>
        </div>
      </aside>

      <div class="routes__form">
        <ContactFormPanel />
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * ONE CARD, TWO HALVES. `overflow: hidden` is what makes the green half's square corners
   * take the card's radius — without it the colour runs into the corner and the card stops
   * looking like one object, which is the whole point of the treatment.
   */
  .routes__card {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    background: var(--ark-white);
    border: 1px solid var(--ark-hairline);
    border-radius: var(--ark-radius-panel);
    box-shadow: var(--ark-raised);
    overflow: hidden;
  }

  .routes__form {
    grid-column: 1;
    grid-row: 1;
    padding: 48px;
  }

  /* The green half. `space-between` via the auto margin on the contact block below —
   * flex column so the button group sits under the copy and the address at the foot. */
  .routes__aside {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    padding: 48px 44px;
    background: var(--ark-stage-green);
  }

  /*
   * The display heading on each half. This is a treatment change, not a copy change: the
   * brief sets both panels as a paragraph opening with a bold run-in, and the design sets
   * that run-in as a heading. Every word is the brief's.
   */
  .routes__heading {
    padding-bottom: 16px;
    border-bottom: 1px solid var(--ark-hairline);
    font-family: var(--ark-font-display);
    font-size: var(--ark-h3);
    line-height: var(--ark-lh-h3);
    letter-spacing: -0.01em;
    color: var(--ark-ink);
  }

  /* On the green half the hairline needs to be visible against stage-green rather than
   * against white, so it takes the olive-tinted border instead of the warm one. */
  .routes__heading--dark {
    border-bottom-color: rgba(34, 58, 26, 0.16);
  }

  .routes__body {
    margin-top: 18px;
    font-size: var(--ark-body);
    line-height: var(--ark-lh-body);
    color: var(--ark-body-ink);
  }

  .routes__cta {
    margin-top: 26px;
  }

  .routes__contact {
    margin-top: auto;
    padding-top: 32px;
  }

  .routes__contact-label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  /* The icon takes the raw terracotta: it is a non-text mark, where the 3:1 UI threshold
   * applies and the brand hex passes. The label beside it is text and takes the ink shade
   * from `.eyebrow` in base.css. */
  .routes__contact-icon {
    color: var(--ark-terracotta);
    flex: none;
  }

  .routes__contact-value {
    font-size: var(--ark-body);
    line-height: 1.5;
    color: var(--ark-olive);
    font-weight: 600;
    text-underline-offset: 3px;
    /* An email address is one unbroken token; without this it can push the card wider
     * than the viewport at 390, and a wide child widens documentElement.scrollWidth. */
    overflow-wrap: anywhere;
  }

  .routes__card :focus-visible {
    outline: 2px solid var(--ark-olive);
    outline-offset: 3px;
    border-radius: 3px;
  }

  /* Stacked. The green half comes FIRST here because it is first in the DOM — short, and
   * carrying the primary action — and the form follows it. */
  @media (max-width: 900px) {
    .routes__card {
      grid-template-columns: minmax(0, 1fr);
      border-radius: var(--ark-radius);
    }

    .routes__aside,
    .routes__form {
      grid-column: 1;
      grid-row: auto;
    }

    .routes__aside {
      padding: 28px 22px 32px;
    }

    .routes__form {
      padding: 28px 22px 32px;
    }

    .routes__contact {
      padding-top: 26px;
    }
  }
</style>
