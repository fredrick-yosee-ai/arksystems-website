---
import Icon from "../../common/Icon.astro";
import ContactFormPanel from "./routes/ContactFormPanel.astro";
import { SITE } from "../../../consts";
import { LEGAL_EMAIL } from "../../../lib/legal";

/*
 * Section 2 — the whole of the page's action. One fused card: the form on the white left,
 * Direct Lines on the stage-green right.
 *
 * BUILT TO THE SUPPLIED DESIGN, on Fredrick's instruction of Aug 28 2026. This is the
 * third version of this section. It was two separate cards, then a fused card carrying a
 * booking pitch on the green half, and it is now the design as drawn.
 *
 * THE BOOKING PANEL IS GONE, AND THAT IS THE LARGEST CHANGE ON THE PAGE. The build brief
 * had this section carry two routes — a booking button and a form. The design carries one.
 * WHAT THAT COSTS, recorded so it is a known position rather than an accident:
 *
 *   - /contact no longer has a booking CTA of its own. The site's stated job is getting a
 *     visitor onto a 20-minute call, and on every other page a button does that. Here the
 *     only route to the calendar is the header's "Book 20 minutes", which is present on
 *     every page and stays visible on a phone.
 *   - `contact-hero` and `contact-closing` were removed from CtaLocation, because nothing
 *     renders them any more and that list is meant to be the record of what the site's own
 *     buttons are called.
 *
 * `overflow: hidden` on the card is load-bearing: without it the green half's square
 * corners run past the radius and the two halves stop reading as one object, which is the
 * whole point of the fused treatment.
 *
 * DOM ORDER IS FORM FIRST, then the panel — matching both the desktop reading order and
 * the tab order, which is the arrangement to prefer when nothing forces otherwise. The
 * earlier version reversed it to keep a booking button above the fold on a phone; with no
 * booking button left there is nothing to hoist, so the natural order wins.
 *
 * THE TAGLINE APPEARS HERE AND IN THE FOOTER — twice on the page, which is its established
 * count. It used to be the close section and the footer; the close is gone, so this panel
 * takes that slot rather than adding a third.
 */
---

<section class="contact">
  <div class="container">
    <div class="contact__card">
      <div class="contact__form">
        <ContactFormPanel />
      </div>

      <aside class="contact__aside">
        <div>
          <h2 class="contact__aside-title">Direct Lines</h2>

          <div class="contact__line">
            <Icon name="mail" size={19} class="contact__icon" />
            <div>
              <p class="eyebrow contact__label">Email</p>
              <a class="contact__value contact__value--link" href={`mailto:${LEGAL_EMAIL}`}>
                {LEGAL_EMAIL}
              </a>
            </div>
          </div>

          {/*
            THE LOCATION BLOCK IS A SCOPED EXCEPTION to the standing instruction of Aug 25
            2026, which took "Based in Metro Vancouver, working remotely across Canada" and
            everything like it off the site. Fredrick's decision of Aug 28 2026, taken with
            the conflict spelled out: a contact page is the one page where "where are you?"
            is the reader's actual question.

            IT DOES NOT TRAVEL. The homepage close, the founder strip, /accounting's hero
            trust line and close, and /about's sections 1, 3 and 6 all stay stripped. Do not
            restore any of them on the strength of this block. Still no street or mailing
            address anywhere, which is also why no LocalBusiness schema is emitted.
          */}
          <div class="contact__line">
            <Icon name="location" size={19} class="contact__icon" />
            <div>
              <p class="eyebrow contact__label">Location</p>
              <p class="contact__value">Metro Vancouver, BC</p>
              <p class="contact__note">Working remotely across Canada.</p>
            </div>
          </div>
        </div>

        {/* Pushed to the foot of the green half, so it sits low against a tall form
            rather than floating under the location block. */}
        <p class="contact__tagline">{SITE.tagline}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--ark-surface);
    padding-block: 40px var(--ark-section);
  }

  .contact__card {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    border-radius: var(--ark-radius-panel);
    overflow: hidden;
  }

  /* White against the page's near-white surface, with the hairline and the shadow doing
   * the separating. A fill alone would not read as a card here. */
  .contact__form {
    padding: 52px;
    background: var(--ark-white);
    border: 1px solid var(--ark-hairline);
    border-right: 0;
    border-radius: var(--ark-radius-panel) 0 0 var(--ark-radius-panel);
    box-shadow: var(--ark-raised);
  }

  .contact__aside {
    display: flex;
    flex-direction: column;
    padding: 52px 44px;
    background: var(--ark-stage-green);
  }

  .contact__aside-title {
    padding-bottom: 14px;
    /* Olive-tinted rather than the warm hairline, which disappears against stage-green. */
    border-bottom: 1px solid rgba(34, 58, 26, 0.18);
    font-family: var(--ark-font-display);
    font-size: var(--ark-h3);
    line-height: var(--ark-lh-h3);
    letter-spacing: -0.01em;
    color: var(--ark-ink);
  }

  .contact__line {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-top: 28px;
  }

  /* The raw terracotta: these are non-text marks, where the 3:1 UI threshold applies and
   * the brand hex passes. Any terracotta TEXT takes --ark-terracotta-ink instead. */
  .contact__icon {
    flex: none;
    margin-top: 2px;
    color: var(--ark-terracotta);
  }

  .contact__label {
    margin-bottom: 3px;
  }

  .contact__value {
    font-size: var(--ark-body-lg);
    line-height: 1.4;
    color: var(--ark-ink);
    /* An email address is one unbroken token; without this it can push the card wider
     * than the viewport at 390, and a wide child widens documentElement.scrollWidth. */
    overflow-wrap: anywhere;
  }

  .contact__value--link {
    color: var(--ark-olive);
    text-underline-offset: 3px;
  }

  .contact__note {
    margin-top: 6px;
    font-size: var(--ark-small);
    line-height: 1.5;
    color: var(--ark-muted);
  }

  .contact__tagline {
    margin-top: auto;
    padding-top: 40px;
    border-top: 1px solid rgba(34, 58, 26, 0.18);
    font-family: var(--ark-font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: 0.005em;
    color: var(--ark-ink);
  }

  .contact__card :focus-visible {
    outline: 2px solid var(--ark-olive);
    outline-offset: 3px;
    border-radius: 3px;
  }

  @media (max-width: 900px) {
    .contact {
      padding-block: 28px var(--ark-section-phone);
    }

    .contact__card {
      grid-template-columns: minmax(0, 1fr);
      border-radius: var(--ark-radius);
    }

    .contact__form {
      padding: 30px 22px 34px;
      border-right: 1px solid var(--ark-hairline);
      border-bottom: 0;
      border-radius: var(--ark-radius) var(--ark-radius) 0 0;
    }

    .contact__aside {
      padding: 30px 22px 34px;
    }

    .contact__tagline {
      margin-top: 34px;
      padding-top: 28px;
    }
  }
</style>
