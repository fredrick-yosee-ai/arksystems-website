---
import { SITE } from "../../../consts";

/*
 * Section 6 — before you book. Seven questions, verbatim from docs/workshop-page.md.
 *
 * THE FIRST QUESTION IS THE PAGE'S REASON TO EXIST. "Why would I pay for this when the
 * call is free?" is the objection the free discovery call creates, and the answer has to
 * concede the case where the workshop is the wrong purchase — "if you can name your one
 * problem, skip the workshop". Three places on this page argue against the sale, on
 * purpose: section 2's lede, this answer, and the close. Weaken all three and the
 * ranking the page is selling stops being credible.
 *
 * THE SECOND ANSWER TELLS A READER TO DO IT THEMSELVES, and that is the point of it.
 * "Some businesses can, and should… where that combination exists in-house, use it." It
 * is the second of the places this page argues against its own sale, and the only one
 * that names a genuine alternative rather than a smaller version of the same purchase.
 * Do not qualify it into a reason to buy anyway.
 *
 * THE FOURTH ANSWER IS THE OTHER ONE THAT MATTERS. "Often not, and we'd rather say so
 * before you book" is what protects a larger business from buying a day that cannot
 * cover them — and it protects the fee at the same time. It is the FAQ half of section
 * 3's scope callout; the two say the same thing and both have to.
 *
 * THE LAST ANSWER IS DELIBERATELY VAGUE and it is the copy file's own [CONFIRM] item, not an
 * oversight: "shortly after the day" stands in for a real commitment that has not been
 * decided. It is honest as written because it promises nothing specific. The moment a
 * number is agreed, this is where it goes — and until then, do not invent one. A stated
 * turnaround is a delivery timeline, which the claims standard treats the same way it
 * treats a result.
 *
 * NO OPEN/CLOSE HEIGHT ANIMATION. See the note in the style block and the longer one in
 * the homepage's FaqSection.astro. It was built, measured, and it stops the FAQ opening
 * at all.
 *
 * FAQPage schema is emitted here, beside the questions it describes, so the two cannot
 * drift apart.
 */

const faqs = [
  {
    q: "Why would I pay for this when the call is free?",
    a: "They do different jobs. The call, and the discovery that follows it, examines one problem you've already identified. The workshop is for when nothing has been identified yet, or when there are several candidates and no way to rank them. If you can name your one problem, skip the workshop — we'll tell you so on the call.",
  },
  {
    q: "Can't we work out our own priorities internally?",
    a: "Some businesses can, and should. It takes someone with time to measure what each candidate costs, and current knowledge of what AI does well and where it still fails. Where that combination exists in-house, use it. Where it doesn't, the ranking stays a matter of opinion and the decision keeps getting deferred.",
  },
  {
    q: "What if the workshop concludes we shouldn't build anything?",
    a: "Then that's the recommendation, in writing, with the reasoning. Knowing that a job isn't worth automating is worth more than discovering it after paying for a build.",
  },
  {
    q: "We're a larger business. Is one day enough?",
    a: "Often not, and we'd rather say so before you book. One day covers one area properly. Covering several means either a longer engagement or picking the area most worth examining first — usually the second, because a ranked list of one area you can act on beats a survey of five you can't.",
  },
  {
    q: "Who needs to be in the room?",
    a: "The people who perform the work, and someone who can make a decision. A day spent only with management produces a description of the process rather than the process.",
  },
  {
    q: "Do we have to implement with you?",
    a: "No. The document is yours. The credit exists because we'd like to build it, not because you're committed to us.",
  },
  {
    q: "How long before we get the recommendation?",
    a: "Shortly after the day, while the detail is still current. We agree the date when the workshop is booked.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
  url: `${SITE.url}/workshop`,
};
---

<section class="section section--stage faq" id="before-you-book">
  <div class="container">
    <div class="section__head faq__head">
      <h2 class="section__title faq__title">Before you book</h2>
    </div>

    <div class="faq__list">
      {
        faqs.map((item) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span>{item.q}</span>
              <svg
                class="faq__chevron"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="faq__a">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />

<style>
  /* No eyebrow. The approved heading IS the section's short name, so an eyebrow would
   * set "Before you book" twice in a row and have it read out twice. */
  .faq__title {
    max-width: none;
  }

  .faq__list {
    max-width: 820px;
    margin-top: 44px;
    border-top: 1px solid var(--ark-hairline);
  }

  .faq__item {
    border-bottom: 1px solid var(--ark-hairline);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 4px;
    cursor: pointer;
    list-style: none;
    font-family: var(--ark-font-display);
    font-weight: 700;
    font-size: 1.1875rem;
    line-height: 1.35;
    color: var(--ark-ink);
    transition: color 0.15s ease;
  }

  /* Safari draws its own triangle unless this is removed too. */
  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    color: var(--ark-terracotta-ink);
  }

  .faq__chevron {
    flex-shrink: 0;
    color: var(--ark-terracotta);
    transition: transform 0.25s ease;
  }

  .faq__item[open] .faq__chevron {
    transform: rotate(180deg);
  }

  .faq__a p {
    padding: 0 4px 24px;
    max-width: 68ch;
    font-size: var(--ark-body);
    line-height: var(--ark-lh-body);
    color: var(--ark-body-ink);
  }

  /* NO open/close height animation, deliberately, and it should not be added back
   * without testing that the answers actually appear. The obvious implementation —
   * `::details-content { block-size: 0 }` transitioning to `auto` under
   * `interpolate-size` — was built and measured on the homepage and it does not merely
   * fail to animate: it stops the FAQ opening at all. Listing content-visibility in the
   * transition takes the property out of the browser's hands so it stays `hidden`,
   * hidden content has no size, `auto` resolves to 0, and every answer stays invisible
   * while `details.open` reports true. The chevron rotation is the feedback. */

  @media (prefers-reduced-motion: reduce) {
    .faq__chevron {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .faq__list {
      margin-top: 28px;
    }

    .faq__q {
      font-size: 1.0625rem;
      padding: 18px 2px;
      gap: 14px;
    }

    .faq__a p {
      padding: 0 2px 20px;
      font-size: 1rem;
    }
  }
</style>
