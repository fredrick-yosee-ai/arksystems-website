---
import Icon from "../../common/Icon.astro";

/*
 * Section 2 — when a workshop is the right first step.
 *
 * NO CTA, deliberately. This section does recognition work: the reader has to finish
 * agreeing with the description of their own position before being asked for anything.
 * A button in the middle of it asks for a decision two paragraphs early. The homepage's
 * section 2 is built on the same rule.
 *
 * IT OPENS BY ARGUING AGAINST THE SALE, and that line must not be softened. "If you can
 * already name the one thing you'd fix, you don't need a workshop" is the most credible
 * sentence on the page — it is the reason to believe the ranking is honest, and it is
 * what makes the free call a real filter rather than a formality. The same concession is
 * made again in the FAQ and again in the close, on purpose.
 *
 * BLAME THE WORK, NEVER THE OWNER. All three blocks describe the situation, not the
 * reader: candidates that genuinely all look plausible, a cost nobody has had reason to
 * measure, and a job with no deadline forcing it. Not indecision, not disorganisation.
 * The standing rule is that the reader's admin load is what success creates.
 *
 * `benchmark` — the ruler — is reused from the homepage's section 2, where it was drawn
 * for the same absence: nothing internal to measure against. See Icon.astro.
 */

const blocks = [
  {
    icon: "candidates",
    title: "You have candidates, not a decision.",
    body: "Quoting, onboarding, reporting, client questions, document handling — all plausible, none obviously first.",
  },
  {
    icon: "benchmark",
    title: "Nobody has measured what any of them cost.",
    body: "Without that, ranking them is opinion. Every internal discussion ends where it started.",
  },
  {
    icon: "deferred",
    title: "It never reaches the top of the list.",
    body: "There's no deadline forcing it, so it loses to work that has one — every quarter, indefinitely.",
  },
] as const;
---

<section class="section section--cream first-step" id="right-first-step">
  <div class="container">
    <div class="section__head first-step__head">
      <h2 class="section__title first-step__title">
        This is for the list, not the single problem.
      </h2>
      <p class="section__lede">
        If you can already name the one thing you&rsquo;d fix, you don&rsquo;t need a
        workshop. Say so on the call and we&rsquo;ll go straight to discovery. The
        workshop exists for the more common position: several candidates, no ranking, and
        no capacity to establish which one matters.
      </p>
    </div>

    <ul class="first-step__cards">
      {
        blocks.map((block) => (
          <li class="card first-step__card">
            <span class="first-step__icon" aria-hidden="true">
              <Icon name={block.icon} />
            </span>
            <h3 class="first-step__card-title">{block.title}</h3>
            <p class="first-step__card-body">{block.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .first-step__head {
    max-width: none;
  }

  /* 34ch breaks the heading at the comma, so it sets on two lines rather than three. */
  .first-step__title {
    max-width: 34ch;
  }

  .first-step__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--ark-grid-gutter);
    margin-top: 52px;
    align-items: stretch;
  }

  .first-step__card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 3px solid var(--ark-terracotta);
    padding: 30px;
  }

  .first-step__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--ark-radius-pill);
    /* The accent at low opacity, so the well reads as terracotta's quiet register
     * rather than as a second saturated mark competing with the rule above it. */
    background: rgba(168, 98, 62, 0.12);
    color: var(--ark-terracotta-ink);
    margin-bottom: 2px;
  }

  .first-step__card-title {
    font-size: var(--ark-h3);
    line-height: var(--ark-lh-h3);
    letter-spacing: -0.01em;
  }

  .first-step__card-body {
    font-size: var(--ark-body);
    line-height: var(--ark-lh-body);
    color: var(--ark-body-ink);
  }

  @media (max-width: 1100px) {
    .first-step__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Three into two columns leaves the third alone on its row. Across both, it reads as
     * the third of a set rather than as an afterthought. */
    .first-step__card:last-child {
      grid-column: 1 / -1;
    }
  }

  /* Phone: rows, not cards. The terracotta rule moves from the top edge to the left
   * edge, which keeps the three reading as one set — the eye follows a single vertical
   * line down the column instead of three separate announcements. */
  @media (max-width: 900px) {
    .first-step__cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      margin-top: 34px;
    }

    .first-step__card,
    .first-step__card:last-child {
      grid-column: 1;
      display: grid;
      grid-template-columns: 38px minmax(0, 1fr);
      column-gap: 14px;
      row-gap: 6px;
      align-items: center;
      padding: 18px 18px 18px 16px;
      border-top: 1px solid var(--ark-hairline);
      border-left: 3px solid var(--ark-terracotta);
      border-radius: 0 var(--ark-radius) var(--ark-radius) 0;
    }

    .first-step__icon {
      width: 38px;
      height: 38px;
      margin-bottom: 0;
    }

    .first-step__card-title {
      font-size: 1.0625rem;
    }

    .first-step__card-body {
      grid-column: 1 / -1;
      font-size: 0.9375rem;
      line-height: 1.55;
    }
  }
</style>
