---
/*
 * The hero illustration for /workshop.
 *
 * IT DRAWS THE READER'S POSITION, NOT OUR OUTPUT. Section 2's first block is "You have
 * candidates, not a decision" — quoting, onboarding, reporting, client questions,
 * document handling, "all plausible, none obviously first". That is this picture: five
 * areas, five identical rows, five identical grey markers, and nothing to choose
 * between them. A visitor who recognises themselves here has understood the offer
 * before reading the subhead.
 *
 * IT IS THE FIRST HALF OF A PAIR. leave-with/ShortlistPanel.astro is the same five
 * areas after the day: ordered, weighted, one of them ruled out. The two are meant to
 * be recognised as the same list, so the five names and their order in the markup must
 * stay identical between the files. Change one and change the other.
 *
 * NO FIGURES, ANYWHERE. Not a dollar amount, not an hour count, not a percentage. There
 * are no delivered workshops to draw numbers from, and a number in an illustration is a
 * claim whatever the surrounding copy says. The bars are all the same length on purpose
 * — an unranked list has no lengths.
 *
 * THE LABEL PILL IS NOT THE GOLD BADGE. /accounting's demonstration panel carries
 * "Working system · Sample data" in gold because gold is the site's reserved attention
 * colour and that panel shows a system that genuinely runs, with sample figures in it.
 * Nothing here runs and nothing here is a figure, so this label is quiet and neutral.
 * Keeping the gold badge meaning one specific thing is what keeps it worth anything.
 */

/* Shared with ShortlistPanel. Same five, same order. */
const candidates = [
  "Quoting",
  "Client onboarding",
  "Reporting",
  "Client questions",
  "Document handling",
];
---

<figure class="board">
  <div class="board__stage">
    <div class="board__card">
      <p class="board__label">Before the workshop</p>

      <p class="board__title">Where should AI go first?</p>

      <ul class="board__list">
        {
          candidates.map((candidate) => (
            <li class="board__row">
              <span class="board__name">{candidate}</span>
              <span class="board__tag">Unranked</span>
              <span class="board__bar" aria-hidden="true" />
            </li>
          ))
        }
      </ul>

      <p class="board__foot">
        Five plausible answers, and no way to choose between them.
      </p>
    </div>
  </div>
</figure>

<style>
  .board {
    margin: 0;
    width: 100%;
  }

  .board__stage {
    background: var(--ark-stage-green);
    border-radius: var(--ark-radius-panel);
    padding: 40px;
  }

  .board__card {
    background: var(--ark-white);
    border: 1px solid var(--ark-hairline);
    border-radius: var(--ark-radius);
    box-shadow: var(--ark-floating);
    padding: 24px;
  }

  /* Quiet and neutral, deliberately — see the note at the top of this file about why it
   * is not the gold badge. */
  .board__label {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding-inline: 11px;
    border-radius: var(--ark-radius-pill);
    background: var(--ark-surface);
    border: 1px solid var(--ark-hairline);
    color: var(--ark-muted);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .board__title {
    margin-top: 14px;
    font-family: var(--ark-font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.3;
    color: var(--ark-ink);
  }

  .board__list {
    margin-top: 16px;
    display: grid;
    gap: 8px;
  }

  /* Every row identical. The whole point of the picture is that nothing here
   * distinguishes one candidate from another. */
  .board__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px 10px;
    padding: 11px 13px;
    background: var(--ark-surface);
    border: 1px solid var(--ark-hairline);
    border-radius: var(--ark-radius-sm);
  }

  .board__name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ark-ink);
  }

  .board__tag {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    /* --ark-muted, not --ark-muted-2. At 10px these pills are small text and need
     * 4.5:1; --ark-muted-2 measures 3.67 on white and fails. Measured, not guessed. */
    color: var(--ark-muted);
    background: var(--ark-white);
    border: 1px solid var(--ark-hairline);
    border-radius: var(--ark-radius-pill);
    padding: 3px 9px;
    white-space: nowrap;
  }

  /* Identical length in every row. An unranked list has no lengths. */
  .board__bar {
    grid-column: 1 / -1;
    height: 5px;
    border-radius: 3px;
    background: var(--ark-grey);
  }

  .board__foot {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--ark-hairline);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ark-muted);
  }

  @media (max-width: 900px) {
    .board__stage {
      padding: 14px;
      border-radius: 20px;
    }

    .board__card {
      padding: 18px 14px;
    }

    .board__row {
      padding: 10px 11px;
    }
  }
</style>
