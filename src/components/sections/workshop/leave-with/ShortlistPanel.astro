---
/*
 * The section 4 illustration for /workshop — the second half of the hero's pair.
 *
 * hero/CandidateBoardPanel.astro draws the reader's position: five areas, five
 * identical rows, nothing to choose between them. This draws the same five after the
 * day — ordered, weighted against each other, and one of them ruled out. The five names
 * and their order in the source array are shared between the two files deliberately, so
 * a reader who scrolls this far recognises their own list. Change one file and change
 * the other.
 *
 * IT MAKES SECTION 4's FOURTH BLOCK VISIBLE. "What we'd advise against" is the least
 * expected thing on the page and the easiest to skim past as a sentence. Drawn, it is
 * the one terracotta row in the panel and it is impossible to miss. The page's whole
 * argument is that we say when something is not worth building; this is where that stops
 * being a claim and becomes a picture.
 *
 * NO FIGURES, ANYWHERE — same rule as the hero panel, same reason. Section 4's copy
 * promises "an indicative figure" per candidate in the written document, and that is
 * exactly why none appears here: a figure in an illustration reads as a real one. The
 * bars carry relative weight and nothing else, and the row that would hold a number
 * says "Indicative figure" instead — naming the field rather than inventing a value.
 *
 * THE LABEL PILL IS NOT THE GOLD BADGE, for the reason set out in the hero panel: gold
 * is reserved for a system that genuinely runs, shown with sample data. This is the
 * shape of a document, so its label is quiet.
 */

/* Shared with CandidateBoardPanel. Same five, same order there — reordered here, which
 * is the entire point. `weight` is a percentage of the bar's track, not of anything in
 * the world. */
const ranked = [
  { rank: 1, name: "Document handling", weight: 100, tag: "Build first", state: "first" },
  { rank: 2, name: "Quoting", weight: 74, tag: "Then", state: "next" },
  { rank: 3, name: "Client onboarding", weight: 52, tag: "Then", state: "next" },
  { rank: 4, name: "Reporting", weight: 31, tag: "Later", state: "later" },
  { rank: 5, name: "Client questions", weight: 18, tag: "Advise against", state: "against" },
];
---

<figure class="shortlist">
  <div class="shortlist__stage">
    <div class="shortlist__card">
      <p class="shortlist__label">After the day &middot; Example structure</p>

      <p class="shortlist__title">Ranked shortlist</p>

      <ul class="shortlist__list">
        {
          ranked.map((item) => (
            <li class:list={["shortlist__row", `shortlist__row--${item.state}`]}>
              <span class="shortlist__rank" aria-hidden="true">{item.rank}</span>
              <span class="shortlist__name">{item.name}</span>
              <span class="shortlist__tag">{item.tag}</span>
              <span class="shortlist__track" aria-hidden="true">
                <span class="shortlist__bar" style={`width:${item.weight}%`} />
              </span>
            </li>
          ))
        }
      </ul>

      {/* The field is named, never filled. See the note above. */}
      <div class="shortlist__fields">
        <span class="shortlist__field">Indicative figure</span>
        <span class="shortlist__field">Scope</span>
        <span class="shortlist__field">Reasoning</span>
        <span class="shortlist__field-note">against every row</span>
      </div>
    </div>
  </div>
</figure>

<style>
  .shortlist {
    margin: 0;
    width: 100%;
  }

  .shortlist__stage {
    background: var(--ark-stage-green);
    border-radius: var(--ark-radius-panel);
    padding: 40px;
  }

  .shortlist__card {
    background: var(--ark-white);
    border: 1px solid var(--ark-hairline);
    border-radius: var(--ark-radius);
    box-shadow: var(--ark-floating);
    padding: 24px;
  }

  .shortlist__label {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding-inline: 11px;
    border-radius: var(--ark-radius-pill);
    background: var(--ark-surface);
    border: 1px solid var(--ark-hairline);
    color: var(--ark-muted);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .shortlist__title {
    margin-top: 14px;
    font-family: var(--ark-font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.3;
    color: var(--ark-ink);
  }

  .shortlist__list {
    margin-top: 16px;
    display: grid;
    gap: 8px;
  }

  .shortlist__row {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px 10px;
    padding: 11px 13px;
    background: var(--ark-surface);
    border: 1px solid var(--ark-hairline);
    border-left: 3px solid var(--ark-hairline);
    border-radius: var(--ark-radius-sm);
  }

  .shortlist__rank {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--ark-white);
    border: 1px solid var(--ark-hairline);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--ark-muted);
    line-height: 1;
  }

  .shortlist__name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ark-ink);
  }

  .shortlist__tag {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--ark-radius-pill);
    padding: 3px 9px;
    white-space: nowrap;
    background: var(--ark-white);
    border: 1px solid var(--ark-hairline);
    /* --ark-muted, not --ark-muted-2. At 10px these pills are small text and need
     * 4.5:1; --ark-muted-2 measures 3.67 on white and fails. Measured, not guessed. */
    color: var(--ark-muted);
  }

  .shortlist__track {
    grid-column: 1 / -1;
    height: 5px;
    border-radius: 3px;
    background: var(--ark-grey);
    overflow: hidden;
  }

  .shortlist__bar {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: var(--ark-green-3);
  }

  /* Rank one. The recommendation, in olive — the site's primary, used here exactly as it
   * is used for a CTA: this is the thing to act on. */
  .shortlist__row--first {
    border-left-color: var(--ark-olive);
  }

  .shortlist__row--first .shortlist__rank {
    background: var(--ark-olive);
    border-color: var(--ark-olive);
    color: var(--ark-on-dark);
  }

  .shortlist__row--first .shortlist__tag {
    background: var(--ark-green-soft);
    border-color: transparent;
    color: var(--ark-olive);
  }

  .shortlist__row--first .shortlist__bar {
    background: var(--ark-olive);
  }

  .shortlist__row--next {
    border-left-color: var(--ark-olive-2);
  }

  .shortlist__row--later .shortlist__bar {
    background: var(--ark-green-2);
  }

  /* The one row the page exists to be trusted for. Terracotta, the single saturated
   * accent, and the only one in the panel. */
  .shortlist__row--against {
    border-left-color: var(--ark-terracotta);
  }

  .shortlist__row--against .shortlist__name {
    text-decoration: line-through;
    text-decoration-color: var(--ark-muted-2);
    text-decoration-thickness: 1px;
  }

  .shortlist__row--against .shortlist__tag {
    background: rgba(168, 98, 62, 0.12);
    border-color: transparent;
    color: var(--ark-terracotta-ink);
  }

  .shortlist__row--against .shortlist__bar {
    background: var(--ark-terracotta);
    opacity: 0.45;
  }

  .shortlist__fields {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--ark-hairline);
  }

  .shortlist__field {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--ark-body-ink);
    background: var(--ark-surface);
    border: 1px dashed var(--ark-hairline);
    border-radius: var(--ark-radius-pill);
    padding: 3px 10px;
  }

  .shortlist__field-note {
    font-size: 0.75rem;
    color: var(--ark-muted);
  }

  @media (max-width: 900px) {
    .shortlist__stage {
      padding: 14px;
      border-radius: 20px;
    }

    .shortlist__card {
      padding: 18px 14px;
    }

    .shortlist__row {
      padding: 10px 11px;
    }
  }
</style>
