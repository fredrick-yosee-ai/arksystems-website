---
/*
 * Section 4 — where it stops. With section 3 this carries the argument, and it gets
 * comparable weight for that reason.
 *
 * This is a SELLING section, not fine print, and it must never be styled as a
 * disclaimer. For a reader who holds a designation, the scope limit is the reassurance:
 * the thing they are checking for is whether we understand that the judgment is not
 * ours to take. Two columns side by side so the boundary reads at a glance, real <h3>s
 * and real <ul>s so it survives with styles off and reads correctly to a screen reader
 * — which matters more here than anywhere else on the page, because this section is the
 * one making a claim about what ArkSystems is not.
 *
 * The two icon sets differ on purpose. What the system performs gets a check; what
 * remains with the firm gets a person. A reader scanning the columns should be able to
 * tell which is which from the icons alone, before reading a word.
 *
 * COLUMN HEADINGS AND CLOSING LINE ARE THE COPY FILE'S, NOT THE DESIGN'S. Stitch set
 * them as "What AI runs" / "What stays with your people", trimmed the third item in the
 * right-hand column down to "Every judgment call — professional or ethical", and
 * replaced the closing line with "We just make sure the decision is the only thing left
 * to do", in italics. The trimmed item is the one that matters most: where the line sits
 * between what runs automatically and what stops for a person is itself the firm's
 * decision, and that is exactly the reassurance a partner is reading for.
 *
 * NO COMPLIANCE OR REGULATORY FRAMING ANYWHERE. That is the copy file's first rule for
 * this page. The previous build of /accounting cited CPABC's Code, Rule 218 and PIPEDA
 * across a whole section; all of it is gone, and data handling is answered once, plainly,
 * in the FAQ. Do not reintroduce it here — it made the page read as a compliance vendor
 * rather than a builder, and it raised a concern before the reader had it.
 */

const systemPerforms = [
  "Collects, extracts and routes information",
  "Codes and categorizes against rules you set",
  "Stops on anything outside those rules",
  "Pursues what hasn't arrived",
  "Answers routine questions in your firm's words",
  "Reports status, exposure and capacity",
];

const remainsWithFirm = [
  "Every accounting decision",
  "Every tax position",
  "Every judgment call, including where the line sits between what runs automatically and what stops for a person",
  "What gets filed, and when",
  "Anything a client is advised",
  "Sign-off on all of it",
];
---

<section class="section section--stage stop" id="where-it-stops">
  <div class="container">
    <div class="section__head">
      <h2 class="section__title stop__title">We don&rsquo;t do accounting. That&rsquo;s the point.</h2>
      <p class="section__lede stop__lede">
        ArkSystems doesn&rsquo;t file, take tax positions, provide professional advice,
        perform assurance work or sign anything. Nobody here holds a designation and we
        don&rsquo;t imply otherwise. We build the system. Your practice keeps its
        process, and every judgment inside it.
      </p>
    </div>

    <div class="stop__columns">
      <div class="stop__column">
        <h3 class="stop__column-title">What the system performs</h3>
        <ul class="stop__list">
          {
            systemPerforms.map((item) => (
              <li class="stop__item">
                <span class="stop__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="m8 12.3 2.7 2.7L16 9.6" />
                  </svg>
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="stop__column stop__column--firm">
        <h3 class="stop__column-title">What remains with the firm</h3>
        <ul class="stop__list">
          {
            remainsWithFirm.map((item) => (
              <li class="stop__item">
                <span class="stop__icon stop__icon--firm" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8.4" r="3.4" />
                    <path d="M5.6 19.4a6.4 6.4 0 0 1 12.8 0" />
                  </svg>
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="stop__closing">
      Nothing we build decides anything you haven&rsquo;t already decided. It applies
      rules you set, records what it did and why, and stops where your rules stop.
    </p>
  </div>
</section>

<style>
  .stop__title {
    max-width: 20ch;
  }

  .stop__lede {
    max-width: 68ch;
  }

  .stop__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ark-grid-gutter);
    margin-top: 52px;
  }

  .stop__column {
    background: var(--ark-white);
    border: 1px solid var(--ark-hairline);
    border-top: 3px solid var(--ark-olive-2);
    border-radius: var(--ark-radius);
    box-shadow: var(--ark-raised);
    padding: 30px 28px 32px;
  }

  /* The right-hand column takes the accent. It is the one the reader is actually
   * checking, and on a stacked phone layout the coloured rule is what tells them the
   * list has changed sides — there is no side-by-side comparison left to do it. */
  .stop__column--firm {
    border-top-color: var(--ark-terracotta);
  }

  .stop__column-title {
    font-size: var(--ark-h3);
    line-height: var(--ark-lh-h3);
    letter-spacing: -0.01em;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--ark-hairline);
  }

  .stop__column--firm .stop__column-title {
    color: var(--ark-terracotta-ink);
  }

  .stop__list {
    display: grid;
    gap: 15px;
    margin-top: 22px;
  }

  .stop__item {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    font-size: var(--ark-body);
    line-height: 1.55;
    color: var(--ark-body-ink);
  }

  .stop__icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    margin-top: 2px;
    color: var(--ark-olive-2);
  }

  .stop__icon--firm {
    color: var(--ark-terracotta-ink);
  }

  .stop__icon svg {
    width: 22px;
    height: 22px;
    display: block;
  }

  .stop__closing {
    margin-top: 40px;
    max-width: 78ch;
    font-size: var(--ark-body-lg);
    line-height: var(--ark-lh-body);
    color: var(--ark-ink);
    border-left: 4px solid var(--ark-olive-2);
    padding-left: 24px;
  }

  @media (max-width: 900px) {
    .stop__columns {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
      margin-top: 34px;
    }

    .stop__column {
      padding: 24px 20px 26px;
    }

    .stop__list {
      gap: 12px;
      margin-top: 18px;
    }

    .stop__item {
      font-size: 1rem;
      gap: 11px;
    }

    .stop__icon,
    .stop__icon svg {
      width: 20px;
      height: 20px;
    }

    .stop__closing {
      margin-top: 26px;
      font-size: 1.0625rem;
      padding-left: 16px;
    }
  }
</style>
