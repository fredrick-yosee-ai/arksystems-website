---
/*
 * Section 2 — the actual problem.
 *
 * Split by content type, not mid-sentence: all the prose is in the left column and all
 * four recognitions are in the right. This is the same rule the homepage's ProblemSection
 * learned the hard way — a layout that puts body copy in two columns and more underneath
 * gives the eye no way to tell where to start reading.
 *
 * The second paragraph sits in an inset panel because it is doing different work from
 * the paragraph above it. The first is the symptom; the second is the "blame the work,
 * never the owner" rule stated outright, and on a page written for professionals who
 * are good at their jobs it is the sentence that decides whether the rest gets read.
 *
 * The build note in the doc is absolute: no figures or statistics anywhere in this
 * section. Every number on this page belongs to a third party and lives in section 7 or
 * the FAQ, where its caption is attached to it. Nothing quantified goes here.
 *
 * Icons are inline SVG in the Material Symbols idiom, never the Material Symbols font —
 * the font is a third-party request, which the self-hosting rule rules out and which
 * would have to be named on the Privacy page.
 */

const recognitions = [
  {
    title: "The same request, three times.",
    body: "The first ask, the reminder, and the one that finally works. Every client, every period.",
    // loop — the request that comes back round
    icon: '<path d="M4 8.5A4.5 4.5 0 0 1 8.5 4h9l-3-3M20 15.5A4.5 4.5 0 0 1 15.5 20h-9l3 3"/><path d="M17.5 4 20 6.5 17.5 9M6.5 15 4 17.5 6.5 20"/>',
  },
  {
    title: "Nobody can see what is outstanding.",
    body: "To find out what is still missing you have to ask someone, and they have to go and look.",
    // eye with a slash — no visibility
    icon: '<path d="M3 3l18 18"/><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.6 5.2A9.6 9.6 0 0 1 12 5c5.5 0 9 6 9 6a15.4 15.4 0 0 1-2.8 3.6"/><path d="M6.2 6.3A15.4 15.4 0 0 0 3 11s3.5 6 9 6a9.5 9.5 0 0 0 3.1-.5"/>',
  },
  {
    title: "The same figures get handled twice.",
    body: "Once by whoever received them, again by whoever put them where they belong.",
    // two stacked sheets — the same thing, done again
    icon: '<rect x="8.5" y="8.5" width="12" height="12" rx="2.4"/><path d="M15.5 5.5H5.6A2.1 2.1 0 0 0 3.5 7.6v9.9"/>',
  },
  {
    title: "It all lands at once.",
    body: "The month before a filing deadline is when the chasing is worst and when there is least time to do it.",
    // clock — the deadline
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.3l3.4 2"/>',
  },
];
---

<section class="actual-problem">
  <div class="container actual-problem__inner">
    <div class="actual-problem__main">
      <h2 class="actual-problem__title">Most of the week is not accounting.</h2>

      <p class="actual-problem__lead">
        It is asking a client for documents. Asking again. Reading whatever finally turns
        up, in whatever form it turned up in, and putting it somewhere it can be used.
        Then finding out on the Thursday before a deadline that two things are still
        missing and one of them is wrong.
      </p>

      {/* The "blame the work, never the owner" rule. Load-bearing on this page. */}
      <div class="actual-problem__aside">
        <p>
          None of that means a practice is badly run. It is what happens when work arrives
          from a lot of clients at once, each with their own way of doing things, and none
          of them thinking about your deadline.
        </p>
      </div>
    </div>

    <ul class="actual-problem__cards">
      {
        recognitions.map((item) => (
          <li class="actual-problem__card">
            <span class="actual-problem__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
            </span>
            <div>
              <h3 class="actual-problem__card-title">{item.title}</h3>
              <p class="actual-problem__card-body">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .actual-problem {
    background: var(--ark-cream);
    padding-block: 96px;
  }

  .actual-problem__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 64px;
    align-items: start;
  }

  .actual-problem__title {
    font-size: var(--ark-h2);
    letter-spacing: -0.02em;
    max-width: 16ch;
  }

  .actual-problem__lead {
    margin-top: 30px;
    max-width: 60ch;
    font-size: 1.16rem;
    line-height: 1.7;
    color: #5b564e;
  }

  .actual-problem__aside {
    margin-top: 26px;
    max-width: 62ch;
    background: #fff;
    border-left: 4px solid var(--ark-olive-2);
    border-radius: 0 var(--ark-radius) var(--ark-radius) 0;
    padding: 24px 28px;
  }

  .actual-problem__aside p {
    font-size: 1.02rem;
    line-height: 1.68;
    color: var(--ark-charcoal);
  }

  /* --- the four recognitions --- */

  .actual-problem__cards {
    display: grid;
    gap: 14px;
  }

  .actual-problem__card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: #fff;
    border: 1px solid var(--ark-grey);
    border-radius: var(--ark-radius);
    padding: 22px 24px;
    transition: border-color 0.18s ease;
  }

  .actual-problem__card:hover {
    border-color: var(--ark-olive-2);
  }

  .actual-problem__icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: var(--ark-green-soft);
    color: var(--ark-olive);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .actual-problem__icon svg {
    width: 21px;
    height: 21px;
  }

  .actual-problem__card-title {
    font-size: 1.06rem;
    line-height: 1.3;
  }

  .actual-problem__card-body {
    margin-top: 8px;
    font-size: 0.97rem;
    line-height: 1.58;
    color: #5b564e;
  }

  @media (prefers-reduced-motion: reduce) {
    .actual-problem__card {
      transition: none;
    }
  }

  @media (max-width: 1100px) {
    .actual-problem__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 44px;
    }

    .actual-problem__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media (max-width: 760px) {
    .actual-problem__cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 900px) {
    .actual-problem {
      padding-block: 56px;
    }

    .actual-problem__lead {
      margin-top: 22px;
      font-size: 1.05rem;
    }
  }

  @media (max-width: 900px), (orientation: portrait) {
    .actual-problem__title {
      text-align: center;
      margin-inline: auto;
    }
  }
</style>
