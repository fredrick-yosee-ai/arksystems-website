---
import { SITE } from "../../../consts";

/*
 * Section 7 — before you book, and the page's FAQPage schema.
 *
 * An FAQ is where you close, not where you disclose. Every one of these is a buying
 * question and every answer removes a reason not to book. Two of them argue against us
 * on purpose — "Often you wouldn't, and we'll say so" is the most persuasive sentence
 * on the page precisely because it is the one a vendor would never write.
 *
 * Built on <details>/<summary>, so it works with no JavaScript at all: keyboard
 * operable, announced correctly as a disclosure, open and closed state handled by the
 * browser. Every answer stays in the DOM whether open or shut, so nothing is hidden
 * from search engines, from find-on-page, or from the schema below.
 *
 * FOUR QUESTIONS, NOT THE COPY FILE'S SIX. Both removals are Fredrick's instruction of
 * Aug 25 2026:
 *
 *   "Do you work outside British Columbia?" — removed with its answer, because the answer
 *   WAS the location line ("We're in Metro Vancouver and work remotely across Canada"),
 *   and a question left standing with nothing behind it is worse than no question. The
 *   same instruction took that line off four other places on the site.
 *
 *   "We already use Dext and Karbon. Why would we need this?" — removed entirely.
 *
 * Worth recording what the second one cost, so it stays a decision and not a drift: that
 * answer opened "Often you wouldn't, and we'll say so", which was the only place on the
 * page that argued against the sale, and the only place naming a product a reader may
 * already be paying for. If the objection comes up on calls, this is where it used to be
 * answered.
 *
 * THE OLD ACCOUNTING FAQ IS GONE ENTIRELY and should not be mined for parts. It carried
 * three vendor-sponsored survey figures with visible source captions, and answers built
 * on CPABC's Code and Rule 218. The copy file's first rule for this page rules all of
 * that out: no governance, compliance or regulatory content anywhere, and data handling
 * answered once, plainly. common/Caption.astro existed for those captions and is now
 * unused by this page.
 *
 * The Stitch design's four questions are not used either, and two of them could not be:
 * "SOC2 compliant infrastructure" is a compliance assurance and "built and running
 * within 4 to 6 weeks" is a delivery timeline, both of which the copy file's claims
 * section lists as never claimed. Neither appears anywhere in the approved copy —
 * Stitch invented them.
 */

const faqs = [
  {
    q: "Do you perform any accounting work?",
    a: "No. We don't file, take tax positions, provide professional advice, perform assurance work or sign anything. We build the system that runs the administrative steps around your work. Your firm performs the accounting, exactly as it does now.",
  },
  {
    q: "Where does our client data go?",
    a: "Into systems you already own. We don't operate a platform that holds your records, so there's nothing to migrate away from if you stop working with us. Every provider in the path is named in writing before anything is connected, and you decide what runs automatically and what stops for a person.",
  },
  {
    q: "We tried an AI tool and it wasn't impressive.",
    a: "Common, and not a reflection on your firm. General tools perform well on work with a determinate answer and poorly on work requiring judgment. We build only the first kind, and only for work that never required your judgment.",
  },
  {
    q: "Who owns it when you're finished?",
    a: "You do. It operates on your accounts and the work remains your property. There's no ArkSystems subscription attached to it.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
  url: `${SITE.url}/accounting`,
};
---

<section class="section section--surface faq" id="before-you-book">
  <div class="container">
    <div class="section__head faq__head">
      <h2 class="section__title faq__title">Before you book</h2>
    </div>

    <div class="faq__list">
      {
        faqs.map((item) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span>{item.q}</span>
              <svg
                class="faq__chevron"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="faq__a">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />

<style>
  /* No eyebrow. The approved heading IS the section's short name, so an eyebrow would
   * set "Before you book" twice in a row and have it read out twice. */
  .faq__title {
    max-width: none;
  }

  .faq__list {
    max-width: 820px;
    margin-top: 44px;
    border-top: 1px solid var(--ark-hairline);
  }

  .faq__item {
    border-bottom: 1px solid var(--ark-hairline);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 4px;
    cursor: pointer;
    list-style: none;
    font-family: var(--ark-font-display);
    font-weight: 700;
    font-size: 1.1875rem;
    line-height: 1.35;
    color: var(--ark-ink);
    transition: color 0.15s ease;
  }

  /* Safari draws its own triangle unless this is removed too. */
  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    color: var(--ark-terracotta-ink);
  }

  .faq__chevron {
    flex-shrink: 0;
    color: var(--ark-terracotta);
    transition: transform 0.25s ease;
  }

  .faq__item[open] .faq__chevron {
    transform: rotate(180deg);
  }

  .faq__a p {
    padding: 0 4px 24px;
    max-width: 68ch;
    font-size: var(--ark-body);
    line-height: var(--ark-lh-body);
    color: var(--ark-body-ink);
  }

  /* NO open/close height animation, deliberately, and it should not be added back
   * without testing that the answers actually appear. The obvious implementation —
   * `::details-content { block-size: 0 }` transitioning to `auto` under
   * `interpolate-size` — was built and measured on the homepage and it does not merely
   * fail to animate: it stops the FAQ opening at all. Listing content-visibility in the
   * transition takes the property out of the browser's hands so it stays `hidden`,
   * hidden content has no size, `auto` resolves to 0, and every answer stays invisible
   * while `details.open` reports true. The chevron rotation is the feedback and it is
   * enough. See the longer note in the homepage's FaqSection.astro. */

  @media (prefers-reduced-motion: reduce) {
    .faq__chevron {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .faq__list {
      margin-top: 28px;
    }

    .faq__q {
      font-size: 1.0625rem;
      padding: 18px 2px;
      gap: 14px;
    }

    .faq__a p {
      padding: 0 2px 20px;
      font-size: 1rem;
    }
  }
</style>
