---
/*
 * The hero illustration for /accounting.
 *
 * WHAT IT HAS TO SAY. The h1 is "AI that works inside the practice you already have"
 * and the subhead ends "the steps that never needed a qualified person stop waiting for
 * one". That is one idea — a division of labour — and the picture exists to show it in
 * the second before anyone reads the paragraph. So it is not a decorative sketch: it is
 * the five areas the subhead names, running, and underneath them the one card that says
 * the judgment did not move.
 *
 * WHY IT IS NOT THE STITCH ARTWORK. The design export fills this space with grey
 * rounded rectangles and a pulsing sync glyph — abstract primitives, per the design
 * system's "Product Sketch" component. Abstract works when the surrounding copy is
 * concrete and the reader only needs an impression of an interface. Here the copy is
 * doing the opposite job: it lists five specific areas of practice work, and a reader
 * who is deciding whether we understand accounting firms learns nothing from five grey
 * bars. The two-plane composition the design asks for is kept — tinted stage panel,
 * white card floating in front of it, one terracotta element — and the primitives are
 * filled with the words the section already uses.
 *
 * NO FIGURES, ANYWHERE. Not "4 files waiting", not a percentage, not a count. The
 * demonstration panel in section 5 carries a "Working system · Sample data" badge which
 * is what licenses the sample figures in it; the hero carries no such badge and gets no
 * such licence. A number in an unlabelled hero graphic is a claim, and there are no
 * results to claim yet.
 *
 * HTML and CSS, not a viewBox. Real text reflows, honours a zoom setting, and can be
 * read out; text baked into an SVG does none of those. It also means the labels reach
 * the self-hosted webfonts, which is the trap CLAUDE.md documents for <img>-loaded SVG.
 */

const areas = [
  { icon: "onboarding", label: "Client onboarding" },
  { icon: "documents", label: "Document collection" },
  { icon: "recurring", label: "Routine client questions" },
  { icon: "fileStatus", label: "File status" },
  { icon: "deadline", label: "Deadline exposure" },
];
---

<figure class="board">
  <div class="board__stage">
    <div class="board__card">
      <p class="board__title">The work around the work</p>

      <ul class="board__areas">
        {
          areas.map((area) => (
            <li class="board__area">
              <span class="board__icon" aria-hidden="true">
                {area.icon === "onboarding" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9.4" cy="7.2" r="3.4" />
                    <path d="M3.2 19.8a6.2 6.2 0 0 1 12.4 0" />
                    <path d="M18.4 11.4v5.8M15.5 14.3h5.8" />
                  </svg>
                )}
                {area.icon === "documents" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4.8" y="4" width="14.4" height="16.6" rx="2.2" />
                    <rect x="9" y="2.1" width="6" height="3.8" rx="1.4" />
                    <path d="m9.1 13.2 2.3 2.3 4.5-4.7" />
                  </svg>
                )}
                {area.icon === "recurring" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8.2 3.4h11.4a1.8 1.8 0 0 1 1.8 1.8v6.4a1.8 1.8 0 0 1-1.8 1.8h-1.2v3.2l-3.4-3.2H8.2a1.8 1.8 0 0 1-1.8-1.8V5.2a1.8 1.8 0 0 1 1.8-1.8z" />
                    <path d="M6.4 8.6H4.4a1.8 1.8 0 0 0-1.8 1.8v5.4a1.8 1.8 0 0 0 1.8 1.8h.9v3l3.2-3h3.7" />
                  </svg>
                )}
                {area.icon === "fileStatus" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4.4 8.2V4.3a1.6 1.6 0 0 1 1.6-1.6h9.2l4 4v3.6" />
                    <path d="M15.2 2.7v4.2h4" />
                    <path d="M4.4 12.6v7a1.6 1.6 0 0 0 1.6 1.6h4.2" />
                    <path d="M21.4 16.6s-1.9 3.4-4.8 3.4-4.8-3.4-4.8-3.4 1.9-3.4 4.8-3.4 4.8 3.4 4.8 3.4z" />
                    <circle cx="16.6" cy="16.6" r="1.4" />
                  </svg>
                )}
                {area.icon === "deadline" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4.8" width="18" height="16.2" rx="2.2" />
                    <path d="M3 9.8h18" />
                    <path d="M7.8 2.9v3.8M16.2 2.9v3.8" />
                    <path d="M12 12.9v3.2M12 18.4h.01" />
                  </svg>
                )}
              </span>
              <span class="board__label">{area.label}</span>
              <span class="board__state">Running</span>
            </li>
          ))
        }
      </ul>

      <p class="board__note">No portal to learn. No process to change.</p>
    </div>

    {/*
      The second plane. It sits lower and further right than the card above it, and it
      is the only terracotta element in the composition, because it is the one thing in
      the picture that did not move: section 4 spends a whole section on this boundary
      and the hero states it once, quietly, before the reader gets there.
    */}
    <div class="board__keep">
      <span class="board__keep-mark" aria-hidden="true"></span>
      <span class="board__keep-label">Every judgment</span>
      <span class="board__keep-value">Stays with your people</span>
    </div>
  </div>
</figure>

<style>
  .board {
    margin: 0;
  }

  .board__stage {
    position: relative;
    background: var(--ark-stage-green);
    border-radius: var(--ark-radius-panel);
    /* Bottom padding carries the second card, which overlaps the first. */
    padding: 36px 34px 30px;
  }

  .board__card {
    background: var(--ark-white);
    border: 1px solid var(--ark-hairline);
    border-radius: var(--ark-radius);
    box-shadow: var(--ark-floating);
    padding: 22px 20px 18px;
  }

  .board__title {
    font-family: var(--ark-font-display);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.3;
    color: var(--ark-ink);
  }

  .board__areas {
    margin-top: 14px;
    display: grid;
    gap: 7px;
  }

  .board__area {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto;
    align-items: center;
    gap: 11px;
    padding: 8px 11px;
    background: var(--ark-surface);
    border: 1px solid var(--ark-hairline);
    border-radius: var(--ark-radius-sm);
  }

  .board__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--ark-stage-green);
    color: var(--ark-olive);
  }

  .board__icon svg {
    width: 17px;
    height: 17px;
  }

  .board__label {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ark-ink);
  }

  /* A state, not a metric. "Running" says the step no longer waits on anyone, which is
   * the sentence above it; a count would be a figure this page has not earned. */
  .board__state {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ark-olive);
    background: var(--ark-green-soft);
    border-radius: var(--ark-radius-pill);
    padding: 3px 9px;
    white-space: nowrap;
  }

  .board__note {
    margin-top: 12px;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--ark-muted);
  }

  .board__keep {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 10px;
    margin-top: 18px;
    /* Offset right, so the two cards read as two planes rather than as one stack. The
     * offset is clamped below 1100px, where the panel narrows enough for it to push the
     * label into the panel edge. */
    margin-left: 44px;
    background: var(--ark-white);
    border: 1px solid rgba(168, 98, 62, 0.32);
    border-left: 3px solid var(--ark-terracotta);
    border-radius: var(--ark-radius-sm);
    box-shadow: var(--ark-raised);
    padding: 12px 16px;
  }

  .board__keep-mark {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ark-terracotta);
  }

  .board__keep-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ark-terracotta-ink);
  }

  .board__keep-value {
    grid-column: 2;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ark-ink);
  }

  @media (max-width: 1100px) {
    .board__keep {
      margin-left: 24px;
    }
  }

  /* Phone. The panel gives back most of its padding rather than shrinking the type —
   * everything in here is a label at 14px or below already, and the standing rule is
   * that anything inside a demonstration panel stays large enough to actually read. */
  @media (max-width: 900px) {
    .board__stage {
      padding: 16px 14px 14px;
      border-radius: 20px;
    }

    .board__card {
      padding: 18px 14px 14px;
    }

    .board__area {
      grid-template-columns: 28px minmax(0, 1fr) auto;
      gap: 9px;
      padding: 8px 10px;
    }

    .board__icon {
      width: 28px;
      height: 28px;
    }

    .board__label {
      font-size: 0.8125rem;
    }

    /* The pill stays on a phone rather than being dropped for room. "Running" is the
     * only word in the picture that says the step no longer waits on a person, which is
     * the whole point of the illustration — losing it leaves five labelled rows saying
     * nothing. Measured at 390px: the longest label, "Routine client questions", still
     * sets on one line beside it. */
    .board__state {
      font-size: 0.625rem;
      padding: 3px 7px;
    }

    .board__keep {
      margin-left: 0;
      margin-top: 12px;
    }
  }
</style>
