---
/*
 * Section 5 — what it looks like in a practice.
 *
 * The doc's build note is the whole layout decision: this must read as a numbered
 * sequence, not five feature cards. Five cards in a grid say "here are five features";
 * a connected vertical stepper says "this happens, then this happens", which is the only
 * reading that makes step 3 land — a reader has to already believe the document was read
 * before "anything outside those rules gets held back" means anything.
 *
 * So it is one column with a line running down through the numbers, the same connected
 * stepper the homepage's How we work uses, turned vertical. It is an <ol>, so the order
 * is in the document and not only in the paint.
 *
 * Step 3 is the trust anchor and is marked in gold. brand-tokens.css reserves gold for
 * one meaning — what is waiting on a human — and this is the step where that happens.
 * It is the only gold on the page apart from the hero diagram, which marks the same
 * thing. Gold is never a CTA colour.
 *
 * The closing line is set as a pull quote but keeps its punctuation exactly as written.
 * The Stitch design wraps it in quotation marks and bolds its middle sentence; neither
 * is in the copy, so neither is here.
 */

const steps = [
  {
    n: "1",
    title: "They send it however they already send it",
    body: "A photo, an email attachment, a forwarded statement. You are not asking them to learn a portal or change a habit, because the ones who send things late are exactly the ones who will not.",
  },
  {
    n: "2",
    title: "It gets read and coded",
    body: "The figures come off the document and a category is applied, following whatever rules you have set. The original image stays attached to the entry, so anyone looking at it later can see the source without going to find it.",
  },
  {
    n: "3",
    title: "Anything outside those rules gets held back",
    body: "A blurred total, an unfamiliar vendor, an amount that does not sit right. Those stop and wait for a person instead of being pushed through. Your reviewer sees a short list of things needing a decision, not a full ledger to re-check.",
    held: true,
  },
  {
    n: "4",
    title: "What has not arrived is visible",
    body: "Without asking anyone. You can see what is outstanding for that client, and so can whoever is chasing it.",
  },
  {
    n: "5",
    title: "The chasing happens without someone remembering to do it",
    body: "A reminder goes out on schedule, in your firm's name, and stops when the document arrives.",
  },
];
---

<section class="practice">
  <div class="container">
    <div class="practice__head">
      <h2 class="practice__title">One client, one period, nobody chasing anything.</h2>
      <p class="practice__body">
        The clearest way to describe this is to walk through a month of one client's
        records, from the point they leave that client to the point your work begins.
      </p>
    </div>

    <ol class="practice__steps">
      {
        steps.map((step) => (
          <li class:list={["practice__step", { "practice__step--held": step.held }]}>
            <span class="practice__node" aria-hidden="true">{step.n}</span>
            <div class="practice__content">
              <h3 class="practice__step-title">{step.title}</h3>
              <p class="practice__step-body">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <blockquote class="practice__quote">
      <p>
        At the end of it, your person opens a review queue instead of an inbox. What they
        are doing is accounting. What they were doing before was sorting.
      </p>
    </blockquote>
  </div>
</section>

<style>
  .practice {
    background: #fff;
    padding-block: 104px;
  }

  .practice__title {
    font-size: var(--ark-h2);
    letter-spacing: -0.02em;
    max-width: 20ch;
  }

  .practice__body {
    margin-top: 26px;
    max-width: 66ch;
    font-size: 1.16rem;
    line-height: 1.7;
    color: #5b564e;
  }

  .practice__steps {
    margin-top: 56px;
    max-width: 940px;
  }

  .practice__step {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 26px;
    padding-bottom: 38px;
  }

  /* The connector. It runs from under each number down to the next one, so the sequence
   * is visible rather than having to be inferred from the numerals. The last step has
   * none, which is what ends the sequence. */
  .practice__step:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 25px;
    top: 52px;
    bottom: 10px;
    width: 2px;
    background: var(--ark-grey);
  }

  .practice__step:last-child {
    padding-bottom: 0;
  }

  .practice__node {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--ark-olive);
    color: var(--ark-on-dark);
    font-family: var(--ark-font-display);
    font-weight: 700;
    font-size: 1.28rem;
  }

  /* Gold marks the step where something waits for a person — the one meaning gold
   * carries in this system. */
  .practice__step--held .practice__node {
    background: var(--ark-gold-bg);
    color: var(--ark-gold-ink);
    box-shadow: inset 0 0 0 2px var(--ark-gold-border);
  }

  .practice__content {
    padding-top: 6px;
  }

  .practice__step-title {
    font-size: 1.34rem;
    line-height: 1.28;
    max-width: 30ch;
  }

  .practice__step-body {
    margin-top: 11px;
    max-width: 72ch;
    font-size: 1.03rem;
    line-height: 1.66;
    color: #5b564e;
  }

  .practice__quote {
    margin: 52px 0 0;
    background: var(--ark-green-soft);
    border-radius: var(--ark-radius);
    padding: 40px 46px;
  }

  .practice__quote p {
    font-family: var(--ark-font-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.44;
    color: var(--ark-olive);
    max-width: 44ch;
  }

  @media (max-width: 900px) {
    .practice {
      padding-block: 60px;
    }

    .practice__body {
      margin-top: 20px;
      font-size: 1.05rem;
    }

    .practice__steps {
      margin-top: 36px;
    }

    .practice__step {
      gap: 18px;
      padding-bottom: 30px;
    }

    .practice__node {
      width: 42px;
      height: 42px;
      font-size: 1.08rem;
    }

    .practice__step:not(:last-child)::before {
      left: 20px;
      top: 46px;
    }

    .practice__content {
      padding-top: 2px;
    }

    .practice__step-title {
      font-size: 1.14rem;
    }

    .practice__step-body {
      font-size: 0.99rem;
    }

    .practice__quote {
      margin-top: 36px;
      padding: 28px 24px;
    }

    .practice__quote p {
      font-size: 1.2rem;
    }
  }

  @media (max-width: 900px), (orientation: portrait) {
    .practice__title {
      text-align: center;
      margin-inline: auto;
    }
  }
</style>
