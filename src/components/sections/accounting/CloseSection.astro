---
import BookingButton from "../../common/BookingButton.astro";
import { SITE } from "../../../consts";

/*
 * Section 8 — the close.
 *
 * Set on the dark olive band, matching the homepage rather than the Stitch design,
 * which ends this page on stage-green. Two pages on one site should not end
 * differently, and the tagline in particular has one established treatment: display
 * face, on olive, below the CTA, as a sign-off and never as a heading. It appears twice
 * per page at most — here and in the footer.
 *
 * THE LINE UNDER THE CTA IS DELETED. The approved copy sets "Based in Metro Vancouver,
 * working remotely across Canada." here. Fredrick's instruction of Aug 25 2026 removes
 * that line and every line like it from the site, so the CTA is followed directly by
 * the tagline. It was removed from four other places at the same time — the homepage
 * close, the homepage founder strip, this page's hero trust line, and the FAQ question
 * that existed only to answer it. Do not restore it in one place alone.
 *
 * The heading names the gain, which is the discipline the homepage follows too: the
 * page opens and closes on the upside, and pain lives only in body copy where it does
 * recognition work.
 */
---

<section class="close on-dark">
  <div class="container close__inner">
    <h2 class="close__title">Pick the problem. We&rsquo;ll tell you if AI solves it.</h2>

    <p class="close__body">
      Twenty minutes. Bring whichever of these problems costs your practice most.
      We&rsquo;ll tell you whether AI solves it, what that would be worth, and whether
      it&rsquo;s worth building at all.
    </p>

    <div class="close__cta">
      <BookingButton location="acc-closing" variant="cream" block>
        Book 20 minutes
      </BookingButton>
    </div>

    <p class="close__tagline">{SITE.tagline}</p>
  </div>
</section>

<style>
  .close {
    background: var(--ark-olive);
    color: var(--ark-on-dark);
    padding-block: 120px;
  }

  .close__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .close__title {
    color: var(--ark-on-dark);
    font-size: 3.25rem;
    line-height: 1.08;
    letter-spacing: -0.026em;
    max-width: 20ch;
  }

  .close__body {
    margin-top: 26px;
    font-size: var(--ark-body-lg);
    line-height: var(--ark-lh-body);
    color: var(--ark-on-dark-muted);
    max-width: 58ch;
  }

  .close__cta {
    margin-top: 38px;
  }

  .close__tagline {
    margin-top: 60px;
    font-family: var(--ark-font-display);
    font-weight: 700;
    font-size: 2rem;
    letter-spacing: 0.005em;
    color: var(--ark-on-dark-eyebrow);
  }

  @media (max-width: 900px) {
    .close {
      padding-block: 62px;
    }

    .close__title {
      font-size: var(--ark-h2);
      line-height: var(--ark-lh-h2);
      max-width: 18ch;
    }

    .close__body {
      margin-top: 18px;
      max-width: 36ch;
    }

    .close__cta {
      margin-top: 28px;
      width: 100%;
    }

    .close__tagline {
      margin-top: 44px;
      font-size: 1.5rem;
    }
  }
</style>
