---
import BookingButton from "../../common/BookingButton.astro";
import PracticeBoardPanel from "./hero/PracticeBoardPanel.astro";

/*
 * Section 1 — the hero. Copy is verbatim from docs/accounting-page.md, with one
 * deletion recorded below.
 *
 * THE SUBHEAD IS SPLIT INTO TWO PARAGRAPHS, same words, same order, split at a sentence
 * boundary. This is the fix the homepage hero needed for the same reason: the approved
 * subhead is three sentences and the first one carries a five-item list, which on a
 * 390px screen is nine unbroken lines of lede and pushes the CTA under the fold. The
 * split costs nothing — a reader cannot tell — and it is what keeps the button visible
 * on the screen most of this page's traffic arrives on.
 *
 * THE TRUST LINE LOST ITS FIRST ITEM. Approved: "Metro Vancouver · Built for Canadian
 * practices · Rules you set, recorded as it goes". Fredrick's instruction of Aug 25 2026
 * removes the location line and everything like it from the site, so "Metro Vancouver"
 * is gone and the remaining two items are used as written. Do not restore it here
 * without restoring it in the four other places it was removed from.
 *
 * The illustration is hero/PracticeBoardPanel.astro. Its own header explains why it is
 * not the Stitch artwork.
 */

const trustItems = [
  "Built for Canadian practices",
  "Rules you set, recorded as it goes",
];
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow hero__eyebrow">For accounting and bookkeeping practices</p>

      <h1 class="hero__title">AI that works inside the practice you already have.</h1>

      <p class="hero__subhead">
        ArkSystems builds AI into the administrative work that surrounds professional
        work &mdash; onboarding, document collection, routine client questions, file
        status, deadline exposure.
      </p>

      <p class="hero__subhead hero__subhead--second">
        Your process doesn&rsquo;t change. The steps that never needed a qualified person
        stop waiting for one.
      </p>

      <div class="hero__cta">
        <BookingButton location="acc-hero" block>
          Book 20 minutes &mdash; see where AI fits your practice
        </BookingButton>
        <p class="hero__cta-note">
          Twenty minutes. Bring the task consuming the most qualified time in your firm.
        </p>
      </div>

      {/* A list, not a string with middots typed into it — a screen reader gets two
        * items rather than one run-on sentence, and the separator is drawn in CSS. */}
      <ul class="hero__trust">
        {trustItems.map((item) => <li class="hero__trust-item">{item}</li>)}
      </ul>
    </div>

    <div class="hero__visual">
      <PracticeBoardPanel />
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--ark-surface);
    padding-block: 60px 76px;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
    gap: 64px;
    align-items: center;
  }

  .hero__eyebrow {
    display: block;
    margin-bottom: 22px;
  }

  /* The measure sits on the element carrying the font-size, never on a wrapper — `ch`
   * resolves against the element's own font-size, so on a wrapper it counts 16px
   * characters and cramps a display heading to a third of its width. */
  .hero__title {
    font-size: var(--ark-h1);
    line-height: var(--ark-lh-h1);
    letter-spacing: -0.03em;
    max-width: 15ch;
  }

  .hero__subhead {
    margin-top: 24px;
    max-width: 56ch;
    font-size: var(--ark-body-lg);
    line-height: var(--ark-lh-body);
    color: var(--ark-body-ink);
  }

  .hero__subhead--second {
    margin-top: 14px;
  }

  .hero__cta {
    margin-top: 34px;
  }

  .hero__cta-note {
    margin-top: 14px;
    font-size: var(--ark-small);
    line-height: 1.55;
    color: var(--ark-muted);
    max-width: 48ch;
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    margin-top: 32px;
    padding-top: 22px;
    border-top: 1px solid var(--ark-hairline);
  }

  .hero__trust-item {
    display: flex;
    align-items: center;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--ark-muted);
  }

  .hero__trust-item + .hero__trust-item::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--ark-olive-2);
    margin-right: 18px;
    flex-shrink: 0;
  }

  .hero__visual {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 1100px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 44px;
    }

    /* The cap centres in the column rather than sitting against its left edge, which is
     * what the base rule's `justify-content: center` always intended — that only ever
     * centred the panel INSIDE this box, and stacked, the box itself was 520px hard left
     * in an 848px column. Measured at 1024 portrait: 88-608, off centre by 164.
     *
     * `width: 100%` is load-bearing beside the auto margins. An auto inline margin on a
     * grid item beats `justify-self: stretch`, so without it the box falls back to its
     * shrink-to-fit width instead of filling up to the cap. */
    .hero__visual {
      width: 100%;
      max-width: 520px;
      margin-inline: auto;
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-block: 40px 52px;
    }

    .hero__eyebrow {
      margin-bottom: 16px;
    }

    .hero__subhead {
      margin-top: 18px;
      max-width: 42ch;
    }

    .hero__cta {
      margin-top: 26px;
    }

    .hero__inner {
      gap: 32px;
    }

    .hero__visual {
      max-width: none;
    }
  }

  /* Phone and any portrait screen: the heading BLOCK centres, and the text inside the
   * body paragraphs stays left. Centred prose is harder to read, which matters more
   * here than usual given the plain-language rule — but a left-flush block under a
   * centred headline reads as a misalignment, so the box centres even though its text
   * does not. That is what base.css does for `.section__head .section__lede`, and all
   * four heroes now match it.
   *
   * The subhead and the CTA note were the ones missing it. Measured at 768: the headline
   * centred at 212-556 with both subhead paragraphs left-flush at 18-373 underneath, and
   * the trust line centred again below them. Centred, left, centred down one column. */
  @media (max-width: 900px), (orientation: portrait) {
    .hero__title,
    .hero__eyebrow {
      text-align: center;
      margin-inline: auto;
    }

    .hero__subhead,
    .hero__cta-note {
      margin-inline: auto;
    }

    /* The button is the one thing here that is not a block of text, so an auto margin
     * does nothing for it — its row already spans the column. It centres by flex.
     * Measured at 1024 portrait before this: a 391px button hard left at 88, under a
     * headline and two paragraphs that were all centred.
     *
     * This sits in the PORTRAIT query rather than with the 1100 stack above, and the
     * difference is real: between 901 and 1100 in landscape the hero stacks but nothing
     * centres, and a centred button under left-aligned copy would be the same fault this
     * rule exists to fix, pointing the other way. Below 900 the button is full width
     * anyway and this changes nothing.
     *
     * Column flex, not `justify-content: center` — this wrapper holds the button AND the
     * note beneath it, unlike the homepage's, where the note is a sibling. A row put them
     * side by side: measured at 1024 portrait, the note landed at 541-875, 196px right of
     * centre, beside a button still hard left. */
    .hero__cta {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero__trust {
      justify-content: center;
    }
  }

  /* Two items will not sit on one 390px line, so they stack — and once they stack the
   * drawn separator leads the second line and reads as a bullet point rather than as a
   * divider between two halves of one line. It is removed at this width and the items
   * centre as two short lines. */
  @media (max-width: 560px) {
    .hero__trust {
      flex-direction: column;
      gap: 6px;
    }

    .hero__trust-item + .hero__trust-item::before {
      content: none;
    }
  }
</style>
