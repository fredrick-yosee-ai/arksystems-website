---
import { Image } from "astro:assets";
import fredPortrait from "../../../../assets/fred.jpg";

/*
 * Section 7 — who you're working with. The block that closes warm traffic, and the one
 * place the founder is named.
 *
 * Voice: the page speaks as "we" throughout. This section is written *about* Fredrick,
 * not by him, so the page reads as a company with a founder rather than a person with
 * a website. Do not let this drift into first person.
 *
 * Every claim here is unarguable and needs no verification: years, two named products
 * founded and shipped, location. Nothing states or implies a client engagement.
 */

const chips = [
  "15+ years engineering",
  "Two products founded and shipped",
  "Metro Vancouver",
  "Founder-led delivery",
];
---

<section class="who">
  <div class="container who__inner">
    {/* Square source, cropped to a circle — so the intrinsic ratio must be 1:1 or the
        crop pulls off-centre. */}
    <Image
      src={fredPortrait}
      alt="Fredrick, founder of ArkSystems"
      widths={[330, 660]}
      sizes="(max-width: 900px) 200px, 330px"
      class="who__portrait"
    />

    <div>
      <p class="eyebrow who__eyebrow">Who you&rsquo;re working with</p>

      <h2 class="who__title">You work directly with the people who build your system.</h2>

      <p class="who__body">
        ArkSystems is led by its founder, Fredrick, who spent more than fifteen years in
        software engineering, solution architecture, systems integration and cloud
        infrastructure, and who founded and shipped two technology products, FoodyGuru
        and YoseeAI.
      </p>

      <p class="who__body">
        That matters to you in two ways. You deal directly with the people building the
        thing &mdash; no account manager, and no junior consultant taking over once the
        work starts. And we&rsquo;ve had to care about the parts that usually get
        skipped: what it costs to run, whether it stays up, and whether anyone actually
        uses it.
      </p>

      <p class="who__body who__body--plain">
        Based in Metro Vancouver, working remotely across Canada.
      </p>

      <ul class="who__chips">
        {chips.map((chip) => <li class="who__chip">{chip}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .who {
    background: #fff;
    padding-block: 96px;
  }

  .who__inner {
    display: grid;
    grid-template-columns: 330px minmax(0, 1fr);
    gap: 72px;
    align-items: start;
  }

  .who__portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    /* Sits slightly high in the frame so the crop keeps the face centred rather than
     * cutting the top of the head. */
    object-position: 50% 22%;
    border-radius: 50%;
    display: block;
  }

  .who__eyebrow {
    display: block;
    margin-bottom: 22px;
  }

  .who__title {
    font-size: 2.5rem;
    max-width: 20ch;
    letter-spacing: -0.015em;
  }

  .who__body {
    margin-top: 18px;
    font-size: 1.08rem;
    line-height: 1.68;
    color: #4a463f;
    max-width: 68ch;
  }

  .who__title + .who__body {
    margin-top: 26px;
  }

  .who__body--plain {
    max-width: none;
  }

  .who__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .who__chip {
    font-size: 0.86rem;
    font-weight: 600;
    background: var(--ark-cream);
    border: 1px solid var(--ark-grey);
    border-radius: var(--ark-radius-pill);
    padding: 8px 16px;
    color: var(--ark-olive);
  }

  /* Phone and any portrait screen: the portrait leads, centred, with the eyebrow and
   * heading centred under it. The body paragraphs stay left-aligned — they are long,
   * and centred prose is harder to read, which matters more than usual for a page
   * written for readers whose first language may not be English. */
  @media (max-width: 900px), (orientation: portrait) {
    .who__inner {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 26px;
    }

    .who__portrait {
      width: 200px;
    }

    .who__eyebrow,
    .who__title {
      text-align: center;
    }

    .who__title {
      max-width: 24ch;
      margin-inline: auto;
    }

    .who__body {
      max-width: 62ch;
      margin-inline: auto;
    }

    .who__chips {
      justify-content: center;
    }
  }

  @media (max-width: 900px) {
    .who {
      padding-block: 56px;
    }

    .who__title {
      font-size: var(--ark-h2);
    }

    .who__body {
      font-size: 1rem;
    }
  }
</style>
