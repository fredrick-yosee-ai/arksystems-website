---
/*
 * Panel 01 — the receipt as photographed.
 *
 * It must stay large enough to actually read. An earlier build had it at 122px wide
 * with 6px type, which defeats the whole point of showing a real receipt. The type
 * sizes below are absolute pixel values from the approved mockup for that reason —
 * they do not scale down with the rest of the page.
 *
 * The whole thing is one `role="img"` with a written summary. Left as plain markup a
 * screen reader would read roughly thirty loose fragments — "COPY PAPER 8.5X11",
 * "48.90" — in drawing order, which communicates nothing. The panel's heading and
 * body copy above it carry the actual argument.
 */

const lines = [
  ["COPY PAPER 8.5X11", "48.90"],
  ["SHOP RAGS 3PK", "27.75"],
  ["SAFETY GLOVES L", "19.98"],
  ["NITRILE GLOVES BX", "34.50"],
  ["SHOP TOWEL ROLL", "52.15"],
  ["DRAIN CLEANER 4L", "53.48"],
];
---

<div
  class="receipt-stage"
  role="img"
  aria-label="A photograph of a paper till receipt from Westside Supply Co. in Surrey, BC, dated 14 September 2026. It lists six items, a subtotal of 236.76, GST of 11.84 and a total of $248.60 paid by debit."
>
  <div class="receipt-stage__sheen" aria-hidden="true"></div>
  <div class="receipt-stage__shadow" aria-hidden="true"></div>

  <div class="receipt" aria-hidden="true">
    <div class="receipt__name">WESTSIDE SUPPLY CO.</div>
    <div class="receipt__meta">1240 Industrial Ave, Surrey BC</div>
    <div class="receipt__meta">GST# 84212 3344 RT0001</div>
    <div class="receipt__meta receipt__meta--date">14 SEP 2026&nbsp;&nbsp;11:04</div>

    <div class="receipt__rule"></div>

    {
      lines.map(([item, amount]) => (
        <div class="receipt__line">
          <span>{item}</span>
          <span class="num">{amount}</span>
        </div>
      ))
    }

    <div class="receipt__rule receipt__rule--tight"></div>

    <div class="receipt__line receipt__line--total-row">
      <span>SUBTOTAL</span><span class="num">236.76</span>
    </div>
    <div class="receipt__line receipt__line--total-row">
      <span>GST 5%</span><span class="num">11.84</span>
    </div>
    <div class="receipt__line receipt__total">
      <span>TOTAL</span><span class="num">$248.60</span>
    </div>

    <div class="receipt__payment"><span>DEBIT</span><span>APPROVED</span></div>

    <div class="receipt__barcode"></div>
    <div class="receipt__thanks">THANK YOU</div>
  </div>
</div>

<style>
  .receipt-stage {
    position: relative;
    height: 560px;
    border-radius: var(--ark-radius);
    background: radial-gradient(120% 96% at 30% 6%, #55614a 0%, #36412e 54%, #1f271b 100%);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .receipt-stage__sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      155deg,
      rgba(255, 255, 255, 0.1) 0%,
      rgba(255, 255, 255, 0) 38%,
      rgba(0, 0, 0, 0.36) 100%
    );
  }

  .receipt-stage__shadow {
    position: absolute;
    left: -40px;
    right: -40px;
    bottom: 26px;
    height: 18px;
    background: rgba(0, 0, 0, 0.42);
    filter: blur(15px);
    transform: rotate(-2.2deg);
  }

  .receipt {
    position: relative;
    width: 280px;
    background: #fdfcf7;
    color: #3c382f;
    transform: rotate(-2.2deg);
    box-shadow:
      0 26px 54px rgba(0, 0, 0, 0.55),
      0 4px 12px rgba(0, 0, 0, 0.34);
    padding: 20px 20px 14px;
    /* The torn-off bottom edge. */
    clip-path: polygon(
      0 0, 100% 0, 100% 98%,
      95% 100%, 90% 98%, 85% 100%, 80% 98%, 75% 100%, 70% 98%, 65% 100%,
      60% 98%, 55% 100%, 50% 98%, 45% 100%, 40% 98%, 35% 100%, 30% 98%,
      25% 100%, 20% 98%, 15% 100%, 10% 98%, 5% 100%, 0 98%
    );
  }

  .num {
    font-variant-numeric: tabular-nums;
  }

  .receipt__name {
    text-align: center;
    font-size: 17.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #2e2b24;
  }

  .receipt__meta {
    text-align: center;
    font-size: 12.6px;
    color: #7d786c;
  }

  .receipt__name + .receipt__meta {
    margin-top: 5px;
  }

  .receipt__meta--date {
    margin-top: 3px;
  }

  .receipt__rule {
    border-top: 1px dashed #c2bcab;
    margin: 12px 0 9px;
  }

  .receipt__rule--tight {
    margin: 9px 0;
  }

  .receipt__line {
    display: flex;
    justify-content: space-between;
    font-size: 14.6px;
    line-height: 1.8;
  }

  .receipt__line--total-row {
    line-height: 1.75;
  }

  .receipt__total {
    font-size: 18.6px;
    font-weight: 700;
    color: #2e2b24;
    line-height: 1.75;
  }

  .receipt__payment {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: #7d786c;
    margin-top: 6px;
  }

  .receipt__barcode {
    height: 27px;
    width: 78%;
    margin: 14px auto 5px;
    background: repeating-linear-gradient(
      90deg,
      #2e2b24 0 4px,
      transparent 4px 8px,
      #2e2b24 8px 10px,
      transparent 10px 16px
    );
  }

  .receipt__thanks {
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.22em;
    color: #7d786c;
  }

  @media (max-width: 900px) {
    /* The receipt's type is fixed in pixels so it stays readable, which makes the
     * receipt itself roughly 500px tall at every width. The stage therefore has to fit
     * the receipt rather than the other way round — a fixed height here clipped the
     * torn bottom edge off. */
    .receipt-stage {
      height: auto;
      padding-block: 34px;
    }
  }
</style>
