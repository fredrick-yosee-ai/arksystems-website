---
/*
 * The month-end payoff strip. Not in the written spec, but present in the approved
 * mockup, and it does real work: it moves the demonstration from "one receipt" to
 * "your month", which is what section 3 is for.
 *
 * The donut is decorative — the same three categories are listed beside it in text —
 * so it is aria-hidden and the legend carries the meaning.
 */

const legend = [
  { label: "Supplies", colour: "var(--ark-on-dark-eyebrow)" },
  { label: "Materials", colour: "var(--ark-olive-2)" },
  { label: "Fuel", colour: "var(--ark-gold)" },
];

const figures = [
  { label: "Still returnable", value: "2 items" },
  { label: "GST this month", value: "$184.20" },
];
---

<div class="month-end">
  <div>
    <h3 class="month-end__title">And at month-end, it is already done.</h3>
    <p class="month-end__body">
      Where the money went, what is still returnable, and the tax split out ready for
      your bookkeeper.
    </p>
  </div>

  <div class="month-end__chart">
    <svg width="96" height="96" viewBox="0 0 42 42" aria-hidden="true" class="month-end__donut">
      <circle cx="21" cy="21" r="15.9" fill="none" stroke="rgba(255,255,255,.14)" stroke-width="7"></circle>
      <circle cx="21" cy="21" r="15.9" fill="none" stroke="#b9c88f" stroke-width="7" stroke-dasharray="38 62" stroke-dashoffset="25"></circle>
      <circle cx="21" cy="21" r="15.9" fill="none" stroke="#7A8C3A" stroke-width="7" stroke-dasharray="27 73" stroke-dashoffset="-13"></circle>
      <circle cx="21" cy="21" r="15.9" fill="none" stroke="#B88922" stroke-width="7" stroke-dasharray="18 82" stroke-dashoffset="-40"></circle>
    </svg>

    <ul class="month-end__legend">
      {
        legend.map((entry) => (
          <li>
            <span class="month-end__swatch" style={`background:${entry.colour}`} aria-hidden="true" />
            {entry.label}
          </li>
        ))
      }
    </ul>
  </div>

  <ul class="month-end__figures">
    {
      figures.map((figure) => (
        <li class="month-end__figure">
          <span class="month-end__figure-label">{figure.label}</span>
          <span class="month-end__figure-value">{figure.value}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .month-end {
    margin-top: 34px;
    background: rgba(0, 0, 0, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--ark-radius);
    padding: 34px 36px;
    display: grid;
    grid-template-columns: 1.15fr 1fr 1fr;
    gap: 44px;
    align-items: center;
  }

  .month-end__title {
    color: var(--ark-on-dark);
    font-size: 1.28rem;
    line-height: 1.28;
  }

  .month-end__body {
    margin-top: 10px;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ark-on-dark-muted);
  }

  .month-end__chart {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .month-end__donut {
    flex-shrink: 0;
  }

  .month-end__legend {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .month-end__legend li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.86rem;
    color: #e4ead9;
  }

  .month-end__swatch {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .month-end__figures {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .month-end__figure {
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--ark-radius-sm);
    padding: 14px 16px;
  }

  .month-end__figure-label {
    display: block;
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ark-on-dark-eyebrow);
    font-weight: 700;
  }

  .month-end__figure-value {
    display: block;
    font-family: var(--ark-font-display);
    font-size: 1.5rem;
    color: var(--ark-on-dark);
    margin-top: 4px;
  }

  @media (max-width: 1100px) {
    .month-end {
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }
  }

  @media (max-width: 700px) {
    .month-end {
      grid-template-columns: minmax(0, 1fr);
      padding: 24px 22px;
      gap: 24px;
    }
  }
</style>
