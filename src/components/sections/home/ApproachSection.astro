---
import Container from "../../common/Container.astro";

const steps = [
    {
        number: "01",
        title: "Find the leak",
        body:
            "We examine one important workflow and identify where time, capacity, service or money may be getting lost.",
    },
    {
        number: "02",
        title: "Value the leak",
        body:
            "Using your inputs and clearly stated assumptions, we estimate the potential operational and financial value of improving it.",
    },
    {
        number: "03",
        title: "Find the simplest justified solution",
        body: "The right answer may be:",
        list: [
            "A clearer process",
            "Better use of existing software",
            "A direct integration",
            "Targeted automation",
            "Practical AI",
            "A controlled intelligent workflow",
            "No immediate technology change",
        ],
    },
    {
        number: "04",
        title: "Implement only when the business case makes sense",
        body:
            "When the opportunity is valuable, feasible and appropriately controlled, ArkSystems can propose and deliver a focused implementation.",
    },
];
---

<section class="approach-section">
    <Container>
        <div class="approach-section__content">
            <h2 class="approach-section__title">
                Start with the workflow. Prove the value. Then decide.
            </h2>

            <div class="approach-section__grid">
                {
                    steps.map((step) => (
                            <article class="approach-card">
                                <p class="approach-card__number">{step.number}</p>

                                <h3>{step.title}</h3>

                                <p>{step.body}</p>

                                {
                                    step.list && (
                                                <ul>
                                                    {step.list.map((item) => (
                                                            <li>{item}</li>
                                                    ))}
                                                </ul>
                                    )
                                }
                            </article>
                    ))
                }
            </div>
        </div>
    </Container>
</section>

<style>
    .approach-section {
        padding-block: clamp(5rem, 8vw, 7rem);
        background: #fbf5ec;
        border-top: 1px solid rgb(79 84 64 / 5%);
    }

    .approach-section__content {
        max-width: 69rem;
        margin-inline: auto;
    }

    .approach-section__title {
        max-width: 42rem;
        margin: 0;
        font-size: clamp(2.25rem, 3.5vw, 3rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: var(--color-neutral-900);
    }

    .approach-section__grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2rem 2.6rem;
        margin-top: 3.5rem;
    }

    .approach-card {
        padding: 1.8rem 1.9rem;
        border: 1px solid rgb(79 84 64 / 13%);
        border-radius: 0.55rem;
        background: rgb(255 253 248 / 74%);
        box-shadow: 0 2px 5px rgb(58 63 46 / 3%);
    }

    .approach-card__number {
        margin: 0 0 1.1rem;
        font-size: 1rem;
        font-weight: var(--font-weight-bold);
        color: var(--color-brand-800);
    }

    .approach-card h3 {
        margin: 0 0 1rem;
        font-family: var(--font-body);
        font-size: 1rem;
        font-weight: var(--font-weight-medium);
        line-height: 1.4;
        color: var(--color-neutral-900);
    }

    .approach-card p {
        margin: 0;
        font-size: 0.94rem;
        line-height: 1.65;
        color: var(--color-neutral-700);
    }

    .approach-card ul {
        display: grid;
        gap: 0.55rem;
        margin: 0.8rem 0 0;
        padding: 0;
        list-style: none;
    }

    .approach-card li {
        position: relative;
        padding-left: 1rem;
        font-size: 0.92rem;
        line-height: 1.5;
        color: var(--color-neutral-700);
    }

    .approach-card li::before {
        content: "›";
        position: absolute;
        left: 0;
        color: var(--color-brand-700);
    }

    @media (max-width: 62rem) {
        .approach-section__content {
            max-width: 100%;
        }

        .approach-section__grid {
            gap: 1.5rem;
        }
    }

    @media (max-width: 44rem) {
        .approach-section {
            padding-block: 4rem;
        }

        .approach-section__title {
            font-size: clamp(2rem, 9vw, 2.55rem);
        }

        .approach-section__grid {
            grid-template-columns: 1fr;
            margin-top: 2.5rem;
        }

        .approach-card {
            padding: 1.4rem;
        }
    }
</style>