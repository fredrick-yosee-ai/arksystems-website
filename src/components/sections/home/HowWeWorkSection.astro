---
/*
 * Section 8 — how we work. Four steps, then the pull quote.
 *
 * Rebuilt as a connected stepper. The four steps were previously four loose columns
 * with a large numeral floating above each; on desktop that read as a list rather than
 * a sequence, and stacked on a phone it fell apart completely — four disconnected
 * blocks with nothing showing that step 2 follows step 1.
 *
 * Now each step is a node on a line: the line runs left-to-right between the numbers on
 * desktop and top-to-bottom beside them on a phone, so the order is visible at both
 * sizes instead of having to be inferred from the numerals.
 *
 * The pull quote is the piece that does the most work in this section: it mentions
 * money in a direction that protects the reader rather than asking of them, which
 * lowers defences instead of raising them.
 */

const steps = [
  {
    n: "01",
    title: "Find where it's going",
    body: "We look at one job and find where the hours and the money are actually going.",
  },
  {
    n: "02",
    title: "Put a number on it",
    body: "Using your figures, and assumptions we say out loud, we work out what fixing it would be worth.",
  },
  {
    n: "03",
    title: "Find the cheapest fix that works",
    body: "Sometimes that's using something you already pay for properly. Sometimes it's changing how the work moves. Sometimes it's AI. Sometimes it's nothing, yet.",
  },
  {
    n: "04",
    title: "Build it only if it is worth it",
    body: "If it is worth doing and we can do it safely, we build it and hand it back working.",
  },
];
---

<section class="how">
  <div class="container">
    <p class="eyebrow how__eyebrow">Practical enough to recommend less technology</p>

    <h2 class="how__title">Start with one job. Prove it is worth fixing. Then decide.</h2>

    <ol class="how__steps">
      {
        steps.map((step) => (
          <li class="how__step">
            <span class="how__node" aria-hidden="true">
              {step.n}
            </span>
            <div class="how__content">
              <h3 class="how__step-title">{step.title}</h3>
              <p class="how__step-body">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <blockquote class="how__quote">
      <p>
        We would rather tell you not to buy something than sell you something that is
        not worth the money.
      </p>
    </blockquote>
  </div>
</section>

<style>
  .how {
    padding-block: 96px;
  }

  .how__eyebrow {
    display: block;
    margin-bottom: 22px;
  }

  .how__title {
    font-size: 2.7rem;
    letter-spacing: -0.018em;
    max-width: 26ch;
  }

  .how__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    margin-top: 56px;
  }

  .how__step {
    position: relative;
  }

  .how__node {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--ark-green-soft);
    color: var(--ark-olive);
    font-family: var(--ark-font-display);
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  /* The connector. Horizontal on desktop, running from each node across the grid gap
   * into the next column. The last step has none, which is what ends the sequence. */
  .how__step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 23px;
    left: 58px;
    right: -32px;
    height: 1px;
    background: var(--ark-grey);
  }

  .how__content {
    margin-top: 20px;
  }

  .how__step-title {
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .how__step-body {
    margin-top: 10px;
    font-size: 0.98rem;
    line-height: 1.58;
    color: #5b564e;
  }

  .how__quote {
    margin: 60px 0 0;
    border-top: 1px solid var(--ark-grey);
    padding-top: 38px;
  }

  .how__quote p {
    font-family: var(--ark-font-display);
    font-size: 1.8rem;
    line-height: 1.34;
    color: var(--ark-olive);
    max-width: 44ch;
  }

  @media (max-width: 1100px) {
    .how__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 34px 32px;
    }

    /* With two per row, the connector must not run off the end of a row. */
    .how__step:nth-child(2n)::after {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .how {
      padding-block: 56px;
    }

    .how__title {
      font-size: var(--ark-h2);
    }

    .how__steps {
      margin-top: 36px;
    }

    .how__quote {
      margin-top: 40px;
      padding-top: 28px;
    }

    .how__quote p {
      font-size: 1.3rem;
    }
  }

  /* Phone: the same stepper turned vertical. Number on the left, content beside it, and
   * the line running down between nodes, so the four steps read as one sequence
   * instead of four unrelated blocks. */
  @media (max-width: 700px) {
    .how__steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .how__step {
      display: flex;
      align-items: flex-start;
      gap: 18px;
      padding-bottom: 30px;
    }

    .how__step:last-child {
      padding-bottom: 0;
    }

    .how__node {
      width: 42px;
      height: 42px;
      font-size: 0.96rem;
    }

    /* Vertical connector, from under this node to the top of the next. Re-enabled for
     * the even-numbered steps that the two-column rule above switched off. */
    .how__step:not(:last-child)::after {
      display: block;
      top: 50px;
      bottom: 6px;
      left: 20px;
      right: auto;
      width: 1px;
      height: auto;
    }

    .how__content {
      margin-top: 0;
      padding-top: 3px;
    }
  }

  /* Phone and any portrait screen: centre the heading and the pull quote. The steps
   * keep their left edge — they are a sequence, and the connector reads as a spine. */
  @media (max-width: 900px), (orientation: portrait) {
    .how__eyebrow,
    .how__title {
      text-align: center;
    }

    .how__title {
      margin-inline: auto;
    }

    .how__quote p {
      text-align: center;
      margin-inline: auto;
    }
  }
</style>
