---
import BookingButton from "../../common/BookingButton.astro";
import { inlineSvg } from "../../../lib/svg";
import heroDesktopRaw from "../../../../assets/hero-desktop.svg?raw";
import heroMobileRaw from "../../../../assets/hero-mobile.svg?raw";

/*
 * Section 1 — Hero. Copy is the approved file, verbatim.
 *
 * The approved subhead is one paragraph of three sentences. It is set here as two,
 * split at a sentence boundary and in the written order: the first two sentences state
 * what is missing, the third states what we do about it. No word changes, and the
 * reading order is identical at every breakpoint — the split exists so the phone gets
 * a paragraph break instead of nine unbroken lines, which is what pushes the CTA below
 * the fold.
 *
 * Measured at 390px, the button now sits around 550px down against a fold near 780px,
 * so the one thing this page exists to do is visible without a scroll.
 *
 * The illustration is unchanged from the previous build — Fredrick's instruction. It
 * already carries its own near-white rounded card with a border, so dropping it into a
 * stage panel produces the panel-holding-a-floating-card composition the rest of the
 * page uses, with no edit to the artwork.
 */

const heroDesc =
  "Work arrives all day from the everyday tools a business already uses — messaging, " +
  "email, payments, accounting, scheduling and storage apps — and all of it converges " +
  "on a single assistant marked with the ArkSystems logo, on duty around the clock. " +
  "What comes back is finished: receipts filed and coded, invoices sent on time and " +
  "chased when they are late, month-end already closed. Two items are flagged in gold " +
  "as needing the owner, and nothing else is. The closing line reads: that is your " +
  "evenings back.";

const heroDesktop = inlineSvg(heroDesktopRaw, {
  prefix: "hero-d",
  title: "How work reaches the assistant, and what comes back done",
  desc: heroDesc,
  className: "hero__art hero__art--desktop",
});

const heroMobile = inlineSvg(heroMobileRaw, {
  prefix: "hero-m",
  title: "How work reaches the assistant, and what comes back done",
  desc: heroDesc,
  className: "hero__art hero__art--mobile",
});
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">
        <span class="eyebrow">Your AI Partner for Smarter Growth</span>
        <span class="hero__rule" aria-hidden="true"></span>
      </p>

      <h1 class="hero__title">Find where AI can create real value in your business.</h1>

      <p class="hero__subhead">
        You&rsquo;ve already decided AI matters. The harder question is where it
        produces a measurable return in your own operation, and what that return is
        worth.
      </p>

      <p class="hero__subhead hero__subhead--offer">
        We assess how your business runs, quantify the opportunity, and build the one
        system that earns its cost.
      </p>

      <div class="hero__cta">
        <BookingButton location="hero" block>
          Book 20 minutes &mdash; see where AI fits
        </BookingButton>
      </div>

      <p class="hero__cta-note">
        Twenty minutes. Bring the part of the business you&rsquo;d most like to improve.
      </p>

      <p class="hero__trust">Practical &middot; Measurable &middot; Business-first</p>
    </div>

    <figure class="hero__figure">
      {/*
        Both variants are in the document and swapped by CSS, which is why their ids are
        namespaced — see src/lib/svg.ts. The hidden one is `display: none`, so it is out
        of the accessibility tree and never announced twice.
      */}
      <div class="hero__stage">
        <Fragment set:html={heroDesktop} />
        <Fragment set:html={heroMobile} />
      </div>
      <figcaption class="hero__caption">Everyday tools shown for illustration.</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    background: var(--ark-surface);
    padding-block: 72px 96px;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--ark-grid-gutter);
    align-items: center;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
  }

  .hero__rule {
    height: 1px;
    width: 44px;
    background: var(--ark-terracotta);
    opacity: 0.55;
  }

  .hero__title {
    font-size: var(--ark-h1);
    line-height: var(--ark-lh-h1);
    letter-spacing: -0.03em;
    max-width: 15ch;
  }

  .hero__subhead {
    margin-top: 24px;
    font-size: var(--ark-body-lg);
    line-height: var(--ark-lh-body);
    color: var(--ark-body-ink);
    max-width: 46ch;
  }

  /* The sentence that says what we actually do carries slightly more weight than the
   * two that set it up. Same size, darker ink — enough to be read first on a skim. */
  .hero__subhead--offer {
    margin-top: 14px;
    color: var(--ark-ink);
  }

  .hero__cta {
    margin-top: 32px;
  }

  .hero__cta-note {
    margin-top: 16px;
    font-size: var(--ark-small);
    line-height: 1.5;
    color: var(--ark-body-ink);
    max-width: 46ch;
  }

  .hero__trust {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--ark-hairline);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ark-body-ink);
    max-width: 46ch;
  }

  .hero__figure {
    margin: 0;
  }

  .hero__stage {
    background: var(--ark-stage-green);
    border-radius: var(--ark-radius-panel);
    padding: 28px;
  }

  .hero__caption {
    margin-top: 12px;
    text-align: right;
    font-size: var(--ark-small);
    color: var(--ark-body-ink);
    opacity: 0.85;
  }

  /* The intrinsic width/height are stripped in inlineSvg, so these govern the size.
   * The artwork brings its own card and border, so inside the stage panel it reads as
   * the floating layer without any wrapper of its own. */
  :global(.hero__art) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
    box-shadow: var(--ark-floating);
  }

  :global(.hero__art--mobile) {
    display: none;
  }

  /* Phone and any portrait screen: centre the heading block. The body paragraphs keep
   * their left edge — centred prose is harder to read, which matters more than usual on
   * a page written for readers whose first language may not be English. */
  @media (max-width: 900px), (orientation: portrait) {
    .hero__eyebrow {
      justify-content: center;
    }

    .hero__title,
    .hero__trust {
      text-align: center;
    }

    .hero__subhead,
    .hero__cta-note,
    .hero__trust {
      margin-inline: auto;
    }
  }

  /* The phone illustration is deliberately compact. An earlier version was 1418px tall,
   * which put two full screens of artwork above the first sentence. Do not restore
   * detail here. */
  @media (max-width: 900px) {
    .hero {
      padding-block: 28px 44px;
    }

    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }

    /* Copy first, illustration after the CTA. */
    .hero__figure {
      order: 2;
    }

    .hero__eyebrow {
      margin-bottom: 16px;
    }

    .hero__title {
      max-width: 16ch;
    }

    .hero__subhead {
      margin-top: 18px;
      max-width: 40ch;
    }

    .hero__cta {
      margin-top: 24px;
    }

    .hero__stage {
      padding: 16px;
      border-radius: 20px;
    }

    :global(.hero__art--desktop) {
      display: none;
    }

    :global(.hero__art--mobile) {
      display: block;
      width: min(100%, 354px);
      margin-inline: auto;
      border-radius: 16px;
    }

    .hero__caption {
      text-align: center;
    }
  }
</style>
