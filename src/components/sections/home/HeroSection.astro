---
import Container from "../../common/Container.astro";
import Button from "../../common/Button.astro";
import HeroWorkflowGraphic from "./HeroWorkflowGraphic.astro";
import HeroValueStrip from "./HeroValueStrip.astro";
---

<section class="hero">
    <Container>
        <div class="hero__main">
            <div class="hero__content">
                <p class="eyebrow">Your AI Partner for Smarter Growth</p>

                <h1>Find where AI can create real value in your business.</h1>

                <div class="hero__accent" aria-hidden="true"></div>

                <p class="hero__description">
                    We help accounting firms and other businesses find workflow
                    leaks, improve what matters, and implement practical AI and
                    automation where it makes business sense.
                </p>

                <Button href="/contact" class="hero__cta">
                    <span>Book an AI Opportunity Call</span>
                    <span aria-hidden="true">→</span>
                </Button>

                <p class="hero__assurance">
                    <span class="hero__assurance-icon" aria-hidden="true">✓</span>
                    Practical. Measurable. Business-first.
                </p>
            </div>

            <div class="hero__visual">
                <HeroWorkflowGraphic />
            </div>
        </div>

        <HeroValueStrip />
    </Container>
</section>

<style>
    .hero {
        position: relative;
        overflow: hidden;
        padding-block: clamp(4rem, 7vw, 7rem) var(--space-10);
        background:
                radial-gradient(
                        circle at 70% 30%,
                        rgb(158 159 126 / 16%),
                        transparent 34rem
                ),
                #fbf7f0;
    }

    .hero__main {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(32rem, 1.2fr);
        align-items: center;
        gap: clamp(var(--space-10), 5vw, var(--space-20));
    }

    .hero__content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .hero__content h1 {
        max-width: 10ch;
        margin-top: var(--space-6);
        font-size: clamp(3rem, 5vw, 5rem);
        line-height: 1.08;
    }

    .hero__accent {
        width: 3.5rem;
        height: 0.2rem;
        margin-block: var(--space-8);
        background: #c98b1f;
    }

    .hero__description {
        max-width: 34rem;
        font-size: var(--font-size-lg);
        color: var(--color-neutral-700);
    }

    .hero__cta {
        margin-top: var(--space-8);
        min-height: 3.75rem;
        padding-inline: var(--space-8);
        border-radius: var(--radius-md);
    }

    .hero__assurance {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        margin-top: var(--space-8);
        color: var(--color-neutral-700);
    }

    .hero__assurance-icon {
        display: inline-grid;
        place-items: center;
        width: 1.5rem;
        height: 1.5rem;
        border: 2px solid var(--color-brand-700);
        border-radius: 50%;
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-bold);
        color: var(--color-brand-700);
    }

    .hero__visual {
        min-width: 0;
    }

    @media (max-width: 68rem) {
        .hero__main {
            grid-template-columns: 1fr;
        }

        .hero__content h1 {
            max-width: 14ch;
        }

        .hero__visual {
            margin-top: var(--space-4);
        }
    }

    @media (max-width: 40rem) {
        .hero {
            padding-top: var(--space-16);
        }

        .hero__content h1 {
            font-size: clamp(2.5rem, 12vw, 3.75rem);
        }

        .hero__description {
            font-size: var(--font-size-base);
        }

        .hero__cta {
            width: 100%;
        }
    }
</style>