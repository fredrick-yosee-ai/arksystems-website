---
import Button from "../../common/Button.astro";
import HeroWorkflowGraphic from "./HeroWorkflowGraphic.astro";
import HeroValueStrip from "./HeroValueStrip.astro";
---

<section class="hero">
    <div class="hero__container">
        <div class="hero__main">
            <div class="hero__content">
                <p class="hero__eyebrow">
                    Your AI Partner for Smarter Growth
                </p>

                <h1 class="hero__title">
                    Find where AI can create real value in your business.
                </h1>

                <div class="hero__accent" aria-hidden="true"></div>

                <p class="hero__description">
                    We help accounting firms and other businesses find workflow leaks,
                    improve what matters, and implement practical AI and automation
                    where it makes business sense.
                </p>

                <div class="hero__actions">
                    <Button href="/contact" class="hero__cta">
                        <span>Book an AI Opportunity Call</span>
                        <span class="hero__cta-arrow" aria-hidden="true">→</span>
                    </Button>
                </div>

                <div class="hero__assurance">
                    <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            class="hero__assurance-icon"
                    >
                        <path d="M12 3 20 6v6c0 5-3.4 8-8 10-4.6-2-8-5-8-10V6l8-3Z" />
                        <path d="m8.5 12 2.2 2.2 4.8-5" />
                    </svg>

                    <span>Practical. Measurable. Business-first.</span>
                </div>
            </div>

            <div class="hero__visual">
                <HeroWorkflowGraphic />
            </div>
        </div>

        <div class="hero__value-strip">
            <HeroValueStrip />
        </div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        overflow: clip;
        background:
                radial-gradient(
                        circle at 70% 32%,
                        rgb(158 159 126 / 12%),
                        transparent 34rem
                ),
                #fbf7f0;
    }

    .hero__container {
        width: min(
                calc(100% - 5rem),
                78rem
        );
        margin-inline: auto;
        padding-block: clamp(4rem, 6vw, 6rem) var(--space-8);
    }
    .hero__main {
        display: grid;
        grid-template-columns:
			minmax(25rem, 0.82fr)
			minmax(0, 1.18fr);
        align-items: center;
        gap: clamp(3rem, 5vw, 6rem);
    }

    .hero__content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        min-width: 0;
    }

    .hero__eyebrow {
        margin: 0 0 var(--space-7, 1.75rem);
        font-size: 0.78rem;
        font-weight: var(--font-weight-bold);
        letter-spacing: 0.19em;
        text-transform: uppercase;
        color: var(--color-brand-700);
    }

    .hero__title {
        max-width: 10.5ch;
        margin: 0;
        font-family: var(--font-heading);
        font-size: clamp(3.5rem, 4.4vw, 4.85rem);
        font-weight: var(--font-weight-semibold);
        line-height: 1.08;
        letter-spacing: -0.025em;
        color: var(--color-neutral-900);
    }

    .hero__accent {
        width: 3.6rem;
        height: 0.18rem;
        margin-block: var(--space-7, 1.75rem);
        background: #c98a18;
    }

    .hero__description {
        max-width: 34rem;
        margin: 0;
        font-size: clamp(1rem, 1.2vw, 1.12rem);
        line-height: 1.7;
        color: var(--color-neutral-700);
    }

    .hero__actions {
        margin-top: var(--space-8);
    }

    .hero__actions :global(.hero__cta) {
        min-height: 4rem;
        padding-inline: 2rem;
        border-radius: 0.65rem;
        font-size: 1.05rem;
        box-shadow: 0 10px 24px rgb(56 63 44 / 11%);
    }

    .hero__cta-arrow {
        margin-left: var(--space-3);
        font-size: 1.45rem;
        line-height: 1;
        color: #d69a25;
    }

    .hero__assurance {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        margin-top: var(--space-8);
        font-size: 1rem;
        color: var(--color-neutral-700);
    }

    .hero__assurance-icon {
        width: 1.7rem;
        height: 1.7rem;
        flex: 0 0 auto;
        fill: none;
        stroke: var(--color-brand-700);
        stroke-width: 1.7;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .hero__visual {
        width: 100%;
        min-width: 0;
    }

    .hero__value-strip {
        margin-top: clamp(3rem, 5vw, 4.5rem);
    }

    /* Laptop */
    @media (max-width: 75rem) {
        .hero__main {
            grid-template-columns:
				minmax(21rem, 0.75fr)
				minmax(0, 1.25fr);
            gap: var(--space-10);
        }
        .hero__container {
            width: calc(100% - 4rem);
        }

        .hero__title {
            font-size: clamp(3rem, 4.8vw, 4rem);
        }
    }

    /* Tablet */
    @media (max-width: 62rem) {
        .hero__container {
            padding-top: var(--space-16);
        }

        .hero__container {
            width: calc(100% - 3rem);
        }

        .hero__main {
            grid-template-columns: 1fr;
            gap: var(--space-12);
        }

        .hero__content {
            max-width: 44rem;
        }

        .hero__title {
            max-width: 12ch;
        }

        .hero__visual {
            width: 100%;
        }
    }

    /* Mobile */
    @media (max-width: 40rem) {
       
        .hero__container {
            width: calc(100% - 2rem);
        }

        .hero__content {
            align-items: center;
            text-align: center;
        }

        .hero__eyebrow {
            margin-bottom: var(--space-5);
            font-size: 0.7rem;
            letter-spacing: 0.15em;
        }

        .hero__title {
            max-width: 11ch;
            margin-inline: auto;
            font-size: clamp(2.65rem, 12vw, 3.4rem);
            line-height: 1.06;
        }

        .hero__accent {
            margin-block: var(--space-6);
        }

        .hero__description {
            max-width: 32rem;
            margin-inline: auto;
            font-size: 1rem;
            line-height: 1.65;
        }

        .hero__actions {
            width: 100%;
            margin-top: var(--space-6);
        }

        .hero__actions :global(.hero__cta) {
            width: 100%;
            max-width: 22rem;
            min-height: 3.6rem;
            margin-inline: auto;
            padding-inline: var(--space-5);
        }

        .hero__assurance {
            justify-content: center;
            width: 100%;
            margin-top: var(--space-5);
            font-size: 0.92rem;
            text-align: center;
        }

        .hero__main {
            gap: var(--space-10);
        }

        .hero__visual {
            width: 100%;
            margin-inline: auto;
        }

        .hero__value-strip {
            margin-top: var(--space-10);
        }
    }
</style>