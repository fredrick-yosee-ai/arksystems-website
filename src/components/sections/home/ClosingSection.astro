---
import BookingButton from "../../common/BookingButton.astro";
import { SITE } from "../../../consts";

/*
 * Section 8 — the close. The page's only dark band, which is what makes it read as the
 * end rather than as one more section.
 *
 * Opens and closes on gain: the first headline on the page names the upside and so does
 * the last one. Pain lives only in body copy, where it does recognition work.
 *
 * The tagline is set below the CTA as a sign-off, never as a heading. It appears twice
 * on the site in total — here and once in the footer. A tagline used four times stops
 * being a tagline.
 */
---

<section class="closing on-dark">
  <div class="container closing__inner">
    <h2 class="closing__title">Establish where AI is worth it for your business.</h2>

    <p class="closing__body">
      Twenty minutes. Bring the part of the operation that costs you most. We&rsquo;ll
      tell you whether AI applies, what the return would be, and whether it&rsquo;s worth
      committing to.
    </p>

    <div class="closing__cta">
      <BookingButton location="closing" variant="cream" block>
        Book 20 minutes
      </BookingButton>
    </div>

    {/* The approved copy sets "Based in Metro Vancouver, working remotely across
        Canada." here. Removed on Fredrick's instruction of Aug 25 2026, along with every
        line like it elsewhere on the site. The CTA is followed directly by the tagline. */}

    <p class="closing__tagline">{SITE.tagline}</p>
  </div>
</section>

<style>
  .closing {
    background: var(--ark-olive);
    color: var(--ark-on-dark);
    padding-block: 92px;
  }

  .closing__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .closing__title {
    color: var(--ark-on-dark);
    font-size: 3.25rem;
    line-height: 1.08;
    letter-spacing: -0.026em;
    max-width: 20ch;
  }

  .closing__body {
    margin-top: 26px;
    font-size: var(--ark-body-lg);
    line-height: var(--ark-lh-body);
    color: var(--ark-on-dark-muted);
    max-width: 58ch;
  }

  .closing__cta {
    margin-top: 38px;
  }

  .closing__tagline {
    margin-top: 60px;
    font-family: var(--ark-font-display);
    font-weight: 700;
    font-size: 2rem;
    letter-spacing: 0.005em;
    color: var(--ark-on-dark-eyebrow);
  }

  @media (max-width: 900px) {
    .closing {
      padding-block: 62px;
    }

    .closing__title {
      font-size: var(--ark-h2);
      line-height: var(--ark-lh-h2);
      max-width: 18ch;
    }

    /* The one dark-band paragraph, and the only place body copy is centred besides the
     * pause section. Three short sentences, no list to lose your place in. */
    .closing__body {
      margin-top: 18px;
      max-width: 36ch;
    }

    .closing__cta {
      margin-top: 28px;
      width: 100%;
    }

    .closing__tagline {
      margin-top: 44px;
      font-size: 1.5rem;
    }
  }
</style>
