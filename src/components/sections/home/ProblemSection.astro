---
import Icon from "../../common/Icon.astro";

/*
 * Section 2 — the problem. No call to action here, by instruction. This section's job
 * is recognition; a button in the middle of it asks for a decision before the reader
 * has finished agreeing with the diagnosis.
 *
 * The three blocks are the three numbers the body paragraph says are missing — where
 * AI applies, what the problem costs, what the return would be — so they are cards in
 * a row rather than a list. A row lets you see there are three of them at a glance,
 * which is the point the closing line then picks up with "all three".
 *
 * Each block's copy is one bold lead sentence and one supporting sentence. The lead is
 * the h3, exactly as written in the approved file, full stop included.
 *
 * COPY CHANGE, Fredrick's instruction of Aug 25 2026 — the heading and lede only.
 *
 *   was  "AI spending fails when it starts with the technology instead of the business
 *         case." ... "Without those three figures, any AI investment is a guess with an
 *         invoice attached."
 *
 * The section has to show the problem without opening on failure. Telling a reader in
 * the first line of the second section that spending like theirs fails puts them on the
 * defensive at the exact moment the page needs agreement, and "a guess with an invoice
 * attached" closed the paragraph on the same note.
 *
 * The replacement states the same problem from the other side: three numbers are
 * missing, and they are missing because nobody has time to work them out while the
 * business is running — which is the standing rule that the reader's admin load is what
 * success creates, not evidence of bad management. The paragraph now ends on what
 * having the numbers gives them. Nothing about the diagnosis is softened; the three
 * cards below are unchanged.
 *
 * The lede was then rewritten a second time, on the same day and the same instruction,
 * for plain language. The first replacement opened "The tools aren't the constraint.
 * Three figures are, and they're rarely to hand:" — an ellipsis the reader has to
 * reassemble before the sentence means anything, followed by two idioms ("to hand", and
 * "on faith" at the end). That is precisely what the standing rule warns about: the
 * risk to a reader whose first language is not English is idiom, not vocabulary. Four
 * plain sentences now, no ellipsis, and "figures" is "numbers" throughout.
 */

const blocks = [
  {
    icon: "assess",
    title: "Not every inefficiency is an AI opportunity.",
    body: "A share of what slows your business requires AI. The remainder requires a process change, or better use of software you already license. Telling them apart requires examination, not a demonstration.",
  },
  {
    icon: "cost",
    title: "The cost of the problem is rarely quantified.",
    body: "You know which processes create friction. You don't know what they cost you monthly, which leaves any investment decision unsupported.",
  },
  {
    icon: "benchmark",
    title: "There's no internal benchmark.",
    body: "Your team understands the operation better than we ever will. What they don't have is a reference for what AI delivers in practice, what it costs, and what timeline is realistic.",
  },
] as const;
---

<section class="section section--cream problem" id="the-problem">
  <div class="container">
    <div class="section__head problem__head">
      <div class="problem__head-lead">
        <span class="eyebrow">The problem</span>
        <h2 class="section__title problem__title">
          AI pays when it starts with your business case, not with the technology.
        </h2>
      </div>
      <p class="section__lede problem__lede">
        The tools aren&rsquo;t the problem. The hard part is seeing <strong>where AI
        would help in your business</strong>, <strong>what that help is worth</strong>,
        and <strong>what it would cost to build</strong>. Nobody has time to work that
        out while the business is running. Once you have those answers, AI is a decision
        like any other in the business.
      </p>
    </div>

    <ul class="problem__grid">
      {
        blocks.map((block) => (
          <li class="card problem__card">
            <span class="problem__icon" aria-hidden="true">
              <Icon name={block.icon} />
            </span>
            <h3 class="problem__card-title">{block.title}</h3>
            <p class="problem__card-body">{block.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="problem__close">
      We establish all three: where AI applies in your business, what the problem costs
      you now, and what the return would be.
    </p>
  </div>
</section>

<style>
  /* Desktop: the head is two columns — heading left, paragraph right.
   *
   * It was one left-aligned block inside a 1240px container, and a 26ch heading over a
   * 62ch paragraph left roughly a third of the section empty on the right. On a band
   * that is the full width of the page that reads as something failing to load rather
   * than as deliberate space.
   *
   * The split follows the standing rule that a two-column section is split by content
   * type: all the display type in one column, all the prose in the other. It also puts
   * the three bold phrases at the top right of the section, which is where the eye goes
   * after the heading.
   *
   * The query is the exact complement of the centring rule in base.css, which fires on
   * `(max-width: 900px), (orientation: portrait)`. A portrait tablet centres its heading
   * and must not also be holding two columns.
   */
  @media (min-width: 901px) and (orientation: landscape) {
    .problem__head {
      max-width: none;
      display: grid;
      /* Slightly wider left column: the heading is capped at 26ch and stops on its own,
       * so the extra width goes to the prose, which fills its column exactly. */
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      column-gap: 56px;
      align-items: start;
    }

    .problem__lede {
      /* No top margin — it sits beside the heading, not under it. The 2px nudge puts its
       * first line on the heading's first baseline rather than its cap height. */
      margin-top: 2px;
      /* The column is the measure here. It lands at ~62ch, which is the cap the base
       * .section__lede rule sets anyway. */
      max-width: none;
    }
  }

  .problem__title {
    max-width: 26ch;
  }

  /* The three things the reader can't see are the three the section is about. Bold alone
   * is not enough separation from body ink at 20px, so they take the display ink too. */
  .problem__lede strong {
    font-weight: 600;
    color: var(--ark-ink);
  }

  .problem__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--ark-grid-gutter);
    margin-top: 64px;
  }

  .problem__card {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .problem__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--ark-radius-pill);
    background: var(--ark-stage-green);
    color: var(--ark-olive);
    margin-bottom: 4px;
  }

  .problem__card-title {
    font-size: var(--ark-h3);
    line-height: var(--ark-lh-h3);
    letter-spacing: -0.01em;
    max-width: 22ch;
  }

  .problem__card-body {
    font-size: var(--ark-body);
    line-height: var(--ark-lh-body);
    color: var(--ark-body-ink);
  }

  /* The closing line is centred and sits on its own — it is the section's conclusion,
   * and the only sentence here that speaks about us rather than about them. */
  .problem__close {
    margin: 64px auto 0;
    max-width: 44ch;
    text-align: center;
    font-family: var(--ark-font-display);
    font-weight: 700;
    font-size: var(--ark-h3);
    line-height: var(--ark-lh-h3);
    letter-spacing: -0.01em;
    color: var(--ark-ink);
  }

  @media (max-width: 1100px) {
    .problem__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Phone: three cards stacked is three screens, which is the most a reader will give
   * a section that has no call to action in it. The icon moves inline with the heading
   * so each card opens with its point rather than with a 44px circle, and the padding
   * comes in — the card is doing less work here than at desktop, where it also has to
   * hold a column. */
  @media (max-width: 900px) {
    .problem__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
      margin-top: 36px;
    }

    .problem__card {
      display: grid;
      grid-template-columns: 40px minmax(0, 1fr);
      column-gap: 14px;
      row-gap: 8px;
      align-items: center;
      padding: 20px;
    }

    .problem__icon {
      width: 40px;
      height: 40px;
      margin-bottom: 0;
      grid-row: 1;
    }

    .problem__card-title {
      grid-column: 2;
      max-width: none;
    }

    .problem__card-body {
      grid-column: 1 / -1;
      font-size: 1rem;
    }

    .problem__close {
      margin-top: 40px;
      max-width: 30ch;
    }
  }
</style>
