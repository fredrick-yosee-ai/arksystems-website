---
/*
 * Section 4 — self-qualification by symptom. No headcount, no sector.
 *
 * This is where the reader decides the page is about them, so the five points are the
 * whole section — they get the full width and equal visual weight, as a checklist the
 * reader can tick off mentally.
 *
 * The "A week, roughly" bar chart that used to sit beside the heading was removed at
 * Fredrick's request. It was decorative: it carried no figures and no source, and it
 * competed with the points for attention in the one section where the points are the
 * argument.
 */

const criteria = [
  "The same task takes hours every week, and you cannot charge anyone for it",
  "Information comes by email, text, photo and paper, and someone matches it all up by hand",
  "You have looked at AI tools and could not tell which one would actually be worth the money",
  "The person doing the admin is you, or someone on your team who's far too senior for it",
  "You'd rather fix one thing properly than buy another subscription",
];
---

<section class="is-this-you">
  <div class="container">
    <header class="is-this-you__head">
      <p class="eyebrow is-this-you__eyebrow">Is this you?</p>
      <h2 class="is-this-you__title">This tends to be worth a conversation if:</h2>
    </header>

    <ul class="criteria">
      {
        criteria.map((item) => (
          <li class="criteria__item">
            <span class="criteria__mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5" />
              </svg>
            </span>
            <span class="criteria__text">{item}</span>
          </li>
        ))
      }
    </ul>

    <p class="is-this-you__close">
      If two or three of those landed, there are hours in your week waiting to come back.
      That is worth a conversation.
    </p>
  </div>
</section>

<style>
  .is-this-you {
    padding-block: 96px;
  }

  .is-this-you__eyebrow {
    display: block;
    margin-bottom: 22px;
  }

  /* The measure belongs on the heading itself, not on the wrapper — `ch` resolves
   * against the element's own font-size, so on the wrapper it would be counting
   * 16px characters and cramp the heading to about a third of its proper width. */
  .is-this-you__title {
    font-size: 2.5rem;
    letter-spacing: -0.015em;
    max-width: 22ch;
  }

  /* --- the five points --- */

  .criteria {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 52px;
  }

  /* Five points into two columns leaves one over. Letting the last span the row reads
   * as a deliberate final beat rather than an orphan. */
  .criteria__item:last-child {
    grid-column: 1 / -1;
  }

  .criteria__item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: #fff;
    border: 1px solid var(--ark-grey);
    border-radius: var(--ark-radius);
    padding: 26px 28px;
    transition:
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  /* A quiet lift on hover. The reader is mentally ticking these off; the section should
   * feel responsive to that without turning into a set of buttons. */
  .criteria__item:hover {
    border-color: var(--ark-olive-2);
    transform: translateY(-2px);
  }

  .criteria__mark {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--ark-green-soft);
    color: var(--ark-olive);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .criteria__mark svg {
    width: 17px;
    height: 17px;
  }

  .criteria__text {
    font-size: 1.06rem;
    line-height: 1.5;
    color: var(--ark-charcoal);
  }

  .is-this-you__close {
    margin-top: 44px;
    max-width: 62ch;
    font-family: var(--ark-font-display);
    font-size: 1.5rem;
    line-height: 1.4;
    color: var(--ark-olive);
  }

  @media (prefers-reduced-motion: reduce) {
    .criteria__item {
      transition: none;
    }

    .criteria__item:hover {
      transform: none;
    }
  }

  @media (max-width: 1100px) {
    .criteria {
      grid-template-columns: minmax(0, 1fr);
    }

    .criteria__item:last-child {
      grid-column: auto;
    }
  }

  /* Phone and any portrait screen: centre the heading block and the closing line, and
   * centre the column of points in the page. The point text itself stays left-aligned —
   * these are full sentences, and centred body copy is measurably harder to read,
   * which matters more than usual for a page written for readers whose first language
   * may not be English. */
  @media (max-width: 900px), (orientation: portrait) {
    .is-this-you__head {
      text-align: center;
    }

    .is-this-you__title {
      margin-inline: auto;
    }

    .criteria {
      max-width: 620px;
      margin-inline: auto;
    }

    .is-this-you__close {
      margin-inline: auto;
      text-align: center;
    }
  }

  @media (max-width: 900px) {
    .is-this-you {
      padding-block: 56px;
    }

    .is-this-you__title {
      font-size: var(--ark-h2);
    }

    .criteria {
      margin-top: 34px;
      gap: 14px;
    }

    .criteria__item {
      padding: 20px 20px;
      gap: 14px;
    }

    .criteria__text {
      font-size: 1rem;
    }

    .is-this-you__close {
      margin-top: 32px;
      font-size: 1.24rem;
    }
  }
</style>
