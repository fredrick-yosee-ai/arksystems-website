---
import Container from "../../common/Container.astro";
import Button from "../../common/Button.astro";

const questions = [
    "Where is the work actually happening?",
    "Where is it getting stuck?",
    "What is the cost of that friction?",
    "What is the simplest way to fix it?",
    "Does AI actually make it better, or just more complex?",
];
---

<section class="about-section">
    <Container>
        <div class="about-section__content">
            <div class="about-section__intro">
                <h2 class="about-section__title">
                    Business-first thinking with the technical ability to implement.
                </h2>

                <div class="about-section__copy">
                    <p>
                        ArkSystems was founded to help established businesses navigate the gap
                        between the promise of AI and the reality of their daily operations.
                    </p>

                    <p>
                        We believe that technology is only valuable when it solves a specific,
                        understood business problem. That is why we start with the workflow,
                        not the tool. We ask:
                    </p>
                </div>
            </div>

            <div class="about-section__details">
                <div class="about-section__questions">
                    {
                        questions.map((question) => (
                                <div class="about-question">
								<span
                                        class="about-question__icon material-symbols-rounded"
                                        aria-hidden="true"
                                >
									radio_button_unchecked
								</span>

                                    <span>{question}</span>
                                </div>
                        ))
                    }
                </div>

                <p class="about-section__statement">
                    Our background in process optimization and software implementation means
                    we don't just provide a report—we provide a path to a working solution.
                </p>

                <div class="about-section__action">
                    <Button href="/#" variant="secondary">
                        <span>Learn More About ArkSystems</span>
                        <span class="material-symbols-rounded" aria-hidden="true">
							arrow_forward
						</span>
                    </Button>
                </div>
            </div>
        </div>
    </Container>
</section>

<style>
    .about-section {
        padding-block: var(--section-padding-y);
        border-top: 1px solid rgb(79 84 64 / 5%);
    }

    .about-section__content {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(3rem, 6vw, 5rem);
        max-width: 69rem;
        margin-inline: auto;
    }

    .about-section__title {
        max-width: 32rem;
        margin: 0;
        font-size: clamp(2.3rem, 3.6vw, 3.1rem);
        line-height: 1.08;
        letter-spacing: -0.02em;
        color: var(--color-neutral-900);
    }

    .about-section__copy {
        display: grid;
        gap: 1.4rem;
        max-width: 34rem;
        margin-top: 1.8rem;
    }

    .about-section__copy p,
    .about-section__statement {
        margin: 0;
        font-size: 0.96rem;
        line-height: 1.7;
        color: var(--color-neutral-700);
    }

    .about-section__questions {
        display: grid;
        gap: 1.05rem;
        padding: 1.2rem 1.4rem;
        border-left: 3px solid var(--color-brand-200);
        background: rgb(255 253 248 / 58%);
    }

    .about-question {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        font-size: 0.94rem;
        line-height: 1.5;
        color: var(--color-neutral-700);
    }

    .about-question__icon {
        flex: 0 0 auto;
        margin-top: 0.12rem;
        font-size: 0.85rem;
        color: var(--color-brand-700);
        font-variation-settings:
                "FILL" 0,
                "wght" 500,
                "GRAD" 0,
                "opsz" 20;
    }

    .about-section__statement {
        margin-top: 1.6rem;
    }

    .about-section__action {
        margin-top: 1.75rem;
    }

    .about-section__action :global(.button) {
        min-height: 3.25rem;
        padding-inline: 1.5rem;
        border-color: var(--color-brand-700);
        color: var(--color-brand-800);
    }

    .about-section__action :global(.button:hover) {
        background: var(--color-brand-100);
    }

    @media (max-width: 62rem) {
        .about-section__content {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }

        .about-section__intro,
        .about-section__details {
            max-width: 100%;
        }
    }

    @media (max-width: 44rem) {
        .about-section {
            padding-block: var(--section-padding-y-mobile);
        }

        .about-section__title {
            font-size: clamp(2rem, 9vw, 2.55rem);
        }

        .about-section__copy {
            margin-top: 1.4rem;
        }

        .about-section__questions {
            padding: 1rem 1.1rem;
        }

        .about-section__action :global(.button) {
            width: 100%;
            max-width: 22rem;
        }
    }
</style>