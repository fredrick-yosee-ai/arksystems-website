---
import { SITE } from "../../../consts";

/*
 * Section 7 — before you book, and the page's FAQPage schema.
 *
 * An FAQ is where you close, not where you disclose. All four questions are buying
 * questions and every answer removes a reason not to book.
 *
 * Built on <details>/<summary>, so it works with no JavaScript at all: keyboard
 * operable, announced correctly as a disclosure, open and closed state handled by the
 * browser. Every answer stays in the DOM whether open or shut, so nothing is hidden
 * from search engines, from find-on-page, or from the schema below.
 *
 * Collapsed at every width — Fredrick's instruction of Aug 25 2026. Four long answers
 * set open would be roughly two extra screens on a phone immediately before the closing
 * CTA, and on desktop the shorter section keeps the close in view.
 *
 * ---------------------------------------------------------------------------
 * RESOLVED — the "What happens to my data?" claims-accuracy issue.
 *
 * The previous answer said "Anything that matters still goes past a person before it
 * happens — that's deliberate, not a setting", which was untrue under the hybrid model:
 * the system posts automatically when the category is clear and asks when it is not, so
 * a routine item is filed without anyone seeing it first. It was logged as an open
 * launch blocker in CLAUDE.md.
 *
 * The approved answer below fixes it and is used verbatim. "You determine what runs
 * automatically and what stops for review, and every step is recorded either way" is
 * accurate to the hybrid model, describes a setting rather than denying one, and claims
 * no capability that cannot be demonstrated.
 * ---------------------------------------------------------------------------
 */

const faqs = [
  {
    q: "What does this cost?",
    a: "Every engagement carries a fixed fee, agreed before work begins, and it doesn't increase as we go. We establish it after a short conversation, because it depends on the scope of the work.",
  },
  {
    q: "Do you always recommend AI?",
    a: "No. Frequently the answer is a process change, or better use of software you already license. We recommend AI where AI produces a return, and we say so plainly when it doesn't.",
  },
  {
    q: "Who owns it when you're done?",
    a: "You do. It operates on your accounts and the work remains your property. There's no ArkSystems subscription attached to it.",
  },
  {
    q: "What happens to my data?",
    a: "We take access to what the work requires and nothing beyond it. You determine what runs automatically and what stops for review, and every step is recorded either way.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
  url: `${SITE.url}/`,
};
---

<section class="section section--cream faq" id="before-you-book">
  <div class="container">
    <div class="section__head faq__head">
      <h2 class="section__title faq__title">Before you book</h2>
    </div>

    <div class="faq__list">
      {
        faqs.map((item) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span>{item.q}</span>
              <svg
                class="faq__chevron"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="faq__a">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />

<style>
  /* No eyebrow on this one. Every other section's eyebrow is its short name and the
   * heading is a sentence; here the approved heading IS the short name, so an eyebrow
   * would set "Before you book" twice in a row and be read out twice. */
  .faq__title {
    max-width: none;
  }

  .faq__list {
    max-width: 820px;
    margin-top: 44px;
    border-top: 1px solid var(--ark-hairline);
  }

  .faq__item {
    border-bottom: 1px solid var(--ark-hairline);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 4px;
    cursor: pointer;
    list-style: none;
    font-family: var(--ark-font-display);
    font-weight: 700;
    font-size: 1.1875rem;
    line-height: 1.35;
    color: var(--ark-ink);
    transition: color 0.15s ease;
  }

  /* Safari draws its own triangle unless this is removed too. */
  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    color: var(--ark-terracotta-ink);
  }

  .faq__chevron {
    flex-shrink: 0;
    color: var(--ark-terracotta);
    transition: transform 0.25s ease;
  }

  .faq__item[open] .faq__chevron {
    transform: rotate(180deg);
  }

  .faq__a p {
    padding: 0 4px 24px;
    max-width: 68ch;
    font-size: var(--ark-body);
    line-height: var(--ark-lh-body);
    color: var(--ark-body-ink);
  }

  /* NO open/close height animation here, deliberately, and it should not be added back
   * without testing that the answers actually appear.
   *
   * The obvious implementation — `::details-content { block-size: 0 }` transitioning to
   * `block-size: auto` under `interpolate-size` — was built and measured, and it does not
   * merely fail to animate: it stops the FAQ opening at all. Listing content-visibility
   * in the transition takes the property out of the browser's hands, so it stays
   * `hidden` through the open state; hidden content has no size, `auto` resolves to 0,
   * and every answer stays invisible while `details.open` reports true. Measured on the
   * built page: the list stayed exactly 241px tall whether open or shut, and each answer
   * returned `checkVisibility() === false`. Adding `content-visibility: visible` to the
   * open state did not reliably fix it either.
   *
   * So the disclosure is left to the browser, which does it correctly and instantly. The
   * chevron rotation below is the feedback, and it is enough. A disclosure widget's job
   * is to disclose; a 280ms ease on the way there is not worth the risk of shipping four
   * questions that cannot be answered.
   */

  @media (prefers-reduced-motion: reduce) {
    .faq__chevron {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .faq__list {
      margin-top: 28px;
    }

    .faq__q {
      font-size: 1.0625rem;
      padding: 18px 2px;
      gap: 14px;
    }

    .faq__a p {
      padding: 0 2px 20px;
      font-size: 1rem;
    }
  }
</style>
