---
import BookingButton from "../../common/BookingButton.astro";
import ReceiptPanel from "./see-it-work/ReceiptPanel.astro";
import ChatPanel from "./see-it-work/ChatPanel.astro";
import SheetPanel from "./see-it-work/SheetPanel.astro";
import MonthEndStrip from "./see-it-work/MonthEndStrip.astro";

/*
 * Section 3 — the emotional centre of the page, and the block with the most vertical
 * space. Everything before it makes the reader agree something is wrong; this is where
 * they feel what it is like when it stops. A cramped payoff reads as a footnote, which
 * is why the padding here is deliberately the largest on the page.
 *
 * It must not move above section 2. Showing the fix before the problem is felt turns it
 * into a product demo instead of a resolution.
 *
 * The H2 is "You see every one", not the spec's "You approve everything in between".
 * The receipt system posts automatically when the category is clear and asks when it is
 * not, so the spec's line described a review-everything model that does not exist.
 * See CLAUDE.md.
 */

const whatChanges = [
  "No more Saturdays sorting out receipts.",
  "Month-end takes an hour, not a whole evening.",
  "Nobody emails you asking where a receipt went.",
];
---

<section class="see-it-work on-dark" id="see-it-work">
  <div class="container">
    <p class="eyebrow see-it-work__eyebrow">See it work</p>

    <h2 class="see-it-work__title">
      A receipt goes in. A clean line item comes out. You see every one.
    </h2>

    <p class="see-it-work__intro">
      This is an AI system we built to handle receipts, shown here with sample data. You
      send the receipt the way you would send it anyway. Everything after that stops being
      your problem.
    </p>

    <div class="see-it-work__row">
      <div class="see-it-work__panel">
        <div class="see-it-work__panel-head">
          <span class="see-it-work__step" aria-hidden="true">01</span>
          <h3 class="see-it-work__panel-title">You send it and forget it</h3>
        </div>
        <p class="see-it-work__panel-body">
          A photo, in the same chat you already use. No app to open, nothing to file.
        </p>
        <ReceiptPanel />
      </div>

      <div class="see-it-work__panel">
        <div class="see-it-work__panel-head">
          <span class="see-it-work__step" aria-hidden="true">02</span>
          <h3 class="see-it-work__panel-title">It answers in about a minute</h3>
        </div>
        <p class="see-it-work__panel-body">
          Read, split into lines, categorised, and the tax pulled out separately. Nothing
          is guessed at silently &mdash; you see every line.
        </p>
        <ChatPanel />
      </div>
    </div>

    <div class="see-it-work__panel see-it-work__panel--wide">
      <div class="see-it-work__panel-head">
        <span class="see-it-work__step" aria-hidden="true">03</span>
        <h3 class="see-it-work__panel-title">It lands in your own sheet</h3>
      </div>
      <p class="see-it-work__panel-body">
        Line by line, with the photo attached to each one. Your sheet, your account
        &mdash; nothing new to learn, and nothing locked inside our software.
      </p>
      <SheetPanel />
    </div>

    <MonthEndStrip />

    {/*
      The "what changes" beat. Without it the section describes what the thing does;
      with it, the section describes what their month looks like afterwards. That is
      what turns a demonstration into a resolution.
    */}
    <div class="see-it-work__changes">
      {whatChanges.map((line) => <p class="see-it-work__change">{line}</p>)}
    </div>

    <p class="see-it-work__caption">Illustration using sample data.</p>

    <div class="see-it-work__cta">
      <BookingButton location="demo" variant="cream" />
    </div>
  </div>
</section>

<style>
  .see-it-work {
    background: var(--ark-olive);
    color: var(--ark-on-dark);
    padding-block: 130px 140px;
  }

  .see-it-work__eyebrow {
    display: block;
    margin-bottom: 26px;
  }

  .see-it-work__title {
    color: var(--ark-on-dark);
    font-size: var(--ark-h2);
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  .see-it-work__intro {
    margin-top: 28px;
    font-size: 1.16rem;
    line-height: 1.65;
    color: #dbe6c4;
    max-width: 64ch;
  }

  .see-it-work__row {
    display: grid;
    grid-template-columns: 560px minmax(0, 1fr);
    gap: 32px;
    margin-top: 64px;
    align-items: start;
  }

  .see-it-work__panel--wide {
    margin-top: 56px;
  }

  .see-it-work__panel-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 8px;
  }

  .see-it-work__step {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ark-on-dark-eyebrow);
  }

  .see-it-work__panel-title {
    color: var(--ark-on-dark);
    font-size: var(--ark-h3);
    line-height: 1.2;
  }

  .see-it-work__panel-body {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ark-on-dark-muted);
    margin-bottom: 22px;
    max-width: 52ch;
  }

  .see-it-work__changes {
    margin-top: 86px;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .see-it-work__change {
    font-family: var(--ark-font-display);
    font-size: 2.9rem;
    font-weight: 700;
    color: var(--ark-on-dark);
    line-height: 1.14;
    letter-spacing: -0.018em;
  }

  .see-it-work__caption {
    margin-top: 44px;
    font-size: 0.88rem;
    color: var(--ark-on-dark-eyebrow);
    border-left: 2px solid var(--ark-gold);
    padding-left: 14px;
  }

  .see-it-work__cta {
    margin-top: 44px;
  }

  @media (max-width: 1100px) {
    .see-it-work__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 44px;
    }
  }

  @media (max-width: 900px) {
    .see-it-work {
      padding-block: 62px 68px;
    }

    .see-it-work__row {
      margin-top: 40px;
      gap: 36px;
    }

    .see-it-work__panel--wide {
      margin-top: 36px;
    }

    .see-it-work__changes {
      margin-top: 52px;
      gap: 18px;
    }

    .see-it-work__change {
      font-size: 1.6rem;
    }

    .see-it-work__caption {
      margin-top: 30px;
    }
  }
</style>
