---
import Container from "../../common/Container.astro";

const differentiators = [
    {
        title: "The business problem comes first",
        body:
            "We connect AI and automation to a real workflow, operational effect and potential business value.",
    },
    {
        title: "The simplest solution comes first",
        body:
            "We do not recommend custom development when process improvement, existing software or a direct integration can solve the problem.",
    },
    {
        title: "Human judgment remains human",
        body:
            "Professional, financial, legal and other high-risk decisions should remain under appropriate human review.",
    },
    {
        title: "Recommendations must be supportable",
        body:
            "We make assumptions and missing information visible. We do not promise results that ArkSystems cannot control.",
    },
];
---

<section class="differentiators-section">
    <Container>
        <div class="differentiators-section__content">
            <div class="differentiators-section__intro">
                <p class="differentiators-section__eyebrow">
                    What Makes ArkSystems Different
                </p>

                <h2 class="differentiators-section__title">
                    Practical enough to recommend less technology.
                </h2>

                <p class="differentiators-section__description">
                    ArkSystems is not a generic AI consultancy or a custom-development-first agency.
                    Our role is to help you make a better business decision.
                </p>
            </div>

            <div class="differentiators-section__grid">
                {
                    differentiators.map((item) => (
                            <article class="differentiator-card">
                                <h3>{item.title}</h3>
                                <p>{item.body}</p>
                            </article>
                    ))
                }
            </div>
        </div>
    </Container>
</section>

<style>
    .differentiators-section {
        padding-block: var(--section-padding-y);
        //background: var(--color-section-secondary);
        border-top: 1px solid rgb(79 84 64 / 5%);
    }

    .differentiators-section__content {
        max-width: 69rem;
        margin-inline: auto;
    }

    .differentiators-section__intro {
        max-width: 47rem;
        margin-inline: auto;
        text-align: center;
    }

    .differentiators-section__eyebrow {
        margin: 0 0 1rem;
        font-size: 0.72rem;
        font-weight: var(--font-weight-bold);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-brand-700);
    }

    .differentiators-section__title {
        //max-width: 38rem;
        margin: 0 auto;
        font-size: clamp(2.25rem, 3.5vw, 3rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: var(--color-neutral-900);
    }

    .differentiators-section__description {
        max-width: 42rem;
        margin: 1.4rem auto 0;
        font-size: 0.98rem;
        line-height: 1.65;
        color: var(--color-neutral-700);
    }

    .differentiators-section__grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem 1.5rem;
        margin-top: 3rem;
    }

    .differentiator-card {
        padding: 1.8rem 1.9rem;
        border: 1px solid rgb(79 84 64 / 12%);
        border-radius: 0.55rem;
        background: rgb(255 253 248 / 78%);
        box-shadow: 0 2px 5px rgb(58 63 46 / 3%);
    }

    .differentiator-card h3 {
        margin: 0 0 0.8rem;
        font-family: var(--font-heading);
        font-size: 1.25rem;
        font-weight: var(--font-weight-semibold);
        line-height: 1.3;
        color: var(--color-brand-800);
    }

    .differentiator-card p {
        margin: 0;
        font-size: 0.94rem;
        line-height: 1.65;
        color: var(--color-neutral-700);
    }

    @media (max-width: 62rem) {
        .differentiators-section__content {
            max-width: 100%;
        }
    }

    @media (max-width: 44rem) {
        .differentiators-section {
            padding-block: var(--section-padding-y-mobile);
        }

        .differentiators-section__title {
            font-size: clamp(2rem, 9vw, 2.55rem);
        }

        .differentiators-section__grid {
            grid-template-columns: 1fr;
            margin-top: 2.4rem;
        }

        .differentiator-card {
            padding: 1.4rem;
        }
    }
</style>