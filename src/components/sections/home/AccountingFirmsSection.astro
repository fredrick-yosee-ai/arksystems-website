---
import Container from "../../common/Container.astro";
import Button from "../../common/Button.astro";

const painPoints = [
    "Staff repeatedly chasing clients for missing documents",
    "Information arriving through several channels",
    "Engagement statuses being tracked manually",
    "Managers spending time finding out what is blocked",
    "Experienced accounting staff handling avoidable administrative work",
    "Incomplete information delaying the start or completion of client work",
];
---

<section class="accounting-section">
    <Container>
        <div class="accounting-section__content">
            <p class="accounting-section__eyebrow">
                For Accounting, Bookkeeping and CAS Firms
            </p>

            <h2 class="accounting-section__title">
                Stop letting document collection and follow-up consume your busiest periods.
            </h2>

            <p class="accounting-section__description">
                Accounting firms manage recurring, document-heavy workflows where delays
                and poor visibility directly affect capacity, turnaround time and client service.
            </p>

            <div class="accounting-section__points">
                {
                    painPoints.map((item) => (
                            <div class="accounting-point">
							<span
                                    class="accounting-point__icon material-symbols-rounded"
                                    aria-hidden="true"
                            >
								check_circle
							</span>

                                <span>{item}</span>
                            </div>
                    ))
                }
            </div>

            <p class="accounting-section__statement">
                ArkSystems helps firms understand where these workflow gaps are creating
                operational and financial pressure—and what should be done about them.
            </p>

            <div class="accounting-section__actions">
                <Button href="mailto:hello@arksystems.ca" class="accounting-section__cta">
                    <span>Book an AI Opportunity Call</span>
                    <span
                            class="accounting-section__arrow material-symbols-rounded"
                            aria-hidden="true"
                    >
						arrow_forward
					</span>
                </Button>
            </div>
        </div>
    </Container>
</section>

<style>
    .accounting-section {
        padding-block: var(--section-padding-y);
        background: var(--color-section-secondary);
        border-top: 1px solid rgb(79 84 64 / 5%);
    }

    .accounting-section__content {
        max-width: 69rem;
        margin-inline: auto;
    }

    .accounting-section__eyebrow {
        margin: 0 0 1.4rem;
        font-size: 0.76rem;
        font-weight: var(--font-weight-bold);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-brand-700);
    }

    .accounting-section__title {
        max-width: 42rem;
        margin: 0;
        font-size: clamp(2.25rem, 3.5vw, 3rem);
        line-height: 1.12;
        letter-spacing: -0.02em;
        color: var(--color-brand-900);
    }

    .accounting-section__description {
        max-width: 55rem;
        margin: 1.8rem 0 0;
        font-size: 0.98rem;
        line-height: 1.65;
        color: var(--color-neutral-700);
    }

    .accounting-section__points {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: 4rem;
        row-gap: 1.5rem;
        margin-top: 2.6rem;
    }

    .accounting-point {
        display: flex;
        align-items: flex-start;
        gap: 0.8rem;
        min-width: 0;
        font-size: 0.94rem;
        line-height: 1.55;
        color: var(--color-neutral-700);
    }

    .accounting-point__icon {
        flex: 0 0 auto;
        margin-top: 0.05rem;
        font-size: 1.15rem;
        color: var(--color-brand-700);
        font-variation-settings:
                "FILL" 0,
                "wght" 500,
                "GRAD" 0,
                "opsz" 20;
    }

    .accounting-section__statement {
        max-width: 58rem;
        margin: 2.9rem 0 0;
        font-size: 0.96rem;
        font-weight: var(--font-weight-bold);
        line-height: 1.6;
        color: var(--color-neutral-900);
    }

    .accounting-section__actions {
        margin-top: 1.8rem;
    }

    .accounting-section__actions :global(.accounting-section__cta) {
        min-height: 3.5rem;
        padding-inline: 1.8rem;
        border-radius: 0.4rem;
        font-size: 0.78rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        box-shadow: 0 5px 12px rgb(58 63 46 / 10%);
    }

    .accounting-section__arrow {
        margin-left: 0.35rem;
        font-size: 1.25rem;
    }

    @media (max-width: 62rem) {
        .accounting-section__content {
            max-width: 100%;
        }

        .accounting-section__points {
            column-gap: 2.5rem;
        }
    }

    @media (max-width: 44rem) {
        .accounting-section {
            padding-block: var(--section-padding-y-mobile);
        }

        .accounting-section__title {
            font-size: clamp(2rem, 9vw, 2.55rem);
        }

        .accounting-section__description {
            margin-top: 1.4rem;
        }

        .accounting-section__points {
            grid-template-columns: 1fr;
            gap: 1.2rem;
            margin-top: 2rem;
        }

        .accounting-section__statement {
            margin-top: 2.4rem;
        }

        .accounting-section__actions {
            width: 100%;
        }

        .accounting-section__actions :global(.accounting-section__cta) {
            width: 100%;
            max-width: 22rem;
        }
    }
</style>
