---
/**
 * The shell both legal pages sit in: a header band, then one measured prose column.
 *
 * "Basic designs", by instruction, and that is the right answer rather than a concession.
 * These are documents. The site's section machinery — alternating bands, two-column
 * heads, illustration panels, steppers — exists to carry an argument down a marketing
 * page, and none of it helps a reader who has opened a privacy policy to find one
 * paragraph. What they need is a measure they can read, headings they can scan, and
 * tables that do not run off the screen.
 *
 * One column, not two. A legal document is read in order and cross-references itself by
 * section number ("the address in section 11"), which a two-column layout breaks.
 */
import { HAS_PENDING } from "../../lib/legal";

interface Props {
  eyebrow: string;
  title: string;
  /** Rendered under the title, before the standfirst. */
  dateline?: string;
  standfirst: string;
}

const { eyebrow, title, dateline, standfirst } = Astro.props;
---

<section class="lede section--cream">
  <div class="container lede__inner">
    <p class="eyebrow lede__eyebrow">{eyebrow}</p>
    <h1 class="lede__title">{title}</h1>
    {dateline && <p class="lede__dateline">{dateline}</p>}
    <p class="lede__standfirst" set:html={standfirst} />
  </div>
</section>

{
  /*
   * The review notice. It is not decoration and it is not a disclaimer bolted onto a
   * finished page — it is the accurate description of what this document currently is.
   * It renders only while a fact in PENDING is still null, so it disappears on its own
   * once the page is complete rather than needing to be remembered and removed.
   *
   * This does not substitute for the practitioner review. The pages are held on a branch
   * for that; the banner is what makes the state visible if one is ever opened early.
   */
  HAS_PENDING && (
    <div class="section--surface notice-band">
      <div class="container">
        <p class="notice" role="note">
          <strong>Draft, under review.</strong> This document is not final. Facts marked
          below are still being confirmed, and it has not yet been reviewed by a Canadian
          privacy practitioner. Do not rely on it.
        </p>
      </div>
    </div>
  )
}

<section class="doc section--surface">
  <div class="container">
    <div class="doc__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .lede {
    padding-block: 76px 60px;
  }

  .lede__eyebrow {
    color: var(--ark-terracotta-ink);
  }

  .lede__title {
    margin-top: 18px;
    font-size: var(--ark-h2);
    line-height: var(--ark-lh-h2);
    letter-spacing: -0.025em;
    color: var(--ark-ink);
    /* On the element carrying the font-size, never a wrapper — `ch` resolves against the
     * element's own size, so on a wrapper it counts 16px characters. */
    max-width: 24ch;
  }

  .lede__dateline {
    margin-top: 16px;
    font-size: var(--ark-small);
    color: var(--ark-muted);
  }

  .lede__standfirst {
    margin-top: 20px;
    font-size: var(--ark-body-lg);
    line-height: var(--ark-lh-body);
    color: var(--ark-body-ink);
    max-width: 62ch;
  }

  .notice-band {
    padding-top: 28px;
  }

  .notice {
    padding: 18px 22px;
    border-left: 4px solid var(--ark-terracotta);
    border-radius: 0 var(--ark-radius) var(--ark-radius) 0;
    background: var(--ark-gold-bg);
    font-size: var(--ark-body);
    line-height: var(--ark-lh-body);
    color: var(--ark-body-ink);
    /* Same measure as .doc__body, at the same font-size, so the two share a text column
     * and the notice reads as a callout on the document rather than as a wider thing
     * sitting above it. Its box is ~48px broader because of the padding and rule, which
     * is what makes it a callout. */
    max-width: 72ch;
  }

  .notice strong {
    color: var(--ark-ink);
  }

  .doc {
    padding-block: 44px 96px;
  }

  /* One measure for the whole document. 72ch on the element that carries the body size,
   * so it is 72 actual characters of body copy rather than 72 of something else. */
  .doc__body {
    font-size: var(--ark-body);
    line-height: var(--ark-lh-body);
    color: var(--ark-body-ink);
    max-width: 72ch;
  }

  /* Everything below styles slotted markup, so it has to be :global — Astro's scoping
   * attribute lands on this component's own elements, not on the page's. */
  .doc__body :global(h2) {
    margin-top: 56px;
    padding-top: 22px;
    border-top: 2px solid var(--ark-terracotta);
    font-size: 1.5rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--ark-ink);
  }

  .doc__body :global(h2:first-child) {
    margin-top: 0;
  }

  .doc__body :global(h3) {
    margin-top: 34px;
    font-size: var(--ark-h3);
    line-height: var(--ark-lh-h3);
    color: var(--ark-ink);
  }

  .doc__body :global(p) {
    margin-top: 16px;
  }

  .doc__body :global(ul) {
    margin-top: 16px;
    padding-left: 22px;
    list-style: disc;
  }

  .doc__body :global(li) {
    margin-top: 8px;
  }

  .doc__body :global(li::marker) {
    color: var(--ark-terracotta);
  }

  .doc__body :global(a) {
    color: var(--ark-olive);
    text-underline-offset: 3px;
  }

  .doc__body :global(strong) {
    color: var(--ark-ink);
    font-weight: 600;
  }

  /*
   * A table has to scroll inside its own box, and the box has to be the thing that is
   * constrained — a wide child still widens documentElement.scrollWidth, and iOS Safari
   * answers that by widening the layout viewport, which scrolls the whole page sideways
   * into blank space. `max-width: 100%` on the scroller is what stops that.
   */
  .doc__body :global(.doc-table) {
    max-width: 100%;
    margin-top: 24px;
    overflow-x: auto;
    border: 1px solid var(--ark-hairline);
    border-radius: var(--ark-radius);
    background: var(--ark-white);
  }

  .doc__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--ark-small);
    line-height: 1.5;
  }

  .doc__body :global(th),
  .doc__body :global(td) {
    padding: 13px 18px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--ark-hairline);
  }

  .doc__body :global(th) {
    font-weight: 600;
    color: var(--ark-ink);
    white-space: nowrap;
  }

  .doc__body :global(tbody tr:last-child td) {
    border-bottom: 0;
  }

  /* A defined term at the head of its own paragraph — the pattern the copy uses
   * throughout ("**Server logs.** Our website is hosted by…"). */
  .doc__body :global(.doc-term) {
    color: var(--ark-ink);
    font-weight: 600;
  }

  /* The short blocks the copy sets apart from the prose around them: the four principles
   * on /data-handling, and the stage-by-stage list. */
  .doc__body :global(.doc-block) {
    margin-top: 18px;
    padding: 18px 22px;
    border-left: 3px solid var(--ark-terracotta);
    border-radius: 0 var(--ark-radius) var(--ark-radius) 0;
    background: var(--ark-white);
  }

  .doc__body :global(.doc-block p) {
    margin-top: 0;
  }

  .doc__body :global(.doc-contact) {
    margin-top: 24px;
    padding: 22px 26px;
    border: 1px solid var(--ark-hairline);
    border-radius: var(--ark-radius);
    background: var(--ark-white);
  }

  .doc__body :global(.doc-contact p) {
    margin-top: 4px;
  }

  .doc__body :global(.doc-contact p:first-child) {
    margin-top: 0;
  }

  @media (max-width: 900px) {
    .lede {
      padding-block: 52px 44px;
    }

    .lede__title {
      max-width: 20ch;
    }

    .doc {
      padding-block: 36px 72px;
    }

    .doc__body :global(h2) {
      margin-top: 44px;
      font-size: 1.3125rem;
    }
  }

  /* Headings and the eyebrow centre on phone and in portrait, as everywhere on the site.
   * The prose does not — centred prose is harder to read, which matters more than usual
   * given the plain-language rule, and matters most of all in a document somebody is
   * reading to find one specific sentence. */
  @media (max-width: 900px), (orientation: portrait) {
    .lede__eyebrow,
    .lede__title {
      text-align: center;
      margin-inline: auto;
    }

    .lede__dateline {
      text-align: center;
    }

    .lede__standfirst {
      margin-inline: auto;
    }

    /* The document column centres as one block, text still left — the same rule the four
     * heroes follow, and for the same reason: a left-flush column under a centred title
     * reads as a misalignment. Measured at 768 before this: title centred at 193-575,
     * body flush left at 18-626 with 124px of empty band down its right side.
     *
     * The whole column moves together, headings and tables included, so the h2 rules stay
     * flush with the prose they head. At 390 the column already fills the container and
     * this changes nothing. */
    .doc__body,
    .notice {
      margin-inline: auto;
    }
  }
</style>
