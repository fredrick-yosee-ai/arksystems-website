---
/**
 * The shell all three legal pages sit in.
 *
 * REBUILT Aug 26 2026 to the conventional legal-page pattern, on Fredrick's instruction
 * and against meshroad.com/privacy-policy as the reference. The first version borrowed
 * the marketing site's furniture — a cream header band, an eyebrow, terracotta section
 * rules, callout cards, a left-flush column. That was the wrong instinct. A policy page is
 * not a section of the argument, and dressing it like one makes it look like it is selling
 * something, which is the opposite of what these three exist to do.
 *
 * What the reference actually does, measured at 1440 rather than eyeballed: a centred
 * 816px column, a 32px centred title, 18px body, and section headings set at body size in
 * bold. No bands, no rules, no cards, no eyebrow. Everything here follows that shape. The
 * colours and both typefaces stay ours — that is the whole of the brand on these pages,
 * and it is enough.
 *
 * THE COLUMN IS CENTRED AT EVERY WIDTH, not only in portrait. That is the deliberate
 * difference between this and every other page on the site: the marketing pages start at a
 * shared left edge because the eye follows a vertical line down a scroll, and an inset
 * section breaks it. A document has no such line to hold — it is one column read top to
 * bottom, and the convention every reader already knows is that it sits in the middle of
 * the page.
 *
 * One column, and no sidebar table of contents. A legal document cross-references itself
 * by section number ("the address in section 11"), which a two-column layout breaks, and a
 * fourteen-item sidebar is more furniture than the reference carries.
 */
import { HAS_PENDING } from "../../lib/legal";

interface Props {
  title: string;
  /** Rendered under the title. Omitted on a page with no effective date. */
  dateline?: string;
}

const { title, dateline } = Astro.props;
---

<section class="doc">
  <div class="doc__col">
    <h1 class="doc__title">{title}</h1>
    {dateline && <p class="doc__dateline">{dateline}</p>}

    {
      /*
       * The review notice. Not a disclaimer bolted onto a finished page — it is the
       * accurate description of what these documents currently are. It renders only while
       * a fact in PENDING is still null, so it clears itself when the last value lands
       * rather than having to be remembered and removed.
       *
       * It does NOT substitute for the practitioner review. All three pages are held on a
       * branch for that; this is what makes the state visible if one is opened early.
       */
      HAS_PENDING && (
        <p class="doc__notice" role="note">
          <strong>Draft, under review.</strong> This document is not final. Facts marked
          below are still being confirmed, and it has not yet been reviewed by a Canadian
          privacy practitioner. Do not rely on it.
        </p>
      )
    }

    <div class="doc__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .doc {
    /* The page's own background, not a band. There is one surface on this page. */
    background: var(--ark-surface);
    padding-block: 72px 104px;
  }

  /*
   * The measure sits on the column, and the column carries the body font-size, so `ch`
   * counts actual body characters. On a wrapper with a different size it would count 16px
   * ones — the mistake this repo records elsewhere.
   *
   * MEASURED, not guessed. `ch` is the width of a zero, which in Source Sans 3 at 17px is
   * 8.45px against an average lowercase character of 7.93px — so a `ch` measure gives more
   * characters per line than its number suggests, and the number alone tells you nothing.
   * At 83ch the text column runs 665px and sets 84 actual characters per line, against the
   * reference's roughly 96. Wider than the classic 60-75, deliberately: a policy page is
   * scanned for one clause as often as it is read through, and the reference's roominess
   * is part of the convention Fredrick pointed at. Narrower than the reference, also
   * deliberately, because 96 is past the point where the eye loses the line return.
   */
  .doc__col {
    width: 100%;
    max-width: 83ch;
    margin-inline: auto;
    padding-inline: var(--ark-gutter-phone);
    font-size: var(--ark-body);
    line-height: var(--ark-lh-body);
    color: var(--ark-body-ink);
  }

  /*
   * Centred, and deliberately modest — 2rem against the site's 2.875rem h2. A display
   * heading at marketing scale on a policy page reads as a landing page, which is the
   * exact impression these three must not give.
   */
  .doc__title {
    font-family: var(--ark-font-display);
    font-size: 2rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ark-ink);
    text-align: center;
  }

  .doc__dateline {
    margin-top: 12px;
    font-size: var(--ark-small);
    color: var(--ark-muted);
    text-align: center;
  }

  .doc__notice {
    margin-top: 32px;
    padding: 16px 20px;
    border: 1px solid var(--ark-gold-border);
    border-radius: var(--ark-radius-sm);
    background: var(--ark-gold-bg);
    font-size: var(--ark-small);
    line-height: 1.6;
  }

  .doc__notice strong {
    color: var(--ark-ink);
  }

  .doc__body {
    margin-top: 40px;
  }

  /* Everything below styles slotted markup, so it has to be :global — Astro's scoping
   * attribute lands on this component's own elements, not on the page's. */

  /*
   * Section headings. Bold, near body scale, in the body face. The reference sets them as
   * plain bold run-ins, and the effect is that they organise the document without
   * interrupting it. Ours take the display ink and a little more size so that fourteen
   * numbered sections stay scannable, and nothing more. NO RULE ABOVE THEM: a drawn line
   * every few paragraphs turns a document back into a series of panels.
   */
  .doc__body :global(h2) {
    margin-top: 44px;
    font-size: 1.125rem;
    line-height: 1.45;
    font-weight: 700;
    color: var(--ark-ink);
  }

  .doc__body :global(h2:first-child) {
    margin-top: 0;
  }

  .doc__body :global(h3) {
    margin-top: 30px;
    font-size: var(--ark-body);
    line-height: 1.5;
    font-weight: 700;
    color: var(--ark-ink);
  }

  .doc__body :global(p) {
    margin-top: 15px;
  }

  .doc__body :global(ul) {
    margin-top: 15px;
    padding-left: 22px;
    list-style: disc;
  }

  .doc__body :global(li) {
    margin-top: 7px;
  }

  .doc__body :global(a) {
    color: var(--ark-olive);
    text-underline-offset: 3px;
  }

  /* The run-in bold the copy uses throughout ("**Server logs.** Our website is hosted
   * by…"), and any other emphasis, set the same way. */
  .doc__body :global(strong),
  .doc__body :global(.doc-term) {
    color: var(--ark-ink);
    font-weight: 700;
  }

  /*
   * A table scrolls inside its own box, and the box is the constrained one — a wide child
   * still widens documentElement.scrollWidth, and iOS Safari answers that by widening the
   * layout viewport, which scrolls the whole page sideways into blank space.
   * `max-width: 100%` on the scroller is what stops it.
   */
  .doc__body :global(.doc-table) {
    max-width: 100%;
    margin-top: 20px;
    overflow-x: auto;
  }

  .doc__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--ark-small);
    line-height: 1.5;
  }

  .doc__body :global(th),
  .doc__body :global(td) {
    padding: 11px 18px 11px 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--ark-hairline);
  }

  .doc__body :global(th) {
    font-weight: 700;
    color: var(--ark-ink);
    white-space: nowrap;
    border-bottom-color: var(--ark-muted-2);
  }

  /* Contact details at the end of each document. Plain lines, tight, the way an address
   * block is set — not a card. */
  .doc__body :global(.doc-contact) {
    margin-top: 15px;
  }

  .doc__body :global(.doc-contact p) {
    margin-top: 2px;
  }

  @media (max-width: 900px) {
    .doc {
      padding-block: 48px 72px;
    }

    .doc__title {
      font-size: 1.75rem;
    }

    .doc__body {
      margin-top: 32px;
    }

    .doc__body :global(h2) {
      margin-top: 36px;
    }
  }
</style>
