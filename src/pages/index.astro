---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/sections/home/HeroSection.astro";
import ProblemSection from "../components/sections/home/ProblemSection.astro";
import SeeItWorkSection from "../components/sections/home/SeeItWorkSection.astro";
import IsThisYouSection from "../components/sections/home/IsThisYouSection.astro";
import WhatHappensSection from "../components/sections/home/WhatHappensSection.astro";
import StartWithOneSection from "../components/sections/home/StartWithOneSection.astro";
import WhoYouWorkWithSection from "../components/sections/home/WhoYouWorkWithSection.astro";
import HowWeWorkSection from "../components/sections/home/HowWeWorkSection.astro";
import FaqSection from "../components/sections/home/FaqSection.astro";
import ClosingSection from "../components/sections/home/ClosingSection.astro";

/*
 * Section order is load-bearing, not arbitrary:
 *
 * - Section 3 must stay below section 2. Showing the fix before the problem is felt
 *   turns a resolution into a product demo, and the recognition work in section 2 is
 *   what gives section 3 its charge.
 * - Sections 2 and 4 both do symptom recognition, so nothing else may.
 * - The page opens and closes on gain: sections 1 and 10 name the upside.
 *
 * There is one CTA on this page, repeated: hero, demo, what-happens, closing, plus the
 * nav button. The workshop is not sold here — it becomes a recommendation made on the
 * call.
 */
---

<BaseLayout
  title="ArkSystems"
  description="Everyone is talking about AI. We find the one job in your business that would give you back the most time, and take it off you. Metro Vancouver."
>
  <HeroSection />
  <ProblemSection />
  <SeeItWorkSection />
  <IsThisYouSection />
  <WhatHappensSection />
  <StartWithOneSection />
  <WhoYouWorkWithSection />
  <HowWeWorkSection />
  <FaqSection />
  <ClosingSection />
</BaseLayout>
