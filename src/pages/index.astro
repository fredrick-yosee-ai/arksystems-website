---
const painPoints = [
	{
		title: "Missed Follow-ups",
		text: "Leads, patients, clients, or customers are not followed up consistently.",
		icon: "↗",
	},
	{
		title: "Manual Admin Work",
		text: "Staff spend hours copying, checking, updating, and chasing information.",
		icon: "⌘",
	},
	{
		title: "Document Chaos",
		text: "Forms, files, and approvals are scattered across emails, folders, and spreadsheets.",
		icon: "▧",
	},
	{
		title: "Disconnected Tools",
		text: "Your team uses multiple systems, but the workflow still depends on manual handoffs.",
		icon: "⛓",
	},
	{
		title: "Poor Visibility",
		text: "Owners and managers do not have a clear view of work, delays, or missed steps.",
		icon: "◌",
	},
	{
		title: "Staff Overload",
		text: "Good employees spend too much time on repetitive tasks instead of higher-value work.",
		icon: "♙",
	},
];

const auditItems = [
	"Workflow map",
	"Revenue and cost leak analysis",
	"AI and automation opportunity matrix",
	"ROI estimate",
	"Build vs buy recommendation",
	"Risk review",
	"30-day implementation roadmap",
];

const processSteps = [
	{
		number: "01",
		title: "Understand the Workflow",
		text: "We review how the work currently moves through your team, documents, and customers.",
	},
	{
		number: "02",
		title: "Find the Leaks",
		text: "We identify missed follow-ups, delays, duplicate work, manual admin effort, and visibility gaps.",
	},
	{
		number: "03",
		title: "Recommend the Right Fix",
		text: "We compare existing tools, automation, AI-assisted workflows, and custom systems where needed.",
	},
	{
		number: "04",
		title: "Implement What Makes Sense",
		text: "We help build or connect the system only where there is a clear business case.",
	},
];

const industries = [
	{
		title: "Healthcare Clinics",
		text: "For physiotherapy clinics, dental clinics, and allied health offices. Improve intake, reminders, forms, follow-up, review requests, and admin workflows.",
	},
	{
		title: "Accounting & CPA Firms",
		text: "Improve client intake, document collection, missing document reminders, folder organization, status tracking, and tax season capacity.",
	},
	{
		title: "Field & Industrial Operations",
		text: "Improve quote-to-job workflows, dispatch coordination, inspection logs, maintenance reminders, job costing visibility, and field-to-office communication.",
	},
	{
		title: "Other Growing Service Businesses",
		text: "For businesses with repeated workflows, staff overload, manual follow-up, and disconnected systems.",
	},
];

const principles = [
	{
		title: "Business-first",
		text: "We start with the workflow problem, not the technology.",
		icon: "♘",
	},
	{
		title: "Build vs Buy",
		text: "We recommend existing tools when they solve the problem well.",
		icon: "▱",
	},
	{
		title: "Human Review",
		text: "High-risk workflows should keep human judgment and oversight.",
		icon: "☑",
	},
];
---

<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="description" content="ArkSystems helps growing businesses fix manual workflows, missed follow-ups, document chaos, and operational bottlenecks using practical systems, automation, and AI where there is clear ROI." />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Workflow Automation Consulting for Growing Businesses | ArkSystems</title>
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link
		href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap"
		rel="stylesheet"
	/>
</head>

<body>
<header class="site-header">
	<a href="/" class="logo">ArkSystems</a>

	<nav class="main-nav" aria-label="Main navigation">
		<a href="#process">Process</a>
		<a href="#solutions">Solutions</a>
		<a href="#audit">AI Audit</a>
		<a href="#about">About</a>
	</nav>

	<a href="#contact" class="nav-cta">Book Workflow Audit <span>→</span></a>
</header>

<main>
	<section class="hero">
		<div class="hero-content">
			<p class="eyebrow">Workflow systems, automation, and practical AI</p>
			<h1>Fix the workflows that are quietly costing your business money.</h1>
			<p class="hero-text">
				ArkSystems helps growing businesses identify manual work, missed follow-ups,
				document chaos, and operational bottlenecks, then implements practical systems,
				automation, and AI where there is clear ROI.
			</p>

			<div class="hero-actions">
				<a href="#contact" class="primary-btn">Book a Workflow Audit Call <span>→</span></a>
				<a href="#audit" class="secondary-btn">See What We Audit</a>
			</div>

			<p class="small-proof">
				For established service and operations-heavy businesses with repeated workflows,
				admin pressure, and unclear bottlenecks.
			</p>
		</div>

		<div class="hero-visual" aria-label="Workflow audit dashboard illustration">
			<div class="browser-window">
				<div class="window-dots">
					<span></span>
					<span></span>
					<span></span>
				</div>

				<div class="dashboard">
					<div class="dashboard-header">
						<div>
							<p>WORKFLOW AUDIT DASHBOARD</p>
							<strong>Revenue Leak Overview</strong>
						</div>
						<span>Live Map</span>
					</div>

					<div class="dashboard-grid">
						<div class="score-card">
							<p>Leak Risk</p>
							<strong>10%</strong>
							<span>low</span>
						</div>

						<div class="bar-card">
							<p>Manual Admin Work</p>
							<div class="bar"><span style="width: 72%"></span></div>
							<p>Follow-up Gaps</p>
							<div class="bar muted"><span style="width: 48%"></span></div>
						</div>
					</div>

					<div class="mini-cards">
						<div>
							<strong>Workflow Standardized</strong>
							<p>Repeatable process identified</p>
						</div>
						<div>
							<strong>AI Opportunity</strong>
							<p>Useful where review is safe</p>
						</div>
						<div>
							<strong>ROI Path</strong>
							<p>Practical next step found</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="intro-section">
		<div class="section-heading centered">
			<h2>Your business may not need more tools. It may need better workflows.</h2>
			<p>
				Many growing businesses lose money through small daily workflow gaps.
				These leaks are easy to miss because the team is busy keeping operations moving.
			</p>
		</div>

		<div class="pain-grid">
			{painPoints.map((item) => (
				<article class="pain-card">
					<span>{item.icon}</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>
	</section>

	<section class="audit-section" id="audit">
		<div class="section-heading">
			<h2>Start with a Revenue Leak & Workflow Systems Audit.</h2>
			<p>
				Before building or automating anything, ArkSystems maps how work happens today,
				identifies where time and revenue are leaking, and recommends the simplest practical solution.
			</p>
			<a href="#contact" class="primary-btn">Find Workflow Leaks <span>→</span></a>
			<small>Audit starts from $2,500.</small>
		</div>

		<div class="audit-card">
			<p class="card-label">Audit Deliverables</p>
			<ul>
				{auditItems.map((item) => (
					<li>{item}</li>
				))}
			</ul>
		</div>
	</section>

	<section class="process-section" id="process">
		<div class="section-heading centered">
			<h2>A practical process before any implementation.</h2>
		</div>

		<div class="process-grid">
			{processSteps.map((step) => (
				<article class="process-card">
					<span>{step.number}</span>
					<h3>{step.title}</h3>
					<p>{step.text}</p>
				</article>
			))}
		</div>
	</section>

	<section class="industries-section" id="solutions">
		<div class="section-heading centered">
			<h2>Built for service and operations-heavy businesses.</h2>
			<p>
				ArkSystems works with established businesses where admin work,
				follow-ups, documents, and team coordination directly affect revenue and capacity.
			</p>
		</div>

		<div class="industry-grid">
			{industries.map((industry) => (
				<article class="industry-card">
					<h3>{industry.title}</h3>
					<p>{industry.text}</p>
					<a href="#contact">Learn more →</a>
				</article>
			))}
		</div>
	</section>

	<section class="principles-section">
		<div class="section-heading centered">
			<h2>AI only where it makes business sense.</h2>
			<p>
				ArkSystems does not force AI into every workflow. Sometimes the right answer
				is a better process, a connected tool, a simple automation, or a custom system.
				AI is recommended only when it is useful, safe, and financially justified.
			</p>
		</div>

		<div class="principles-grid">
			{principles.map((item) => (
				<article class="principle-card">
					<span>{item.icon}</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>
	</section>

	<section class="founder-section" id="about">
		<div class="founder-card">
			<h2>Practical systems built by someone who understands software, operations, and business.</h2>
			<p>
				ArkSystems is led by a technical founder with experience building SaaS products,
				workflow systems, automation, and business operations. The focus is simple:
				understand the workflow, prove the business case, and implement systems
				that make work easier and more measurable.
			</p>
			<a href="#contact" class="primary-btn">Talk Through Your Workflow <span>→</span></a>
		</div>
	</section>

	<section class="final-cta" id="contact">
		<h2>Want to see where your workflow is leaking time or revenue?</h2>
		<p>
			Book a short audit-fit call. We’ll talk through your current workflow,
			your biggest bottlenecks, and whether a workflow audit makes sense.
		</p>
		<a href="mailto:hello@arksystems.ca?subject=Workflow Audit Call" class="primary-btn">
			Book a Workflow Audit Call <span>→</span>
		</a>
		<small>No hype. No pressure. Just a practical conversation about your operations.</small>
	</section>
</main>

<footer class="site-footer">
	<div>
		<strong>ArkSystems</strong>
		<p>
			Workflow automation consulting for growing businesses.
			Based in Vancouver, BC. Serving clients remotely.
		</p>
		<small>© 2026 ArkSystems. All rights reserved.</small>
	</div>

	<div>
		<h3>Solutions</h3>
		<a href="#audit">Services</a>
		<a href="#solutions">Case Studies</a>
	</div>

	<div>
		<h3>Company</h3>
		<a href="#contact">Contact</a>
		<a href="#about">About</a>
		<a href="#">LinkedIn</a>
		<a href="#">Privacy Policy</a>
		<a href="#">Terms of Service</a>
	</div>
</footer>
</body>
</html>

<style>
	:root {
		--bg: #fbfaf7;
		--surface: #ffffff;
		--surface-soft: #f4f1eb;
		--text: #11140f;
		--muted: #666d5f;
		--border: #dedbd2;
		--green: #304124;
		--green-dark: #24321b;
		--gold: #d99a24;
		--gold-soft: #f5dfb3;
		--shadow: 0 24px 60px rgba(22, 27, 20, 0.14);
		--max: 1180px;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-family:
			"Manrope",
			ui-sans-serif,
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;
		line-height: 1.5;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		height: 72px;
		background: rgba(251, 250, 247, 0.9);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--border);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 clamp(20px, 5vw, 64px);
	}

	.logo {
		font-family: "Source Serif 4", Georgia, serif;
		font-weight: 700;
		font-size: 18px;
		letter-spacing: -0.02em;
	}

	.main-nav {
		display: flex;
		gap: 32px;
		font-size: 14px;
		color: #2e3329;
	}

	.main-nav a:hover {
		color: var(--green);
	}

	.nav-cta,
	.primary-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		background: var(--green);
		color: #fff;
		border: 1px solid var(--green-dark);
		padding: 12px 18px;
		font-size: 14px;
		font-weight: 700;
		box-shadow: 0 8px 18px rgba(48, 65, 36, 0.18);
	}

	.nav-cta:hover,
	.primary-btn:hover {
		background: var(--green-dark);
	}

	.secondary-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: #fff;
		border: 1px solid var(--border);
		padding: 12px 18px;
		font-size: 14px;
		font-weight: 700;
	}

	.hero {
		max-width: var(--max);
		margin: 0 auto;
		min-height: 690px;
		display: grid;
		grid-template-columns: 1fr 1.05fr;
		gap: 64px;
		align-items: center;
		padding: 72px 32px 96px;
	}

	.eyebrow {
		margin: 0 0 14px;
		color: var(--green);
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	.hero h1 {
		margin: 0;
		max-width: 620px;
		font-family: "Source Serif 4", Georgia, "Times New Roman", serif;
		font-size: clamp(44px, 6vw, 76px);
		line-height: 0.96;
		letter-spacing: -0.04em;
	}

	.hero-text {
		max-width: 590px;
		margin: 28px 0 0;
		color: var(--muted);
		font-size: 18px;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 32px;
	}

	.small-proof {
		max-width: 560px;
		margin: 24px 0 0;
		padding-left: 16px;
		border-left: 2px solid var(--gold);
		color: var(--muted);
		font-size: 13px;
	}

	.hero-visual {
		display: flex;
		justify-content: center;
	}

	.browser-window {
		width: min(100%, 580px);
		background: #202820;
		border: 1px solid #384233;
		box-shadow: var(--shadow);
		transform: translateY(18px);
	}

	.window-dots {
		height: 36px;
		background: #f1eee6;
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0 14px;
	}

	.window-dots span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #c75f4d;
	}

	.window-dots span:nth-child(2) {
		background: #e2b34f;
	}

	.window-dots span:nth-child(3) {
		background: #6aa167;
	}

	.dashboard {
		margin: 34px;
		padding: 26px;
		background: #f8f6ef;
		border: 1px solid #d8d3c5;
	}

	.dashboard-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		padding-bottom: 18px;
		border-bottom: 1px solid #ddd5c5;
	}

	.dashboard-header p,
	.dashboard-header strong {
		margin: 0;
	}

	.dashboard-header p {
		color: #687062;
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.08em;
	}

	.dashboard-header strong {
		display: block;
		margin-top: 4px;
		font-size: 18px;
	}

	.dashboard-header span {
		background: var(--gold-soft);
		color: #7a4b00;
		padding: 6px 10px;
		font-size: 11px;
		font-weight: 700;
	}

	.dashboard-grid {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: 18px;
		margin-top: 22px;
	}

	.score-card,
	.bar-card,
	.mini-cards div {
		background: #fff;
		border: 1px solid #ded8c8;
		padding: 16px;
	}

	.score-card p,
	.score-card strong,
	.score-card span {
		display: block;
		text-align: center;
		margin: 0;
	}

	.score-card strong {
		margin-top: 8px;
		color: var(--green);
		font-size: 34px;
	}

	.score-card span {
		color: var(--gold);
		font-weight: 700;
		font-size: 13px;
	}

	.bar-card p {
		margin: 0 0 8px;
		color: #4e5648;
		font-size: 12px;
		font-weight: 700;
	}

	.bar {
		height: 10px;
		background: #eee7d7;
		margin-bottom: 16px;
	}

	.bar span {
		display: block;
		height: 100%;
		background: var(--gold);
	}

	.bar.muted span {
		background: var(--green);
	}

	.mini-cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 12px;
		margin-top: 16px;
	}

	.mini-cards strong {
		display: block;
		font-size: 12px;
	}

	.mini-cards p {
		margin: 6px 0 0;
		color: var(--muted);
		font-size: 11px;
	}

	section {
		padding: 90px 32px;
	}

	.intro-section,
	.industries-section,
	.founder-section {
		background: #fff;
	}

	.section-heading {
		max-width: 620px;
	}

	.section-heading.centered {
		margin: 0 auto 48px;
		text-align: center;
	}

	.section-heading h2,
	.final-cta h2,
	.founder-card h2 {
		margin: 0;
		font-family: "Source Serif 4", Georgia, "Times New Roman", serif;
		font-size: clamp(30px, 4vw, 46px);
		line-height: 1.08;
		letter-spacing: -0.025em;
	}

	.section-heading p,
	.final-cta p,
	.founder-card p {
		margin: 16px 0 0;
		color: var(--muted);
		font-size: 17px;
	}

	.pain-grid,
	.process-grid,
	.industry-grid,
	.principles-grid {
		max-width: var(--max);
		margin: 0 auto;
		display: grid;
		gap: 22px;
	}

	.pain-grid {
		grid-template-columns: repeat(3, 1fr);
	}

	.pain-card,
	.industry-card,
	.principle-card {
		background: var(--surface);
		border: 1px solid var(--border);
		padding: 28px;
	}

	.pain-card span,
	.principle-card span {
		color: var(--green);
		font-size: 24px;
	}

	.pain-card h3,
	.industry-card h3,
	.principle-card h3,
	.process-card h3 {
		margin: 18px 0 8px;
		font-size: 17px;
		letter-spacing: -0.01em;
	}

	.pain-card p,
	.industry-card p,
	.principle-card p,
	.process-card p {
		margin: 0;
		color: var(--muted);
		font-size: 14px;
	}

	.audit-section {
		max-width: var(--max);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 0.9fr;
		gap: 72px;
		align-items: center;
	}

	.audit-section .primary-btn {
		margin-top: 28px;
	}

	.audit-section small,
	.final-cta small {
		display: block;
		margin-top: 12px;
		color: var(--muted);
		font-size: 13px;
	}

	.audit-card {
		background: #fff;
		border: 1px solid var(--border);
		padding: 34px;
		box-shadow: 0 18px 40px rgba(22, 27, 20, 0.08);
	}

	.card-label {
		margin: 0 0 18px;
		color: var(--muted);
		font-size: 13px;
		font-weight: 700;
	}

	.audit-card ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 14px;
	}

	.audit-card li {
		position: relative;
		padding-left: 26px;
		color: #30362d;
		font-size: 15px;
	}

	.audit-card li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: var(--green);
		font-weight: 800;
	}

	.process-section {
		background: var(--bg);
	}

	.process-grid {
		grid-template-columns: repeat(4, 1fr);
	}

	.process-card span {
		color: #b7a98f;
		font-size: 26px;
		font-weight: 800;
	}

	.industry-grid {
		grid-template-columns: repeat(4, 1fr);
	}

	.industry-card a {
		display: inline-block;
		margin-top: 24px;
		color: var(--green);
		font-size: 14px;
		font-weight: 800;
	}

	.principles-grid {
		grid-template-columns: repeat(3, 1fr);
	}

	.principle-card {
		text-align: center;
	}

	.founder-card {
		max-width: 900px;
		margin: 0 auto;
		background: var(--surface-soft);
		border: 1px solid var(--border);
		padding: clamp(34px, 6vw, 70px);
		text-align: center;
	}

	.founder-card .primary-btn {
		margin-top: 28px;
	}

	.final-cta {
		text-align: center;
		max-width: 820px;
		margin: 0 auto;
	}

	.final-cta .primary-btn {
		margin-top: 28px;
	}

	.site-footer {
