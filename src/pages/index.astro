---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/sections/home/HeroSection.astro";
import ProblemSection from "../components/sections/home/ProblemSection.astro";
import AccountingFirmsSection from "../components/sections/home/AccountingFirmsSection.astro";
import ApproachSection from "../components/sections/home/ApproachSection.astro";
import WorkshopSection from "../components/sections/home/WorkshopSection.astro";
import DifferentiatorsSection from "../components/sections/home/DifferentiatorsSection.astro";
import WorkflowFocusSection from "../components/sections/home/WorkflowFocusSection.astro";

const title = "ArkSystems";
const description =
	"ArkSystems helps businesses identify practical AI and workflow opportunities that improve capacity, efficiency, and profit.";
---

<Layout title={title} description={description}>
	<HeroSection />
	<ProblemSection />
	<AccountingFirmsSection />
	<ApproachSection />
	<WorkshopSection />
	<DifferentiatorsSection />
	<WorkflowFocusSection />
</Layout>