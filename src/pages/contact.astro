---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
import { LEGAL_EMAIL } from "../lib/legal";

import HeroSection from "../components/sections/contact/HeroSection.astro";
import ContactSection from "../components/sections/contact/ContactSection.astro";

/*
 * /contact — built Aug 28 2026, then rebuilt the same day to the supplied design on
 * Fredrick's instruction: "design the page only with these contents".
 *
 * TWO SECTIONS. A hero, and one fused card carrying the form and the Direct Lines panel.
 *
 *   1  Hero             sections/contact/HeroSection.astro
 *   2  Form + contact   sections/contact/ContactSection.astro
 *                       + routes/ContactFormPanel.astro
 *
 * FOUR COMPONENTS WERE DELETED and are recoverable from git history: `RoutesSection`
 * (the two-panel version, twice rebuilt), `WhatToExpectSection`, `WhereWeAreSection` and
 * `CloseSection`. The design has none of them. WHAT WENT WITH THEM, because two of these
 * were load-bearing rather than decorative:
 *
 *   - "What happens after you write" carried the CASL block — the visible statement that
 *     writing to us does not become consent to be marketed at. THE SHORT VERSION SURVIVES
 *     under the submit button, which the design does not show and which is built anyway;
 *     it is now the page's only link to /privacy at the point of collection.
 *   - The close carried the page's second booking CTA and the tagline. The tagline moved
 *     into the Direct Lines panel, so it still appears twice on the page — panel and
 *     footer — which is its established count.
 *   - "Where we are" carried the location paragraph. The Direct Lines panel now carries
 *     the location, so the scoped exception to the no-location rule still stands and is
 *     documented there.
 *
 * THE PAGE HAS NO BOOKING BUTTON. That is the largest consequence and it is deliberate:
 * the design carries one action, the form. The site's stated job is getting a visitor onto
 * a 20-minute call, and the only route to the calendar from this page is now the header's
 * "Book 20 minutes", which is on every page and stays visible on a phone. `contact-hero`
 * and `contact-closing` were removed from CtaLocation, since nothing renders them and that
 * list is meant to be the record of what the site's own buttons are called.
 *
 * BUILT ON THE SHARED LAYOUT, which the brief calls the thing most likely to go wrong. A
 * standalone page would ship without the consent gate, without the cookie banner, without
 * the footer Cookie settings link and without the analytics installed on Aug 27.
 *
 * STILL FORBIDDEN, and the brief keeps both as page rules: no phone number, and no street
 * or mailing address — supplied on request if a vendor assessment asks. That is also why
 * no LocalBusiness schema is emitted: it needs a real postal address and real hours.
 *
 * NO SITEMAP CHANGE WAS NEEDED. @astrojs/sitemap includes every page by default and the
 * filter only excludes the three legal drafts, so /contact was picked up automatically.
 */

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact ArkSystems",
  url: `${SITE.url}/contact`,
  description:
    "Reach ArkSystems by email, or book a free 20-minute call. Based in Metro Vancouver, working remotely with businesses across Canada.",
};

/*
 * The Organization node, carrying the ContactPoint the brief asks for. Per-page
 * Organization nodes describe one entity rather than competing with each other — the
 * homepage and /about both emit one already.
 *
 * NO `address` AND NO LocalBusiness. Both need a real postal address, which the brief
 * rules out publishing anywhere. Emitting a made-up one in markup would be a false claim
 * in the least visible place on the page, which is the worst place for one.
 *
 * `sameAs` is still absent. The copy files specify LinkedIn; the URL is not in the repo,
 * and a guessed profile URL is a claim about identity rather than a missing nicety.
 */
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: SITE.url,
  description:
    "AI consulting firm. We establish where AI produces a return in a business, quantify it, and build it. Assessment first, business case second, build only if the case holds.",
  areaServed: {
    "@type": "AdministrativeArea",
    name: "Canada",
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "Customer enquiries",
    email: LEGAL_EMAIL,
    areaServed: "CA",
    availableLanguage: "English",
  },
};
---

{/*
  Title and meta description are the approved strings from the build brief, used as
  written. Both name Metro Vancouver, which is the same call made for the other four
  pages: a title tag and a meta description are search-targeting strings rather than
  sentences on a page. On this page the visible copy names the location too, which is the
  scoped exception recorded above — everywhere else on the site, only the metas do.
*/}
<BaseLayout
  title="Contact ArkSystems"
  titleOverride="Contact ArkSystems | Metro Vancouver"
  description="Reach ArkSystems by email, or book a free 20-minute call. Based in Metro Vancouver, working remotely with businesses across Canada."
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(contactSchema)}
    is:inline
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema)}
    is:inline
  />

  <HeroSection />
  <ContactSection />
</BaseLayout>
