---
import ConsentBootstrap from "../components/consent/ConsentBootstrap.astro";
import ConsentManager from "../components/consent/ConsentManager.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import { SITE } from "../consts";
import "../styles/base.css";

interface Props {
  title: string;
  description: string;
  /**
   * The complete <title>, used exactly as given, suffix and separator included.
   *
   * Most pages want the site-wide pattern below and should pass `title` alone. This
   * exists for pages whose title tag is itself approved copy — /accounting's is written
   * out character for character in docs/accounting-page.md, separator included, and
   * differs from the site pattern. Rebuilding it from parts would silently change it.
   */
  titleOverride?: string;
  /** Set on pages that should stay out of search results. */
  noindex?: boolean;
  /**
   * Share-card image, absolute or root-relative. Defaults to the site-wide card.
   *
   * One card covers every page today, deliberately: per-page cards are a maintenance
   * surface, and a share of any page is a share of the same firm. Pass this only when a
   * page genuinely needs its own.
   */
  ogImage?: string;
}

const {
  title,
  titleOverride,
  description,
  noindex = false,
  ogImage = "/og-card.png",
} = Astro.props;

const pageTitle =
  titleOverride ?? (title === SITE.name ? SITE.name : `${title} — ${SITE.name}`);
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
/* Absolute, because every scraper that reads og:image requires it — a root-relative path
 * is silently dropped by most of them, which is how a site ends up sharing as a bare text
 * card while the tag looks correct in the markup. */
const ogImageUrl = new URL(ogImage, Astro.site ?? SITE.url);
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Google Consent Mode v2 defaults, denied. FIRST IN THE HEAD, AND IT MUST STAY
      FIRST — the defaults have to be in place before anything could read them, and
      "before" here means before any other script tag in the document, not merely
      before the tags we happen to load ourselves.
    */}
    <ConsentBootstrap />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="canonical" href={canonical.href} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {/*
      The share card. Width and height are declared because Facebook and LinkedIn render
      a placeholder on first scrape without them — they will not hold the layout open
      while they fetch the image, so the first share of a new URL shows a collapsed card.

      og:image:alt is the text alternative for the card, not for the page.
    */}
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="ArkSystems — Think AI, Think Ark. A diagram of work arriving from many tools into one assistant, and coming back done."
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl.href} />

    <meta name="generator" content={Astro.generator} />

    {/*
      Per-page <head> additions — in practice, JSON-LD. It lives with the page rather
      than here because the schema describes that page's content: /accounting emits
      Service and FAQPage, and only that page can know what is in its own FAQ.

      Note for whoever adds sitewide LocalBusiness schema: it belongs here, not in a
      page. It is not written yet — it needs a real address and real hours, and
      inventing either would be a false claim.
    */}
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <SiteHeader />

    <main id="main">
      <slot />
    </main>

    <SiteFooter />

    {/*
      The consent banner, the Cookie settings panel, and the gate that loads tags.

      Placed after the footer so the first thing in the document order is the page, not
      the cookie notice — a keyboard or screen-reader visitor reaches the content first
      and the banner when they get to the end of it. Nothing is loading behind it, so
      there is no reason to put it in their way.
    */}
    <ConsentManager />

    {/*
      Cal.com embed. This upgrades every `[data-cal-link]` element into a popup so the
      visitor never leaves the page — each navigation away is a chance to lose them.

      It is progressive enhancement, not a dependency: every CTA is already a working
      `<a href>` pointing at the booking URL, so if this script is blocked, fails, or
      simply has not loaded when someone clicks, the link still books the call.

      THIS IS A THIRD-PARTY SCRIPT (app.cal.com) AND MUST BE NAMED ON THE PRIVACY PAGE.
    */}
    <script is:inline>
      (function (C, A, L) {
        let p = function (a, ar) {
          a.q.push(ar);
        };
        let d = C.document;
        C.Cal =
          C.Cal ||
          function () {
            let cal = C.Cal;
            let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              d.head.appendChild(d.createElement("script")).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () {
                p(api, arguments);
              };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === "string") {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ["initNamespace", namespace]);
              } else {
                p(cal, ar);
              }
              return;
            }
            p(cal, ar);
          };
      })(window, "https://app.cal.com/embed/embed.js", "init");

      Cal("init", { origin: "https://cal.com" });
      Cal("ui", { hideEventTypeDetails: false, layout: "month_view" });

      /*
       * Keep the booker on our own page.
       *
       * Cal's embed installs its own delegated click handler that opens the modal, but
       * it never cancels the default action — `preventDefault` appears zero times in
       * embed.js. On a plain <a href> that means both things happen at once: the modal
       * opens and the browser navigates to cal.com. The navigation wins, and the
       * visitor leaves the site, which is exactly what the embed was meant to avoid.
       *
       * So we cancel the default ourselves — but only once the embed has actually
       * registered <cal-modal-box>. Until then there is no modal to show and the link
       * must still work, which is the whole point of it being a real <a href>: if the
       * script is blocked, slow, or fails, the CTA still books the call.
       *
       * Capture phase, so this runs before Cal's own document-level handler.
       * preventDefault does not stop propagation, so Cal still opens the modal.
       */
      document.addEventListener(
        "click",
        function (event) {
          var trigger =
            event.target &&
            event.target.closest &&
            event.target.closest("[data-cal-link]");
          if (!trigger) return;

          // A deliberate "open in a new tab" gesture should do exactly that, and
          // should not also open a modal on the page being left behind.
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
            event.stopPropagation();
            return;
          }

          // Embed not ready yet — let the link navigate rather than doing nothing.
          if (!window.customElements || !customElements.get("cal-modal-box")) return;

          event.preventDefault();
        },
        true,
      );
</script>
  </body>
</html>
